{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "system",
  "commands": [
    {
      "id": "aix-oslevel",
      "name": "oslevel",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.os-version",
      "platforms": [
        "aix"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "AIX 버전·TL·SP 레벨 확인",
      "description": "설치된 AIX 의 버전과 Technology Level(TL), Service Pack(SP)을 보여 줍니다. 패치 점검·벤더 지원 문의 때 가장 먼저 확인하는 값입니다. -s 결과의 7200-05-03-2148 은 AIX 7.2 TL5 SP3, 2021년 48주 빌드를 뜻합니다.",
      "syntax": [
        "oslevel [-r | -s]",
        "oslevel -s -l {{LEVEL}}"
      ],
      "options": [
        {
          "flag": "-r",
          "desc": "TL 레벨까지 표시 (예: 7200-05)"
        },
        {
          "flag": "-s",
          "desc": "SP 레벨까지 표시 (예: 7200-05-03-2148)"
        },
        {
          "flag": "-q",
          "desc": "시스템이 알고 있는 레벨 목록 (-r, -s 와 함께)"
        },
        {
          "flag": "-l {{LEVEL}}",
          "desc": "지정 레벨보다 낮은 fileset 목록 (-r 또는 -s 와 함께). 업데이트가 덜 된 fileset 찾기"
        },
        {
          "flag": "-g {{LEVEL}}",
          "desc": "지정 레벨보다 높은 fileset 목록"
        }
      ],
      "examples": [
        {
          "title": "TL·SP 레벨 확인",
          "command": "oslevel -s",
          "output": "7200-05-03-2148"
        },
        {
          "title": "TL 업데이트 후 레벨이 올라가지 않을 때 원인 fileset 찾기",
          "command": "oslevel -sq\noslevel -s -l {{LEVEL}}",
          "note": "oslevel -sq 로 시스템이 아는 SP 레벨 목록(위쪽이 최신)을 보고, 기대한 레벨을 {{LEVEL}} 에 넣으면 그보다 낮은 fileset 이 출력됩니다."
        }
      ],
      "cautions": [
        "oslevel 은 설치된 fileset 기준으로 계산합니다. 일부 fileset 만 낮아도 레벨이 이전 값으로 표시됩니다."
      ],
      "help": "man oslevel",
      "keywords": [
        "OS 버전",
        "AIX 버전",
        "TL",
        "SP",
        "Technology Level",
        "Service Pack",
        "oslevel -s"
      ],
      "related": [
        "uname",
        "aix-lslpp",
        "aix-instfix",
        "aix-emgr",
        "aix-prtconf"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-prtconf",
      "name": "prtconf",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.hardware",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "시스템 모델·CPU·메모리·펌웨어·장치 구성 요약",
      "description": "서버 모델, 시리얼, CPU 종류·개수·클럭, 메모리, 펌웨어 레벨, LPAR 정보, 네트워크 설정, 장치 목록을 한 번에 출력합니다. 인수인계·점검 보고서에 서버 구성을 남길 때 많이 씁니다. 인자 없이 실행하면 장치 정보까지 모으므로 수 초 이상 걸릴 수 있습니다.",
      "syntax": [
        "prtconf",
        "prtconf [-c] [-k] [-L] [-m] [-s]"
      ],
      "options": [
        {
          "flag": "-c",
          "desc": "프로세서 유형 (32/64비트 CHRP 등)"
        },
        {
          "flag": "-k",
          "desc": "커널 유형 (64-bit)"
        },
        {
          "flag": "-L",
          "desc": "LPAR 이름·번호"
        },
        {
          "flag": "-m",
          "desc": "메모리 크기"
        },
        {
          "flag": "-s",
          "desc": "프로세서 클럭 속도"
        }
      ],
      "examples": [
        {
          "title": "전체 구성 요약을 파일로 저장",
          "command": "prtconf > /tmp/$(hostname).prtconf.txt"
        },
        {
          "title": "메모리·LPAR 정보만 빠르게",
          "command": "prtconf -m\nprtconf -L"
        }
      ],
      "cautions": [],
      "help": "man prtconf",
      "keywords": [
        "하드웨어 정보",
        "시스템 구성",
        "모델",
        "시리얼",
        "CPU",
        "메모리",
        "펌웨어",
        "prtconf"
      ],
      "related": [
        "aix-lscfg",
        "aix-lsattr",
        "aix-lparstat",
        "aix-lsmcode",
        "dmidecode"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-lsattr",
      "name": "lsattr",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.hardware",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "장치 속성(ODM) 확인 (디스크·NIC·FC·sys0)",
      "description": "ODM 에 저장된 장치 속성을 보여 줍니다. 디스크의 queue_depth·reserve_policy, NIC 의 IP·MTU, FC 어댑터 설정, sys0 의 maxuproc·realmem 처럼 AIX 튜닝·점검 항목 대부분을 이 명령으로 확인합니다. 출력의 마지막 열 True 는 변경 가능한 속성입니다.",
      "syntax": [
        "lsattr -El {{DEVICE}} [-a {{ATTR}}]",
        "lsattr -Rl {{DEVICE}} -a {{ATTR}}",
        "lsattr -Dl {{DEVICE}}"
      ],
      "options": [
        {
          "flag": "-E",
          "desc": "현재 적용(effective) 값"
        },
        {
          "flag": "-D",
          "desc": "기본(default) 값"
        },
        {
          "flag": "-R",
          "desc": "설정 가능한 값의 범위·목록 (-a 와 함께)"
        },
        {
          "flag": "-l {{DEVICE}}",
          "desc": "장치 이름 (hdisk0, en0, ent0, fcs0, sys0, inet0 등)"
        },
        {
          "flag": "-a {{ATTR}}",
          "desc": "특정 속성만 표시 (여러 번 지정 가능)"
        },
        {
          "flag": "-H",
          "desc": "열 제목 표시"
        },
        {
          "flag": "-F {{FORMAT}}",
          "desc": "출력 형식 지정 (예: -F value)"
        }
      ],
      "examples": [
        {
          "title": "디스크 속성 확인 (멀티패스·클러스터 점검)",
          "command": "lsattr -El {{HDISK}} -a queue_depth -a reserve_policy -a algorithm"
        },
        {
          "title": "NIC IP·넷마스크·상태 확인",
          "command": "lsattr -El en0"
        },
        {
          "title": "기본 게이트웨이·호스트명 (inet0)",
          "command": "lsattr -El inet0"
        },
        {
          "title": "사용자당 최대 프로세스 수·물리 메모리",
          "command": "lsattr -El sys0 -a maxuproc -a realmem"
        },
        {
          "title": "속성에 넣을 수 있는 값 범위 확인",
          "command": "lsattr -Rl {{HDISK}} -a queue_depth"
        }
      ],
      "cautions": [],
      "help": "man lsattr",
      "keywords": [
        "장치 속성",
        "ODM",
        "queue_depth",
        "reserve_policy",
        "maxuproc",
        "lsattr",
        "NIC 설정",
        "FC"
      ],
      "related": [
        "aix-chdev",
        "aix-lsdev",
        "aix-lscfg",
        "aix-prtconf"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-chdev",
      "name": "chdev",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.devices",
      "platforms": [
        "aix"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "장치 속성 변경 (디스크·NIC·inet0·sys0)",
      "description": "ODM 의 장치 속성을 바꿉니다. 디스크 queue_depth·reserve_policy, NIC IP·별칭, 기본 게이트웨이(inet0), maxuproc(sys0) 등을 바꿀 때 씁니다. 사용 중인 장치는 즉시 바꿀 수 없는 속성이 많아 -P 로 ODM 만 바꾸고 재부팅(또는 장치 재구성) 때 적용합니다.",
      "syntax": [
        "chdev -l {{DEVICE}} -a {{ATTR}}={{VALUE}} [-a {{ATTR2}}={{VALUE2}}] [-P]"
      ],
      "options": [
        {
          "flag": "-l {{DEVICE}}",
          "desc": "대상 장치 이름"
        },
        {
          "flag": "-a {{ATTR}}={{VALUE}}",
          "desc": "바꿀 속성과 값 (여러 개 지정 가능)"
        },
        {
          "flag": "-P",
          "desc": "ODM 에만 기록하고 다음 재부팅 시 적용 (사용 중인 장치용)"
        }
      ],
      "examples": [
        {
          "title": "사용자당 최대 프로세스 수 변경 (즉시 적용)",
          "command": "lsattr -El sys0 -a maxuproc\nchdev -l sys0 -a maxuproc={{VALUE}}"
        },
        {
          "title": "디스크 queue_depth 변경 (사용 중이면 재부팅 시 적용)",
          "command": "chdev -l {{HDISK}} -a queue_depth={{VALUE}} -P"
        },
        {
          "title": "클러스터 공유 디스크의 SCSI 예약 해제 정책",
          "command": "chdev -l {{HDISK}} -a reserve_policy=no_reserve",
          "note": "디스크가 VG 에 열려 있으면 실패하므로 -P 를 붙이거나 VG 를 내린 뒤 수행합니다."
        },
        {
          "title": "NIC 에 IP 별칭 추가 (재부팅 후에도 유지)",
          "command": "chdev -l en0 -a alias4={{IP}},{{NETMASK}}"
        },
        {
          "title": "호스트명·기본 게이트웨이 변경 (inet0)",
          "command": "chdev -l inet0 -a hostname={{HOSTNAME}}\nchdev -l inet0 -a route=net,-hopcount,0,,0,{{GATEWAY}}",
          "note": "기존 게이트웨이를 지우려면 chdev -l inet0 -a delroute=net,-hopcount,0,,0,{{OLD_GATEWAY}} 를 씁니다. 원격 접속 중이면 순서를 잘못 잡으면 접속이 끊깁니다."
        }
      ],
      "cautions": [
        "NIC 의 netaddr·state 를 원격 세션에서 바꾸면 즉시 접속이 끊길 수 있습니다. HMC 콘솔(vterm) 접속을 확보한 뒤 수행하세요.",
        "-P 로 바꾼 값은 lsattr -El 에는 바로 보이지만 실제 적용은 재부팅 이후입니다. 변경 이력을 남겨 두세요.",
        "변경 전 lsattr -El {{DEVICE}} 결과를 저장해 두면 원래 값으로 되돌리기 쉽습니다."
      ],
      "help": "man chdev",
      "keywords": [
        "장치 속성 변경",
        "chdev",
        "queue_depth",
        "reserve_policy",
        "maxuproc",
        "IP 별칭",
        "게이트웨이",
        "inet0"
      ],
      "related": [
        "aix-lsattr",
        "aix-lsdev",
        "aix-mktcpip",
        "aix-cfgmgr"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-lscfg",
      "name": "lscfg",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.hardware",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "장치 VPD 정보 (FC WWPN, 위치 코드, 부품 번호)",
      "description": "장치의 VPD(Vital Product Data)를 보여 줍니다. FC 어댑터의 WWPN(Network Address), 하드웨어 위치 코드, 부품·FRU 번호, 시리얼을 확인할 수 있어 스토리지 zoning 요청이나 부품 교체 요청 때 필수입니다.",
      "syntax": [
        "lscfg [-v] [-p] [-l {{DEVICE}}]"
      ],
      "options": [
        {
          "flag": "-v",
          "desc": "VPD 상세 (부품 번호, 시리얼, WWPN 등)"
        },
        {
          "flag": "-p",
          "desc": "플랫폼 고유 장치 정보 포함"
        },
        {
          "flag": "-l {{DEVICE}}",
          "desc": "특정 장치만 (와일드카드 가능, 예: -l fcs*)"
        }
      ],
      "examples": [
        {
          "title": "FC 어댑터 WWPN 확인 (스토리지 zoning 요청용)",
          "command": "lscfg -vl fcs0 | grep 'Network Address'"
        },
        {
          "title": "전체 FC 어댑터의 위치 코드와 WWPN",
          "command": "for f in $(lsdev -Cc adapter -F name | grep fcs); do echo $f; lscfg -vl $f | grep -E 'Network Address|Location'; done"
        },
        {
          "title": "시스템 전체 장치 목록과 위치 코드",
          "command": "lscfg"
        }
      ],
      "cautions": [],
      "help": "man lscfg",
      "keywords": [
        "WWPN",
        "WWN",
        "FC 어댑터",
        "VPD",
        "위치 코드",
        "부품 번호",
        "lscfg",
        "시리얼"
      ],
      "related": [
        "aix-lsdev",
        "aix-lsattr",
        "aix-prtconf",
        "aix-lsmcode",
        "lspci"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-lsmcode",
      "name": "lsmcode",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.hardware",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "시스템·어댑터 펌웨어(마이크로코드) 레벨 확인",
      "description": "시스템 펌웨어와 어댑터·디스크의 마이크로코드 레벨을 보여 줍니다. IBM 지원 문의나 펌웨어 호환성 점검(FLRT) 때 씁니다. 옵션 없이 실행하면 메뉴 화면이 열리므로 스크립트에서는 -c 를 붙입니다.",
      "syntax": [
        "lsmcode -c",
        "lsmcode -A",
        "lsmcode -d {{DEVICE}}"
      ],
      "options": [
        {
          "flag": "-c",
          "desc": "메뉴 없이 시스템 펌웨어 레벨 출력"
        },
        {
          "flag": "-A",
          "desc": "지원되는 모든 장치의 마이크로코드 레벨"
        },
        {
          "flag": "-d {{DEVICE}}",
          "desc": "특정 장치(fcs0 등)의 마이크로코드 레벨"
        }
      ],
      "examples": [
        {
          "title": "시스템 펌웨어 레벨",
          "command": "lsmcode -c"
        },
        {
          "title": "FC 어댑터 펌웨어 레벨",
          "command": "lsmcode -d fcs0"
        }
      ],
      "cautions": [],
      "help": "man lsmcode",
      "keywords": [
        "펌웨어",
        "마이크로코드",
        "firmware",
        "lsmcode",
        "FLRT",
        "어댑터 펌웨어"
      ],
      "related": [
        "aix-prtconf",
        "aix-lscfg",
        "aix-oslevel"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-lparstat",
      "name": "lparstat",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.virtualization",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "LPAR 구성(Entitlement·vCPU·메모리)과 CPU 사용 통계",
      "description": "PowerVM LPAR 의 구성 정보와 CPU 사용 통계를 보여 줍니다. -i 로 파티션 이름·번호, Shared/Dedicated 모드, Entitled Capacity, 가상 CPU 수, Capped 여부, 메모리를 확인합니다. 간격을 주면 physc(사용한 물리 CPU), %entc(할당 대비 사용률)를 볼 수 있어 CPU 증설 판단에 씁니다.",
      "syntax": [
        "lparstat -i",
        "lparstat [{{INTERVAL}} [{{COUNT}}]]",
        "lparstat -h {{INTERVAL}} {{COUNT}}"
      ],
      "options": [
        {
          "flag": "-i",
          "desc": "LPAR 구성 정보 (모드, Entitled Capacity, Online Virtual CPUs, 메모리, 풀 정보)"
        },
        {
          "flag": "-h",
          "desc": "하이퍼바이저 사용률(%hypv, hcalls) 추가 표시"
        },
        {
          "flag": "-H",
          "desc": "하이퍼바이저 호출 종류별 상세 통계"
        }
      ],
      "examples": [
        {
          "title": "LPAR 구성 확인",
          "command": "lparstat -i"
        },
        {
          "title": "5초 간격 12회 CPU 사용 통계",
          "command": "lparstat 5 12",
          "note": "Shared 모드에서 %entc 가 100% 를 계속 넘으면 Entitled Capacity 를 넘어 풀 CPU 를 빌려 쓰는 상태입니다. Capped 이면 100% 에서 막힙니다."
        }
      ],
      "cautions": [
        "Shared 프로세서 LPAR 에서는 vmstat·sar 의 %idle 만으로 CPU 여유를 판단하면 안 됩니다. physc·%entc 를 함께 보세요."
      ],
      "help": "man lparstat",
      "keywords": [
        "LPAR",
        "가상화",
        "Entitled Capacity",
        "vCPU",
        "physc",
        "entc",
        "PowerVM",
        "lparstat"
      ],
      "related": [
        "aix-prtconf",
        "aix-topas",
        "vmstat",
        "sar"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-lsdev",
      "name": "lsdev",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.devices",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
