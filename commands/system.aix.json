          "desc": "시스템 전체 메모리 요약"
        },
        {
          "flag": "-P [{{PID}}]",
          "desc": "프로세스별 메모리 사용량"
        },
        {
          "flag": "-U [{{USER}}]",
          "desc": "사용자별 메모리 사용량"
