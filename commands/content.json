{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "content",
  "commands": [
    {
      "id": "cat",
      "name": "cat",
      "kind": "command",
      "shell": "sh",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일 내용 전체 출력·여러 파일 이어 붙이기",
      "description": "파일 내용을 화면에 그대로 출력합니다. 짧은 설정 파일 확인, 여러 파일 이어 붙이기, 히어독(heredoc)으로 파일 작성에 사용합니다. 긴 파일은 less 로 보는 것이 좋습니다.",
      "syntax": [
        "cat [{{OPTIONS}}] {{FILE}}..."
      ],
      "options": [
        {
          "flag": "-n",
          "desc": "모든 줄에 줄 번호 표시"
        },
        {
          "flag": "-b",
          "desc": "빈 줄을 제외하고 줄 번호 표시"
        },
        {
          "flag": "-A",
          "desc": "탭(^I), 줄 끝($), 제어 문자를 보이게 표시 (CRLF 는 ^M$)"
        },
        {
          "flag": "-s",
          "desc": "연속된 빈 줄을 하나로 줄임"
        },
        {
          "flag": "-v",
          "desc": "출력할 수 없는 제어 문자를 ^ 형식으로 표시"
        }
      ],
      "examples": [
        {
          "title": "설정 파일 내용 확인",
          "command": "cat /etc/os-release"
        },
        {
          "title": "주석과 빈 줄 빼고 실제 설정만 보기",
          "command": "grep -Ev '^\\s*(#|$)' /etc/ssh/sshd_config"
        },
        {
          "title": "숨은 공백·탭·CRLF 확인",
          "command": "cat -A {{FILE}}"
        },
        {
          "title": "히어독으로 설정 파일 작성",
          "command": "cat > /etc/sysctl.d/99-custom.conf <<'EOF'\nvm.swappiness = 10\nEOF"
        },
        {
          "title": "분할 파일 합치기",
          "command": "cat {{FILE}}.part* > {{FILE}}"
        }
      ],
      "cautions": [
        "바이너리 파일을 cat 하면 터미널이 깨질 수 있습니다. 이때는 reset 명령으로 복구합니다.",
        "cat > {{FILE}} 은 기존 내용을 덮어씁니다. 추가는 >> 를 사용하세요."
      ],
      "help": "man cat",
      "keywords": [
        "내용 보기",
        "파일 출력",
        "파일 합치기",
        "heredoc",
        "concatenate",
        "view"
      ],
      "related": [
        "less",
        "more",
        "head",
        "tail",
        "grep"
      ]
    },
    {
      "id": "less",
      "name": "less",
      "kind": "command",
      "shell": "sh",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "긴 파일·로그를 페이지 단위로 보고 검색",
      "description": "큰 파일을 전부 읽지 않고 페이지 단위로 앞뒤로 이동하며 볼 수 있는 페이저입니다. 화면 안에서 / 로 검색하고 Shift+F 로 tail -f 처럼 실시간 추적도 할 수 있어 로그 분석에 가장 많이 씁니다.",
      "syntax": [
        "less [{{OPTIONS}}] {{FILE}}",
        "{{COMMAND}} | less"
      ],
      "options": [
        {
          "flag": "-N",
          "desc": "줄 번호 표시"
        },
        {
          "flag": "-S",
          "desc": "긴 줄을 접지 않고 잘라서 표시 (좌우 화살표로 이동)"
        },
        {
          "flag": "-i",
          "desc": "검색 시 대소문자 무시 (패턴에 대문자가 있으면 구분)"
        },
        {
          "flag": "-R",
          "desc": "색상 등 ANSI 제어 문자를 그대로 해석해 표시"
        },
        {
          "flag": "+F",
          "desc": "파일 끝에서 실시간 추적 모드로 시작 (Ctrl+C 로 일반 모드)"
        },
        {
          "flag": "+G",
          "desc": "파일 끝에서 시작"
        },
        {
          "flag": "/{{PATTERN}} · n · N",
          "desc": "(화면 안) 앞으로 검색 · 다음 · 이전 결과 (?는 뒤로 검색)"
        },
        {
          "flag": "g · G · q",
          "desc": "(화면 안) 처음으로 · 끝으로 · 종료"
        },
        {
          "flag": "F",
          "desc": "(화면 안) 실시간 추적 모드 전환"
        },
        {
          "flag": "&{{PATTERN}}",
          "desc": "(화면 안) 패턴과 일치하는 줄만 표시"
        }
      ],
      "examples": [
        {
          "title": "로그 파일을 끝에서부터 보기",
          "command": "less +G /var/log/messages",
          "platforms": [
            "rhel"
          ]
        },
        {
          "title": "로그 파일을 끝에서부터 보기",
          "command": "less +G /var/log/syslog",
          "platforms": [
            "debian"
          ]
        },
        {
          "title": "긴 줄을 자르고 줄 번호와 함께 보기",
          "command": "less -SN {{FILE}}"
        },
        {
          "title": "실시간 추적으로 열고, 필요할 때 Ctrl+C 로 멈춰 검색",
          "command": "less +F /var/log/{{APP}}/{{LOG_FILE}}"
        },
        {
          "title": "명령 출력 결과를 넘겨 보기",
          "command": "journalctl -u {{SERVICE}} --no-pager | less"
        }
      ],
      "cautions": [
        "압축된 로그(.gz)는 zless 또는 zcat {{FILE}}.gz | less 로 봅니다."
      ],
      "help": "man less (실행 중 h)",
      "keywords": [
        "페이지 보기",
        "로그 보기",
        "검색",
        "pager",
        "view",
        "스크롤"
      ],
      "related": [
        "more",
        "cat",
        "tail",
        "grep",
        "journalctl"
      ]
    },
    {
      "id": "more",
      "name": "more",
      "kind": "command",
      "shell": "sh",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일을 한 화면씩 넘겨 보기 (단순 페이저)",
      "description": "파일 내용을 한 화면씩 끊어서 보여주는 기본 페이저입니다. less 보다 기능이 적어 주로 앞으로만 넘겨 볼 때 쓰며, less 가 없는 최소 환경에서 대안으로 사용합니다.",
      "syntax": [
        "more [{{OPTIONS}}] {{FILE}}",
        "{{COMMAND}} | more"
      ],
      "options": [
        {
          "flag": "+{{N}}",
          "desc": "N 번째 줄부터 표시"
        },
        {
          "flag": "+/{{PATTERN}}",
          "desc": "패턴이 처음 나오는 곳부터 표시"
        },
        {
          "flag": "-s",
          "desc": "연속된 빈 줄을 하나로 줄임"
        },
        {
          "flag": "-d",
          "desc": "하단에 조작 안내 메시지 표시"
        },
        {
          "flag": "Space · Enter · b · q",
          "desc": "(화면 안) 다음 페이지 · 한 줄 · 이전 페이지 · 종료"
        },
        {
          "flag": "/{{PATTERN}}",
          "desc": "(화면 안) 패턴 검색"
        }
      ],
      "examples": [
        {
          "title": "파일 한 화면씩 보기",
          "command": "more {{FILE}}"
        },
        {
          "title": "100번째 줄부터 보기",
          "command": "more +100 {{FILE}}"
        },
        {
          "title": "긴 명령 출력을 끊어서 보기",
          "command": "rpm -qa | more",
          "platforms": [
            "rhel"
          ]
        }
      ],
      "cautions": [
        "파이프로 받은 입력은 뒤로(b) 이동할 수 없습니다. 자유롭게 이동하려면 less 를 사용하세요."
      ],
      "help": "man more",
      "keywords": [
        "페이지 보기",
        "한 화면씩",
        "pager",
        "more"
      ],
      "related": [
        "less",
        "cat"
      ]
    },
    {
      "id": "type",
      "name": "type",
      "kind": "command",
      "shell": "cmd",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "CMD 에서 텍스트 파일 내용 출력",
      "description": "CMD 내장 명령으로 텍스트 파일 내용을 화면에 출력합니다. Linux 의 cat 에 해당하며, 여러 파일을 지정하면 파일 이름과 함께 차례로 출력합니다.",
      "syntax": [
        "type {{FILE}} [{{FILE}}...]"
      ],
      "options": [],
      "examples": [
        {
          "title": "hosts 파일 내용 확인",
          "command": "type C:\\Windows\\System32\\drivers\\etc\\hosts"
        },
        {
          "title": "긴 파일은 한 화면씩",
          "command": "type {{FILE}} | more"
        },
        {
          "title": "로그에서 특정 문자열만 보기",
          "command": "type {{FILE}} | findstr /i \"error\""
        },
        {
          "title": "빈 파일 만들기",
          "command": "type nul > {{FILE}}"
        }
      ],
      "cautions": [
        "UTF-8 파일의 한글이 깨지면 chcp 65001 로 코드 페이지를 바꾼 뒤 다시 실행하세요.",
        "PowerShell 에서 type 은 Get-Content 의 별칭입니다."
      ],
      "help": "type /?",
      "keywords": [
        "내용 보기",
        "파일 출력",
        "cat",
        "view",
        "type"
      ],
      "related": [
