    {
      "id": "compare-object",
      "name": "Compare-Object",
      "aliases": [
        "compare"
      ],
      "kind": "command",
      "shell": "powershell",
      "category": "content",
      "task": "content.compare",
      "platforms": [
        "windows"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "두 객체 집합(파일 내용·목록) 차이 비교",
      "description": "두 개의 객체 집합을 비교해 한쪽에만 있는 항목을 표시합니다. 파일 내용은 Get-Content 로 읽어 비교하고, 서비스·프로그램·폴더 목록 비교에도 사용합니다. SideIndicator 의 <= 는 기준(Reference)에만, => 는 비교 대상(Difference)에만 있다는 뜻입니다.",
      "syntax": [
        "Compare-Object -ReferenceObject {{REF}} -DifferenceObject {{DIFF}} [-Property {{PROPERTY}}] [-IncludeEqual]"
      ],
      "options": [
        {
          "flag": "-ReferenceObject {{REF}}",
          "desc": "기준 객체 집합"
        },
        {
          "flag": "-DifferenceObject {{DIFF}}",
          "desc": "비교 대상 객체 집합"
        },
        {
          "flag": "-Property {{PROPERTY}}",
          "desc": "비교할 속성 지정 (예: Name, Length)"
        },
        {
          "flag": "-IncludeEqual",
          "desc": "같은 항목도 == 로 표시"
        },
        {
          "flag": "-ExcludeDifferent",
          "desc": "같은 항목만 표시 (-IncludeEqual 과 함께)"
        },
        {
          "flag": "-CaseSensitive",
          "desc": "대소문자 구분"
        },
        {
          "flag": "-PassThru",
          "desc": "원본 객체에 SideIndicator 를 붙여 반환"
        }
      ],
      "examples": [
        {
          "title": "두 텍스트 파일 내용 비교",
          "command": "Compare-Object (Get-Content {{FILE1}}) (Get-Content {{FILE2}})"
        },
        {
          "title": "두 폴더의 파일 목록 비교",
          "command": "Compare-Object (Get-ChildItem {{DIR1}} -Recurse) (Get-ChildItem {{DIR2}} -Recurse) -Property Name, Length"
        },
        {
          "title": "두 서버의 설치된 핫픽스 비교",
          "command": "Compare-Object (Get-HotFix -ComputerName {{SERVER1}}) (Get-HotFix -ComputerName {{SERVER2}}) -Property HotFixID"
        }
      ],
      "cautions": [
        "줄 순서가 아닌 항목 집합으로 비교하므로, 어느 줄 번호가 바뀌었는지는 알려주지 않습니다. 줄 단위 비교는 fc.exe 를 사용하세요."
      ],
      "help": "Get-Help Compare-Object -Full",
