      "syntax": [
        "vim [{{OPTIONS}}] {{FILE}}",
        "vi {{FILE}}"
      ],
      "options": [
        {
          "flag": "+{{N}}",
          "desc": "N 번째 줄에서 열기"
        },
        {
          "flag": "+/{{PATTERN}}",
          "desc": "패턴이 처음 나오는 줄에서 열기"
        },
        {
          "flag": "-R",
          "desc": "읽기 전용으로 열기 (view 와 동일)"
        },
        {
          "flag": "-d {{FILE1}} {{FILE2}}",
          "desc": "두 파일 차이를 나란히 비교 (vimdiff)"
        },
        {
          "flag": "i · a · o",
          "desc": "(명령 모드) 커서 앞 · 뒤 · 다음 줄에서 입력 시작, Esc 로 명령 모드 복귀"
        },
        {
          "flag": ":w · :q · :wq · :q!",
          "desc": "(명령 모드) 저장 · 종료 · 저장 후 종료 · 저장 없이 강제 종료"
        },
        {
          "flag": "/{{PATTERN}} · n · N",
          "desc": "(명령 모드) 검색 · 다음 · 이전"
        },
        {
          "flag": "dd · yy · p · u",
          "desc": "(명령 모드) 줄 삭제(잘라내기) · 줄 복사 · 붙여넣기 · 되돌리기"
        },
        {
          "flag": ":%s/{{OLD}}/{{NEW}}/g",
          "desc": "(명령 모드) 파일 전체 문자열 치환"
        },
        {
          "flag": ":set nu · :set paste",
          "desc": "(명령 모드) 줄 번호 표시 · 붙여넣기 시 자동 들여쓰기 끄기"
        }
