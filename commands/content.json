        "findstr",
        "get-content"
      ]
    },
    {
      "id": "win-more",
      "name": "more",
      "kind": "command",
      "shell": "cmd",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "CMD 에서 출력을 한 화면씩 끊어 보기",
      "description": "파일 내용이나 명령 출력을 한 화면씩 끊어서 보여줍니다. Space 로 다음 페이지, Enter 로 한 줄씩 넘기고, Q 로 종료합니다(/e 확장 기능 사용 시).",
      "syntax": [
        "more [/e] [/c] [/s] [+{{N}}] {{FILE}}",
        "{{COMMAND}} | more"
      ],
      "options": [
        {
          "flag": "/e",
          "desc": "확장 기능 사용 (Q 종료, P n 다음 n줄, S n 건너뛰기 등)"
        },
        {
          "flag": "/c",
          "desc": "페이지 표시 전 화면 지우기"
        },
        {
          "flag": "/s",
          "desc": "연속된 빈 줄을 하나로 줄임"
        },
        {
          "flag": "+{{N}}",
          "desc": "N 번째 줄부터 표시"
        }
      ],
      "examples": [
        {
          "title": "긴 명령 출력 끊어 보기",
          "command": "netstat -ano | more"
        },
        {
          "title": "파일을 한 화면씩 보기",
          "command": "more {{FILE}}"
        },
        {
          "title": "100번째 줄부터 보기",
          "command": "more +100 {{FILE}}"
        }
      ],
      "cautions": [],
      "help": "more /?",
      "keywords": [
        "페이지 보기",
        "한 화면씩",
        "pager",
        "more"
      ],
      "related": [
        "type",
        "get-content"
      ]
    },
    {
      "id": "get-content",
      "name": "Get-Content",
      "aliases": [
        "gc",
        "cat",
        "type"
      ],
      "kind": "command",
      "shell": "powershell",
      "category": "content",
      "task": "content.view",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일 내용 출력, 마지막 N줄·실시간 로그 추적",
      "description": "파일 내용을 줄 단위로 읽어 출력합니다. -Tail 로 마지막 N줄, -Wait 로 tail -f 처럼 실시간 추적, -TotalCount 로 앞부분만 볼 수 있어 Windows 로그 확인의 기본 도구입니다.",
      "syntax": [
        "Get-Content [-Path] {{FILE}} [-Tail {{N}}] [-Wait] [-TotalCount {{N}}] [-Encoding {{ENCODING}}]"
      ],
      "options": [
        {
          "flag": "-Tail {{N}}",
          "desc": "마지막 N줄만 출력 (tail -n)"
        },
        {
          "flag": "-Wait",
          "desc": "파일 끝에서 대기하며 추가되는 줄을 실시간 출력 (tail -f, Ctrl+C 로 종료)"
        },
        {
          "flag": "-TotalCount {{N}}",
          "desc": "처음 N줄만 출력 (별칭 -Head, -First)"
        },
        {
          "flag": "-Encoding {{ENCODING}}",
          "desc": "문자 인코딩 지정 (UTF8, Unicode, Default 등)"
        },
        {
          "flag": "-Raw",
          "desc": "줄 배열이 아닌 하나의 문자열로 읽기"
        },
        {
          "flag": "-ReadCount {{N}}",
          "desc": "한 번에 넘길 줄 수 (0 이면 전체, 큰 파일 처리 속도 향상)"
        }
      ],
      "examples": [
        {
          "title": "로그 마지막 50줄 보기",
          "command": "Get-Content {{FILE}} -Tail 50"
        },
        {
          "title": "로그 실시간 추적 (tail -f)",
          "command": "Get-Content {{FILE}} -Tail 20 -Wait"
        },
        {
          "title": "실시간 추적하면서 오류 줄만 보기",
          "command": "Get-Content {{FILE}} -Tail 0 -Wait | Select-String -Pattern 'error|fail'"
        },
        {
          "title": "파일 앞 10줄 보기",
          "command": "Get-Content {{FILE}} -TotalCount 10"
        },
        {
          "title": "UTF-8 파일 한글 깨짐 없이 읽기",
          "command": "Get-Content {{FILE}} -Encoding UTF8"
        }
      ],
      "cautions": [
        "Windows PowerShell 5.1 은 BOM 없는 UTF-8 파일을 시스템 기본 코드 페이지(CP949)로 읽어 한글이 깨집니다. -Encoding UTF8 을 지정하세요. PowerShell 7 은 기본이 UTF-8 입니다.",
        "수 GB 로그를 -Tail 없이 읽으면 메모리를 많이 쓰고 느립니다."
      ],
      "help": "Get-Help Get-Content -Full",
      "keywords": [
        "내용 보기",
        "로그 보기",
        "실시간 로그",
        "tail -f",
        "마지막 줄",
        "cat",
        "gc"
      ],
      "related": [
        "select-string",
        "type",
        "measure-object",
        "tee-object",
        "get-winevent"
      ]
    },
    {
      "id": "head",
      "name": "head",
      "kind": "command",
      "shell": "sh",
      "category": "content",
      "task": "content.head-tail",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일·출력의 앞부분 N줄 출력",
      "description": "파일이나 명령 출력의 처음 몇 줄(기본 10줄)만 출력합니다. 큰 파일의 형식 확인, 정렬 결과의 상위 N개 추출에 자주 씁니다.",
      "syntax": [
        "head [-n {{N}}] {{FILE}}...",
        "{{COMMAND}} | head -n {{N}}"
      ],
      "options": [
        {
          "flag": "-n {{N}}",
          "desc": "처음 N줄 출력 (기본 10)"
        },
        {
          "flag": "-n -{{N}}",
          "desc": "마지막 N줄을 제외한 나머지 전부 출력"
        },
        {
          "flag": "-c {{N}}",
          "desc": "처음 N바이트 출력"
        },
        {
          "flag": "-q",
          "desc": "여러 파일일 때 파일 이름 머리글 생략"
        },
        {
          "flag": "-v",
          "desc": "항상 파일 이름 머리글 출력"
        }
      ],
      "examples": [
        {
          "title": "CSV 파일 머리글과 앞부분 확인",
          "command": "head -n 5 {{FILE}}"
        },
        {
          "title": "용량 큰 디렉토리 상위 10개",
          "command": "du -sh /var/* 2>/dev/null | sort -rh | head -n 10"
        },
        {
          "title": "CPU 사용률 상위 프로세스 5개",
          "command": "ps aux --sort=-%cpu | head -n 6"
        }
      ],
      "cautions": [],
      "help": "man head",
      "keywords": [
        "앞부분",
        "처음 몇 줄",
        "상위 N개",
        "head",
        "top lines"
      ],
      "related": [
        "tail",
        "less",
        "sort"
      ]
    },
    {
      "id": "tail",
      "name": "tail",
      "kind": "command",
      "shell": "sh",
      "category": "content",
      "task": "content.head-tail",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일 끝부분 출력·실시간 로그 추적(-f)",
      "description": "파일의 마지막 몇 줄(기본 10줄)을 출력합니다. -f 로 파일에 추가되는 내용을 실시간으로 보여주어 장애 재현·서비스 기동 확인 시 로그 모니터링에 가장 많이 쓰는 명령입니다.",
      "syntax": [
        "tail [-n {{N}}] [-f|-F] {{FILE}}..."
      ],
      "options": [
        {
          "flag": "-n {{N}}",
          "desc": "마지막 N줄 출력 (기본 10)"
        },
        {
          "flag": "-n +{{N}}",
          "desc": "N 번째 줄부터 끝까지 출력"
        },
        {
          "flag": "-f",
          "desc": "추가되는 내용을 실시간 출력 (Ctrl+C 로 종료)"
        },
        {
          "flag": "-F",
          "desc": "-f + 파일이 순환(logrotate)·재생성되어도 다시 열어 계속 추적"
        },
        {
          "flag": "-c {{N}}",
