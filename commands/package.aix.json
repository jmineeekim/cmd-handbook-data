{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "package",
  "commands": [
    {
      "id": "aix-lslpp",
      "name": "lslpp",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.single",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "설치된 fileset·버전·상태·이력 조회",
      "description": "AIX 기본 패키지 단위인 fileset(installp 형식)의 설치 버전과 상태(COMMITTED, APPLIED, BROKEN, EFIXLOCKED)를 보여 줍니다. 특정 파일이 어느 fileset 에 속하는지(-w), fileset 이 설치한 파일 목록(-f), 설치·업데이트 이력(-h)도 확인할 수 있습니다.",
      "syntax": [
        "lslpp -l [{{FILESET}}]",
        "lslpp -L [{{FILESET}}]",
        "lslpp -w {{PATH}}",
        "lslpp -f {{FILESET}}",
        "lslpp -h {{FILESET}}"
      ],
      "options": [
        { "flag": "-l", "desc": "fileset 이름·레벨·상태·설명 (Path 별로 구분)" },
        { "flag": "-L", "desc": "fileset 과 함께 RPM, interim fix 등 다른 유형도 한 목록으로 (Type 열)" },
        { "flag": "-w {{PATH}}", "desc": "파일이 속한 fileset 찾기" },
        { "flag": "-f {{FILESET}}", "desc": "fileset 이 설치한 파일 목록" },
        { "flag": "-h {{FILESET}}", "desc": "설치·적용·커밋 이력 (날짜, 레벨)" },
        { "flag": "-c", "desc": "콜론(:) 구분 출력 (스크립트용)" },
        { "flag": "-d {{FILESET}}", "desc": "이 fileset 에 의존하는 fileset 목록" },
        { "flag": "-p {{FILESET}}", "desc": "이 fileset 의 선행 요구(prerequisite) 목록" }
      ],
      "commandGroups": [
        {
          "title": "fileset 상태(State) 값",
          "type": "directive",
          "items": [
            { "cmd": "COMMITTED", "desc": "확정 설치. 이전 레벨로 되돌릴 수 없음" },
            { "cmd": "APPLIED", "desc": "적용만 됨. installp -r 로 이전 레벨로 되돌릴 수 있음" },
            { "cmd": "BROKEN", "desc": "설치 실패 등으로 깨진 상태 → installp -C 정리 후 재설치" },
            { "cmd": "EFIXLOCKED", "desc": "interim fix(efix)가 적용되어 잠김 → 업데이트 전 emgr 로 efix 제거 필요" }
          ]
        }
      ],
      "examples": [
        { "title": "OpenSSH·OpenSSL 버전 확인 (보안 점검)", "command": "lslpp -l | grep -i -E 'openssh|openssl'" },
        { "title": "명령 파일이 어느 fileset 에 속하는지", "command": "lslpp -w /usr/bin/{{COMMAND}}" },
        { "title": "APPLIED·BROKEN 상태 fileset 찾기", "command": "lslpp -l | grep -E 'APPLIED|BROKEN|EFIXLOCKED'" },
        { "title": "fileset 설치 이력", "command": "lslpp -h bos.rte" }
      ],
      "cautions": [],
      "help": "man lslpp",
      "keywords": ["설치 목록", "fileset", "lslpp", "패키지 버전", "설치 이력", "파일 소속", "rpm -qa"],
      "related": ["aix-installp", "aix-lppchk", "aix-oslevel", "aix-emgr", "rpm"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-installp",
      "name": "installp",
      "aliases": ["install_all_updates"],
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.update",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "fileset 설치·업데이트(TL/SP)·커밋·되돌리기·삭제",
      "description": "AIX 의 installp 형식 소프트웨어(fileset, BFF)를 설치·업데이트·제거합니다. 업데이트는 먼저 APPLIED 상태로 적용해 두면 문제가 있을 때 reject 로 이전 레벨로 되돌릴 수 있고, 안정화 후 commit 으로 확정합니다. TL·SP 업데이트에는 install_all_updates 나 smitty update_all 을 주로 씁니다.",
      "syntax": [
        "installp -apgXYd {{SOURCE_DIR}} {{FILESET}} | all",
        "installp -agXYd {{SOURCE_DIR}} {{FILESET}} | all",
        "installp -c all",
        "installp -r {{FILESET}}",
        "installp -u {{FILESET}}",
        "install_all_updates -d {{SOURCE_DIR}} -Y"
      ],
      "options": [
        { "flag": "-a", "desc": "적용(apply)" },
        { "flag": "-c", "desc": "커밋(commit). -a 와 함께 쓰면 적용과 동시에 확정" },
        { "flag": "-r", "desc": "APPLIED 상태 업데이트 되돌리기(reject)" },
        { "flag": "-u", "desc": "fileset 제거(deinstall)" },
        { "flag": "-C", "desc": "설치 실패 후 정리(cleanup)" },
        { "flag": "-p", "desc": "미리보기(preview). 실제로 설치하지 않고 요구 사항·공간 확인" },
        { "flag": "-g", "desc": "필요한 선행 fileset 자동 포함" },
        { "flag": "-X", "desc": "공간이 부족하면 파일시스템 자동 확장" },
        { "flag": "-Y", "desc": "라이선스 동의" },
        { "flag": "-d {{SOURCE_DIR}}", "desc": "설치 원본 위치 (디렉토리, /dev/cd0)" },
        { "flag": "-s", "desc": "APPLIED 상태(커밋 안 된) fileset 목록" },
        { "flag": "-l", "desc": "설치 원본에 있는 fileset 목록 (-d 와 함께)" },
        { "flag": "-e {{LOG_FILE}}", "desc": "설치 로그를 지정 파일에 기록" }
      ],
      "commandGroups": [
        {
          "title": "작업별 플래그 조합",
          "type": "subcommand",
          "items": [
            { "cmd": "installp -ld {{SOURCE_DIR}}", "desc": "원본에 있는 fileset 목록 확인" },
            { "cmd": "installp -apgXYd {{SOURCE_DIR}} all", "desc": "미리보기 (항상 먼저 실행)" },
            { "cmd": "installp -agXYd {{SOURCE_DIR}} all", "desc": "적용만 (APPLIED, 나중에 되돌리기 가능)" },
            { "cmd": "installp -acgXYd {{SOURCE_DIR}} {{FILESET}}", "desc": "적용 + 커밋 (신규 설치에 주로 사용)" },
            { "cmd": "installp -s", "desc": "커밋 안 된 fileset 확인" },
            { "cmd": "installp -c all", "desc": "APPLIED 전부 커밋 (안정화 확인 후)" },
            { "cmd": "installp -pr {{FILESET}}", "desc": "되돌리기 미리보기" },
            { "cmd": "installp -r {{FILESET}}", "desc": "APPLIED 업데이트 되돌리기" },
            { "cmd": "installp -pu {{FILESET}}", "desc": "제거 미리보기 (의존 fileset 확인)" },
            { "cmd": "installp -u {{FILESET}}", "desc": "fileset 제거" },
            { "cmd": "installp -C", "desc": "BROKEN 상태 정리" }
          ]
        }
      ],
      "examples": [
        {
          "title": "TL·SP 업데이트 (되돌릴 수 있게 APPLIED 로)",
          "steps": [
            { "prompt": "#", "cmd": "oslevel -s; lppchk -v", "desc": "현재 레벨과 fileset 정합성 확인 (lppchk 는 출력 없으면 정상)" },
            { "prompt": "#", "cmd": "mksysb -i -X {{BACKUP_DIR}}/$(hostname).pre_update.mksysb", "desc": "OS 백업 (가능하면 alt_disk_copy -d {{HDISK2}} 로 rootvg 복제본도 확보)" },
            { "prompt": "#", "cmd": "emgr -l", "desc": "적용된 efix 확인. 업데이트 대상과 겹치면 emgr -r 로 먼저 제거" },
            { "prompt": "#", "cmd": "inutoc {{SOURCE_DIR}}", "desc": "업데이트 디렉토리에 .toc 생성" },
            { "prompt": "#", "cmd": "installp -apgXYd {{SOURCE_DIR}} all", "desc": "미리보기로 오류·공간 부족 확인" },
            { "prompt": "#", "cmd": "install_all_updates -d {{SOURCE_DIR}} -Y", "desc": "업데이트 적용 (기본은 커밋하지 않음)" },
            { "prompt": "#", "cmd": "shutdown -Fr", "desc": "재부팅 (bos.mp64 등 커널 갱신 시 필수)" },
            { "prompt": "#", "cmd": "oslevel -s; lppchk -v", "desc": "레벨 반영·정합성 확인. 안정화 후 installp -c all 로 커밋" }
          ]
        },
        { "title": "적용된 업데이트 되돌리기", "command": "installp -s\ninstallp -pr {{FILESET}}\ninstallp -r {{FILESET}}" }
      ],
      "cautions": [
        "커밋(-c)한 업데이트는 되돌릴 수 없습니다. 운영 서버는 APPLIED 로 일정 기간 운영 후 커밋하는 방식을 권장합니다.",
        "APPLIED 상태는 이전 버전 파일을 /usr/lpp 아래 저장하므로 /usr 공간을 더 씁니다.",
        "EFIXLOCKED 상태 fileset 이 있으면 업데이트가 실패합니다. emgr 로 efix 를 먼저 제거하세요.",
        "업데이트 전 반드시 mksysb 백업을 받고, 클러스터 환경은 노드별로 순차 진행하세요."
      ],
      "help": "man installp · man install_all_updates",
      "keywords": ["패치", "TL 업데이트", "SP 업데이트", "installp", "fileset 설치", "commit", "reject", "update_all"],
      "related": ["aix-lslpp", "aix-instfix", "aix-emgr", "aix-inutoc", "aix-lppchk", "aix-mksysb", "aix-oslevel"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-lppchk",
      "name": "lppchk",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.single",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "설치된 fileset 정합성 검사 (요구 관계·파일)",
      "description": "설치된 소프트웨어의 일관성을 검사합니다. -v 는 fileset 요구 관계와 설치 상태가 맞는지 확인하며 업데이트 전후 점검에 필수입니다. 출력이 없으면 정상입니다.",
      "syntax": [
        "lppchk -v",
        "lppchk -c [{{FILESET}}]",
        "lppchk -f [{{FILESET}}]",
        "lppchk -l [{{FILESET}}]"
      ],
      "options": [
        { "flag": "-v", "desc": "요구 관계·설치 상태 검사" },
        { "flag": "-c", "desc": "파일 체크섬 검사 (변조·손상 확인)" },
        { "flag": "-f", "desc": "파일 존재·크기 검사" },
        { "flag": "-l", "desc": "심볼릭 링크 검사" }
      ],
      "examples": [
        { "title": "업데이트 전후 정합성 확인", "command": "lppchk -v", "note": "출력이 없으면 정상입니다. 누락된 선행 fileset 이 나오면 해당 fileset 을 설치·업데이트합니다." },
        { "title": "특정 fileset 파일 체크섬 검사", "command": "lppchk -c bos.rte.security" }
      ],
      "cautions": [
        "-c 로 전체를 검사하면 시간이 오래 걸립니다. 필요한 fileset 만 지정하세요."
      ],
      "help": "man lppchk",
      "keywords": ["정합성 검사", "lppchk", "fileset 검사", "체크섬", "업데이트 점검"],
      "related": ["aix-lslpp", "aix-installp", "aix-oslevel"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-instfix",
      "name": "instfix",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.update",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "APAR·TL·SP 적용 여부 확인",
      "description": "특정 APAR(IBM 결함 수정 번호)이나 TL·SP 묶음이 시스템에 모두 설치되었는지 확인합니다. 보안 공지의 APAR 적용 여부 점검, TL 업데이트가 완전히 끝났는지 확인에 씁니다. -d 와 함께 쓰면 설치 원본에서 해당 수정만 설치할 수도 있습니다.",
      "syntax": [
        "instfix -ik {{APAR}}",
        "instfix -i | grep -E 'ML|SP'",
        "instfix -icqk {{KEYWORD}}"
      ],
      "options": [
        { "flag": "-i", "desc": "설치 여부 확인 모드" },
        { "flag": "-k {{KEYWORD}}", "desc": "APAR 번호 또는 TL/SP 키워드 (예: 7200-05_AIX_ML)" },
        { "flag": "-v", "desc": "fileset 별 상세 표시" },
        { "flag": "-c", "desc": "콜론(:) 구분 출력" },
        { "flag": "-q", "desc": "조용히 (스크립트용)" },
        { "flag": "-d {{SOURCE_DIR}}", "desc": "설치 원본 지정 (-k 와 함께 쓰면 해당 수정 설치)" },
        { "flag": "-T", "desc": "설치 원본에 포함된 수정 목록 (-d 와 함께)" }
      ],
      "examples": [
        { "title": "보안 APAR 적용 여부", "command": "instfix -ik {{APAR}}" },
        { "title": "TL·SP 가 모두 설치되었는지", "command": "instfix -i | grep -E 'ML|SP'", "note": "'All filesets for ... were found' 이면 완전히 적용된 것이고 'Not all filesets' 이면 일부가 빠진 것입니다." },
        { "title": "TL 에서 빠진 fileset 찾기", "command": "instfix -icqk {{TL_KEYWORD}} | grep ':-:'", "note": "{{TL_KEYWORD}} 예: 7200-05_AIX_ML" }
      ],
      "cautions": [],
      "help": "man instfix",
      "keywords": ["APAR", "instfix", "패치 확인", "TL 확인", "보안 패치", "ML", "SP"],
      "related": ["aix-oslevel", "aix-installp", "aix-emgr", "aix-lslpp"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-emgr",
      "name": "emgr",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.update",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "interim fix(efix) 조회·설치·제거",
      "description": "IBM 이 정식 SP 전에 배포하는 임시 수정(interim fix, efix)을 관리합니다. 보안 취약점 긴급 패치가 주로 efix(.epkg.Z) 형태로 나옵니다. efix 가 적용된 fileset 은 EFIXLOCKED 로 잠기므로 TL·SP 업데이트 전에 확인·제거해야 합니다.",
      "syntax": [
        "emgr -l",
        "emgr -p -e {{EFIX_FILE}}",
        "emgr -X -e {{EFIX_FILE}}",
        "emgr -r -L {{LABEL}}"
      ],
      "options": [
        { "flag": "-l", "desc": "설치된 efix 목록 (ID, STATE, LABEL, 설치 시각)" },
        { "flag": "-e {{EFIX_FILE}}", "desc": "efix 패키지(.epkg.Z) 설치" },
        { "flag": "-p", "desc": "미리보기 (-e, -r 과 함께)" },
        { "flag": "-X", "desc": "공간이 부족하면 파일시스템 자동 확장" },
        { "flag": "-r -L {{LABEL}}", "desc": "레이블로 efix 제거" },
        { "flag": "-c -L {{LABEL}}", "desc": "설치된 efix 파일 검사" },
        { "flag": "-v {{LEVEL}}", "desc": "상세 수준 (예: emgr -l -v3)" }
      ],
      "examples": [
        {
          "title": "보안 efix 적용",
          "steps": [
            { "prompt": "#", "cmd": "emgr -l", "desc": "기존 efix 확인" },
            { "prompt": "#", "cmd": "oslevel -s", "desc": "efix 가 대상으로 하는 TL·SP 레벨과 일치하는지 확인 (README 참조)" },
            { "prompt": "#", "cmd": "emgr -p -e {{EFIX_FILE}}", "desc": "미리보기로 충돌·잠금 확인" },
            { "prompt": "#", "cmd": "emgr -X -e {{EFIX_FILE}}", "desc": "설치" },
            { "prompt": "#", "cmd": "emgr -l", "desc": "STATE 가 S(stable)인지 확인. 재부팅 필요 여부는 설치 메시지 확인" }
          ]
        },
        { "title": "TL 업데이트 전 efix 제거", "command": "emgr -l\nemgr -r -L {{LABEL}}" }
      ],
      "cautions": [
        "efix 는 특정 TL·SP 전용입니다. 레벨이 다르면 설치되지 않거나 문제를 일으킬 수 있습니다.",
        "efix 적용 fileset 은 EFIXLOCKED 가 되어 TL·SP 업데이트가 실패합니다. 업데이트 계획 시 함께 관리하세요.",
        "커널 관련 efix 는 재부팅이 필요할 수 있습니다. 설치 메시지를 확인하세요."
      ],
      "help": "man emgr",
      "keywords": ["efix", "interim fix", "emgr", "긴급 패치", "보안 패치", "EFIXLOCKED", "epkg"],
      "related": ["aix-instfix", "aix-installp", "aix-lslpp", "aix-oslevel"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-inutoc",
      "name": "inutoc",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.offline",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "installp 설치 디렉토리에 목차(.toc) 파일 생성",
      "description": "fileset(BFF) 파일을 모아 둔 디렉토리에 installp 가 읽는 목차 파일(.toc)을 만듭니다. 폐쇄망에서 Fix Central 로 받은 업데이트를 서버에 옮긴 뒤, 또는 디렉토리에 파일을 추가·삭제한 뒤 실행합니다.",
      "syntax": [
        "inutoc [{{SOURCE_DIR}}]"
      ],
      "options": [],
      "examples": [
        { "title": "폐쇄망: 업데이트 파일을 옮긴 뒤 목차 생성", "command": "cd {{SOURCE_DIR}}\ninutoc .\ninstallp -ld .", "note": "디렉토리를 생략하면 /usr/sys/inst.images 가 대상입니다." }
