{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "network",
  "commands": [
    {
      "id": "solaris-dladm",
      "name": "dladm",
      "kind": "command",
      "shell": "sh",
      "category": "network",
      "task": "network.nic",
      "platforms": ["solaris"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "NIC(데이터 링크) 상태·속도·MTU 확인, 링크 집적·VNIC",
      "description": "데이터 링크 계층(물리 NIC, 링크 집적, VLAN, VNIC)을 관리합니다. 링크 상태(up/down), 속도·듀플렉스, MAC 주소, MTU 를 확인하고 링크 집적(aggregation)과 VNIC 을 만듭니다. Solaris 11 은 물리 NIC 이 net0, net1 같은 일반 이름으로 보이며, show-phys 로 실제 드라이버 장치(ixgbe0 등)와 대응을 확인합니다.",
      "syntax": ["dladm show-phys [-m] [-L]", "dladm show-link | show-aggr | show-vnic", "dladm show-linkprop [-p {{PROP}}] [{{LINK}}]", "dladm {{SUBCOMMAND}} [{{ARGS}}] {{LINK}}"],
      "options": [],
      "commandGroups": [
        {"title": "조회", "type": "subcommand", "items": [
          {"cmd": "dladm show-phys", "desc": "물리 NIC 목록 (링크 이름, 장치, 상태, 속도, 듀플렉스)"},
          {"cmd": "dladm show-phys -m", "desc": "물리 NIC 의 MAC 주소", "version": "Solaris 11 이상"},
          {"cmd": "dladm show-phys -L", "desc": "NIC 의 물리 위치(슬롯) 표시", "version": "Solaris 11 이상"},
          {"cmd": "dladm show-link", "desc": "모든 링크 (phys, aggr, vlan, vnic) 와 MTU·상태"},
          {"cmd": "dladm show-ether {{LINK}}", "desc": "이더넷 협상 상태 (자동 협상, 속도)"},
          {"cmd": "dladm show-aggr [-x]", "desc": "링크 집적 구성과 포트별 상태"},
          {"cmd": "dladm show-linkprop -p mtu {{LINK}}", "desc": "링크 속성 확인"}
        ]},
        {"title": "구성 변경", "type": "subcommand", "items": [
          {"cmd": "dladm set-linkprop -p mtu={{MTU}} {{LINK}}", "desc": "MTU 변경 (점보 프레임 9000 등. IP 인터페이스를 먼저 내려야 할 수 있음)"},
          {"cmd": "dladm create-aggr -L active -l {{NIC1}} -l {{NIC2}} aggr0", "desc": "LACP 링크 집적 생성 (스위치에도 LACP 설정 필요)", "version": "Solaris 11 이상"},
          {"cmd": "dladm create-aggr -m dlmp -l {{NIC1}} -l {{NIC2}} aggr0", "desc": "DLMP 집적 (스위치 설정 없이 이중화, 여러 스위치에 연결 가능)", "version": "Solaris 11.1 이상"},
          {"cmd": "dladm create-aggr -d {{NIC1}} -d {{NIC2}} {{KEY}}", "desc": "Solaris 10 형식 링크 집적 (aggr{{KEY}} 생성)", "version": "Solaris 10"},
          {"cmd": "dladm create-vlan -l {{LINK}} -v {{VLAN_ID}} {{VLAN_LINK}}", "desc": "VLAN 링크 생성", "version": "Solaris 11 이상"},
          {"cmd": "dladm create-vnic -l {{LINK}} {{VNIC}}", "desc": "가상 NIC 생성 (Zone 용 등)", "version": "Solaris 11 이상"},
          {"cmd": "dladm rename-link {{OLD}} {{NEW}}", "desc": "링크 이름 변경", "version": "Solaris 11 이상"},
          {"cmd": "dladm delete-aggr aggr0", "desc": "링크 집적 삭제 (위의 IP 인터페이스 먼저 삭제)"}
        ]}
      ],
      "examples": [
        {"title": "NIC 링크 상태·속도와 실제 장치 확인", "command": "dladm show-phys\ndladm show-link"},
        {"title": "링크 다운 원인 확인", "command": "dladm show-phys | grep -i down\ngrep -i 'link down' /var/adm/messages"},
        {"title": "LACP 집적 만들고 IP 할당", "version": "Solaris 11 이상", "steps": [
          {"prompt": "#", "cmd": "dladm show-phys", "desc": "묶을 NIC 확인 (IP 가 설정되어 있으면 ipadm delete-ip 로 먼저 삭제)"},
          {"prompt": "#", "cmd": "dladm create-aggr -L active -l {{NIC1}} -l {{NIC2}} aggr0", "desc": "LACP 집적 생성"},
          {"prompt": "#", "cmd": "ipadm create-ip aggr0", "desc": "IP 인터페이스 생성"},
          {"prompt": "#", "cmd": "ipadm create-addr -T static -a {{IP}}/{{PREFIX}} aggr0/v4", "desc": "IP 주소 할당"},
          {"prompt": "#", "cmd": "dladm show-aggr -x aggr0", "desc": "포트별 attached 상태 확인"}
        ]}
      ],
      "cautions": [
        "원격(ssh)으로 접속한 NIC 에서 집적·MTU·이름 변경을 하면 접속이 끊깁니다. 콘솔(ILOM)에서 작업하세요.",
        "LACP(-L active)는 스위치 포트에도 LACP 설정이 있어야 합니다. 한쪽만 설정하면 통신이 안 됩니다."
      ],
      "platformNotes": {"solaris": "Solaris 10 의 dladm 은 기능이 적고(show-dev, show-link, create-aggr 키 방식), IP 설정은 ifconfig 와 /etc/hostname.* 를 씁니다. Solaris 11 은 dladm(L2) + ipadm(L3) 조합입니다. Linux 의 ip link, ethtool 에 해당."},
      "help": "man dladm",
      "keywords": ["NIC", "링크 상태", "링크 집적", "LACP", "VNIC", "dladm", "MTU", "aggregation"],
      "related": ["solaris-ipadm", "solaris-ipmpstat", "solaris-kstat", "ethtool", "ip"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-ipadm",
      "name": "ipadm",
      "kind": "command",
      "shell": "sh",
      "category": "network",
      "task": "network.config",
      "platforms": ["solaris"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Solaris 11 IP 인터페이스·주소·TCP/IP 파라미터 설정",
      "description": "Solaris 11 에서 IP 인터페이스를 만들고 주소를 할당·삭제하며, IPMP 그룹과 TCP/IP 프로토콜 속성(포트 범위, 버퍼 등)을 설정합니다. ipadm 으로 한 설정은 자동으로 영구 저장되므로 Solaris 10 의 /etc/hostname.* 파일 편집이 필요 없습니다. 주소 객체는 net0/v4 처럼 인터페이스/이름 형식입니다.",
      "syntax": ["ipadm show-if | show-addr [{{ADDROBJ}}]", "ipadm create-ip {{IF}}", "ipadm create-addr -T static -a {{IP}}/{{PREFIX}} {{IF}}/{{NAME}}", "ipadm set-prop -p {{PROP}}={{VALUE}} {{PROTOCOL}}"],
      "options": [
        {"flag": "-t", "desc": "create-addr, set-prop 등에서 임시 적용 (재부팅 시 사라짐)"}
      ],
      "commandGroups": [
        {"title": "인터페이스·주소", "type": "subcommand", "items": [
          {"cmd": "ipadm show-if", "desc": "IP 인터페이스 목록과 상태"},
          {"cmd": "ipadm show-addr", "desc": "주소 객체 목록 (IP/프리픽스, 상태, static/dhcp)"},
          {"cmd": "ipadm create-ip {{IF}}", "desc": "IP 인터페이스 생성 (Solaris 10 의 ifconfig plumb)"},
          {"cmd": "ipadm create-addr -T static -a {{IP}}/{{PREFIX}} {{IF}}/v4", "desc": "고정 IP 할당"},
          {"cmd": "ipadm create-addr -T dhcp {{IF}}/v4", "desc": "DHCP 주소"},
          {"cmd": "ipadm create-addr -T addrconf {{IF}}/v6", "desc": "IPv6 자동 구성"},
          {"cmd": "ipadm delete-addr {{IF}}/v4", "desc": "주소 삭제"},
          {"cmd": "ipadm delete-ip {{IF}}", "desc": "IP 인터페이스 삭제"},
          {"cmd": "ipadm disable-if -t {{IF}} / enable-if -t {{IF}}", "desc": "인터페이스 임시 비활성화·활성화"}
        ]},
        {"title": "IPMP", "type": "subcommand", "items": [
          {"cmd": "ipadm create-ipmp ipmp0", "desc": "IPMP 그룹 인터페이스 생성"},
          {"cmd": "ipadm add-ipmp -i {{NIC1}} -i {{NIC2}} ipmp0", "desc": "IPMP 그룹에 인터페이스 추가 (각 NIC 은 create-ip 로 먼저 생성)"},
          {"cmd": "ipadm create-addr -T static -a {{IP}}/{{PREFIX}} ipmp0/v4", "desc": "IPMP 그룹 서비스 주소"}
        ]},
        {"title": "프로토콜 속성 (Solaris 10 ndd 대체)", "type": "subcommand", "items": [
          {"cmd": "ipadm show-prop tcp", "desc": "TCP 속성 목록 (현재값·기본값·가능한 값)"},
          {"cmd": "ipadm set-prop -p smallest_anon_port={{PORT}} tcp", "desc": "임시 포트 시작 번호 변경 (영구)"},
          {"cmd": "ipadm set-prop -p _time_wait_interval={{MS}} tcp", "desc": "TIME_WAIT 유지 시간 (밑줄로 시작하는 비공개 속성)"},
          {"cmd": "ipadm reset-prop -p {{PROP}} tcp", "desc": "기본값으로 되돌림"}
        ]}
      ],
      "examples": [
        {"title": "고정 IP 설정 (Solaris 11)", "steps": [
          {"prompt": "#", "cmd": "netadm list", "desc": "NCP 가 DefaultFixed 인지 확인 (Automatic 이면 netadm enable -p ncp DefaultFixed)"},
          {"prompt": "#", "cmd": "dladm show-phys", "desc": "사용할 링크(net0 등)와 상태 확인"},
          {"prompt": "#", "cmd": "ipadm create-ip {{IF}}", "desc": "IP 인터페이스 생성"},
          {"prompt": "#", "cmd": "ipadm create-addr -T static -a {{IP}}/{{PREFIX}} {{IF}}/v4", "desc": "고정 IP 할당 (영구 저장)"},
          {"prompt": "#", "cmd": "route -p add default {{GATEWAY}}", "desc": "기본 게이트웨이 (영구)"},
          {"prompt": "#", "cmd": "ipadm show-addr && netstat -rn", "desc": "주소·라우팅 확인 후 DNS 는 svccfg 로 설정"}
        ]},
        {"title": "IP 주소 변경", "command": "ipadm show-addr\nipadm delete-addr {{IF}}/v4\nipadm create-addr -T static -a {{NEW_IP}}/{{PREFIX}} {{IF}}/v4"},
        {"title": "TCP 파라미터 확인", "command": "ipadm show-prop -p smallest_anon_port,largest_anon_port tcp"}
      ],
      "cautions": [
        "원격 접속 중인 인터페이스의 주소를 지우면 바로 끊깁니다. 콘솔에서 작업하거나 다른 관리용 인터페이스로 접속하세요.",
        "NCP 가 Automatic(NWAM) 이면 ipadm 설정이 거부되거나 덮어써집니다. 서버는 DefaultFixed 로 운영하세요."
      ],
      "versions": {"solaris": "11 이상"},
      "platformNotes": {"solaris": "Solaris 11 이상. Solaris 10 은 ifconfig 와 /etc/hostname.<NIC>, /etc/inet/netmasks, /etc/defaultrouter 로 설정합니다. Linux 의 ip addr, nmcli 에 해당."},
      "help": "man ipadm",
      "keywords": ["IP 설정", "고정 IP", "ipadm", "주소 할당", "IPMP", "네트워크 설정", "create-addr"],
      "related": ["solaris-dladm", "solaris-netadm", "solaris-route", "solaris-ipmpstat", "solaris-ndd", "nmcli"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-etc-hostname-if",
      "name": "/etc/hostname.*",
      "kind": "file",
      "category": "network",
      "task": "network.config",
      "platforms": ["solaris"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Solaris 10 NIC 별 영구 IP 설정 파일",
      "description": "Solaris 10 에서 부팅 시 NIC 을 활성화(plumb)하고 IP 를 지정하는 파일입니다. 파일 이름이 인터페이스 이름이고(/etc/hostname.e1000g0), 내용은 호스트명 또는 IP 와 ifconfig 인수입니다. 넷마스크는 /etc/inet/netmasks, 기본 게이트웨이는 /etc/defaultrouter 에 둡니다. 이 파일이 없는 NIC 은 부팅 후 IP 가 설정되지 않습니다.",
      "syntax": ["/etc/hostname.{{NIC}}"],
      "options": [],
      "commandGroups": [
        {"title": "관련 파일과 내용 형식", "type": "directive", "items": [
          {"cmd": "/etc/hostname.{{NIC}}: {{HOSTNAME}}", "desc": "호스트명만 적으면 /etc/inet/hosts 에서 IP 를 찾음"},
          {"cmd": "/etc/hostname.{{NIC}}: {{IP}} netmask {{NETMASK}} broadcast + up", "desc": "IP 와 ifconfig 인수를 직접 지정"},
          {"cmd": "/etc/hostname.{{NIC}}: {{HOSTNAME}} netmask + broadcast + group {{IPMP_GROUP}} up", "desc": "IPMP 그룹 멤버 (링크 기반 IPMP)"},
          {"cmd": "/etc/hostname.{{NIC}}:1", "desc": "논리 인터페이스(추가 IP) 설정 파일"},
          {"cmd": "/etc/inet/hosts", "desc": "IP 와 호스트명 대응 (/etc/hosts 는 이 파일의 링크)"},
          {"cmd": "/etc/inet/netmasks: {{NETWORK}} {{NETMASK}}", "desc": "네트워크별 넷마스크 (netmask + 가 여기서 찾음)"},
          {"cmd": "/etc/defaultrouter: {{GATEWAY}}", "desc": "기본 게이트웨이"},
          {"cmd": "/etc/nodename", "desc": "시스템 호스트명"}
        ]}
      ],
      "examples": [
        {"title": "새 NIC 에 고정 IP 영구 설정 (Solaris 10)", "steps": [
          {"prompt": "#", "cmd": "dladm show-dev", "desc": "NIC 이름과 링크 상태 확인"},
          {"prompt": "#", "cmd": "echo '{{IP}} netmask {{NETMASK}} broadcast + up' > /etc/hostname.{{NIC}}", "desc": "설정 파일 작성"},
          {"prompt": "#", "cmd": "echo '{{IP}} {{HOSTNAME}}' >> /etc/inet/hosts", "desc": "hosts 등록"},
          {"prompt": "#", "cmd": "ifconfig {{NIC}} plumb {{IP}} netmask {{NETMASK}} broadcast + up", "desc": "재부팅 없이 지금 적용"},
          {"prompt": "#", "cmd": "ifconfig -a", "desc": "적용 확인"}
        ]}
      ],
      "cautions": [
        "파일 이름의 NIC 이름이 실제 장치와 다르면(예: 드라이버 변경, 카드 교체 후 인스턴스 번호 변경) 부팅 후 IP 가 올라오지 않습니다.",
        "ifconfig 로만 바꾼 설정은 재부팅하면 사라집니다. 반드시 이 파일에도 반영하세요."
      ],
      "versions": {"solaris": "10 전용"},
      "platformNotes": {"solaris": "Solaris 10 전용 방식. Solaris 11 은 ipadm 으로 설정하며 이 파일을 쓰지 않습니다. Linux 의 /etc/sysconfig/network-scripts/ifcfg-* 에 해당."},
      "keywords": ["IP 영구 설정", "hostname 파일", "netmasks", "defaultrouter", "Solaris 10 네트워크", "/etc/hostname"],
      "related": ["solaris-ipadm", "solaris-route", "ifconfig", "etc-hosts", "etc-sysconfig-network-scripts"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-route",
      "name": "route",
      "kind": "command",
      "shell": "sh",
      "category": "network",
      "task": "network.arp-route",
      "platforms": ["solaris"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Solaris 정적 라우팅 추가·삭제 (-p 영구 저장)",
      "description": "Solaris 의 라우팅 테이블에 경로를 추가·삭제합니다. -p 를 붙이면 /etc/inet/static_routes 에 기록되어 재부팅 후에도 유지됩니다. 문법이 Linux route 와 달리 'route add -net 대상 게이트웨이' 형식이며 gw 키워드가 없습니다. 확인은 netstat -rn 으로 합니다.",
      "syntax": ["route [-p] add [-net | -host] {{DESTINATION}} {{GATEWAY}}", "route [-p] add -net {{NETWORK}} -netmask {{NETMASK}} {{GATEWAY}}", "route [-p] delete {{DESTINATION}} {{GATEWAY}}", "route -p show"],
      "options": [
        {"flag": "-p", "desc": "영구 저장 (/etc/inet/static_routes)"},
        {"flag": "-net", "desc": "네트워크 경로 (예: 10.1.0.0/16)"},
        {"flag": "-host", "desc": "호스트 하나에 대한 경로"},
        {"flag": "-netmask {{NETMASK}}", "desc": "넷마스크 지정 (CIDR 표기 대신)"},
        {"flag": "-n", "desc": "이름 변환 없이 숫자로 출력"}
      ],
      "commandGroups": [
        {"title": "서브 명령", "type": "subcommand", "items": [
          {"cmd": "route -p add default {{GATEWAY}}", "desc": "기본 게이트웨이 추가 (영구)"},
          {"cmd": "route -p add -net {{NETWORK}}/{{PREFIX}} {{GATEWAY}}", "desc": "네트워크 경로 추가 (영구)"},
          {"cmd": "route -p delete -net {{NETWORK}}/{{PREFIX}} {{GATEWAY}}", "desc": "경로 삭제 (영구 설정에서도 삭제)"},
          {"cmd": "route -p show", "desc": "영구 저장된 경로 목록"},
          {"cmd": "route get {{IP}}", "desc": "특정 목적지로 갈 때 쓰이는 경로·인터페이스"},
          {"cmd": "route monitor", "desc": "라우팅 변경 이벤트 실시간 출력"}
        ]}
      ],
      "examples": [
        {"title": "대외 기관망 경로 영구 추가", "command": "route -p add -net {{NETWORK}}/{{PREFIX}} {{GATEWAY}}\nroute -p show\nnetstat -rn | grep {{NETWORK}}"},
        {"title": "목적지별 경로 확인", "command": "route get {{IP}}"},
        {"title": "기본 게이트웨이 교체", "command": "route -p delete default {{OLD_GW}}\nroute -p add default {{NEW_GW}}", "note": "원격 접속 중이면 delete 와 add 사이에 끊길 수 있으므로 콘솔에서 하거나 한 줄에 이어서 실행하세요."}
      ],
      "cautions": [
        "-p 없이 추가한 경로는 재부팅하면 사라집니다.",
        "Linux 식 'route add -net ... gw ...' 은 동작하지 않습니다 (gw 를 호스트명으로 해석)."
      ],
      "platformNotes": {"solaris": "Solaris 10(일부 초기 업데이트 제외)·11 에서 -p 지원. Solaris 10 의 기본 게이트웨이는 /etc/defaultrouter 로도 지정합니다."},
      "help": "man route",
      "keywords": ["라우팅", "정적 경로", "게이트웨이", "route -p", "static route", "route add"],
      "related": ["solaris-routeadm", "solaris-ipadm", "netstat", "route"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-routeadm",
      "name": "routeadm",
      "kind": "command",
      "shell": "sh",
      "category": "network",
      "task": "network.arp-route",
      "platforms": ["solaris"],
      "level": "basic",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "IP 포워딩·동적 라우팅 데몬 활성화 상태 관리",
