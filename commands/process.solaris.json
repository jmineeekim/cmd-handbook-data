          "items": [
            {
              "cmd": "::memstat",
              "desc": "메모리 사용 분류 (Kernel, ZFS File Data, Anon, Exec and libs, Page cache, Free)"
            },
            {
              "cmd": "::status",
              "desc": "덤프·커널 상태 요약 (패닉 메시지 포함)"
