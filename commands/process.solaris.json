        "solaris-ptree",
        "solaris-pwdx"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-ptree",
      "name": "ptree",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.list",
