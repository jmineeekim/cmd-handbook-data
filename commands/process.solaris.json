{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "process",
  "commands": [
    {
      "id": "solaris-prstat",
      "name": "prstat",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.monitor",
      "platforms": [
        "solaris"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "Solaris 실시간 프로세스 모니터링 (top 대체)",
      "description": "CPU·메모리 사용량 순으로 프로세스를 주기적으로 보여 주는 Solaris 기본 모니터링 도구입니다. -Z 로 Zone 별, -a 로 사용자별 합계를 보고, -mL 로 스레드(LWP)별 마이크로 상태(대기·잠금·CPU 시간 비율)를 분석할 수 있어 성능 장애 분석에 유용합니다.",
      "syntax": [
        "prstat [-a | -t | -Z | -J] [-s {{KEY}}] [-n {{N}}] [-p {{PID}}] [-u {{USER}}] [-mL] [-c] [{{INTERVAL}} [{{COUNT}}]]"
      ],
      "options": [
        {
          "flag": "-s cpu | rss | size | time | pri",
          "desc": "정렬 기준 (기본 cpu, 내림차순. -S 는 오름차순)"
        },
        {
          "flag": "-n {{N}}",
          "desc": "상위 N 개만 표시"
        },
        {
          "flag": "-a",
          "desc": "프로세스 목록 아래 사용자별 합계"
        },
        {
          "flag": "-t",
          "desc": "사용자별 합계만"
        },
        {
          "flag": "-Z",
          "desc": "Zone 별 합계 (글로벌 존에서 Zone 자원 사용 비교)"
        },
        {
          "flag": "-z {{ZONE}}",
          "desc": "특정 Zone 의 프로세스만"
        },
        {
          "flag": "-J",
          "desc": "프로젝트별 합계"
        },
        {
          "flag": "-p {{PID}}",
          "desc": "특정 프로세스만"
        },
        {
          "flag": "-u {{USER}}",
          "desc": "특정 사용자 프로세스만"
        },
        {
          "flag": "-L",
          "desc": "스레드(LWP)별로 표시"
        },
        {
          "flag": "-m",
          "desc": "마이크로 상태 회계 (USR, SYS, LCK, SLP, LAT 등 시간 비율)"
        },
        {
          "flag": "-c",
          "desc": "화면을 지우지 않고 이어서 출력 (로그 저장용)"
        },
        {
          "flag": "{{INTERVAL}} {{COUNT}}",
          "desc": "갱신 간격(초)과 횟수"
        }
      ],
      "examples": [
        {
          "title": "메모리(RSS) 많이 쓰는 상위 10개",
          "command": "prstat -s rss -n 10"
        },
        {
          "title": "Zone 별 CPU·메모리 사용량",
          "command": "prstat -Z 5"
        },
        {
          "title": "특정 프로세스의 스레드별 병목 분석",
          "command": "prstat -mL -p {{PID}} 5",
          "note": "LCK 가 높으면 잠금 경합, LAT 가 높으면 CPU 대기(부족)를 의심합니다."
        },
        {
          "title": "장애 시간대 기록을 파일로 남기기",
          "command": "prstat -c -n 20 10 30 > /var/tmp/prstat_$(date +%H%M).txt"
        }
      ],
      "cautions": [],
      "platformNotes": {
        "solaris": "Solaris 의 top 대체 도구 (top 은 기본 설치에 없을 수 있음). q 로 종료합니다."
      },
      "help": "man prstat",
      "keywords": [
        "프로세스 모니터링",
        "CPU 사용률",
        "메모리 사용량",
        "prstat",
        "top",
        "Zone 사용량"
      ],
      "related": [
        "top",
        "ps",
        "vmstat",
        "solaris-kstat",
        "solaris-pstack"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-truss",
      "name": "truss",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.trace",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "프로세스 시스템 콜·시그널 추적 (strace 대체)",
      "description": "프로세스가 호출하는 시스템 콜과 받는 시그널을 추적합니다. 프로그램이 어떤 파일을 열다 실패하는지, 어디서 멈춰 있는지(read 대기 등) 확인할 때 씁니다. 새 명령을 실행하며 추적하거나 -p 로 실행 중인 프로세스에 붙을 수 있습니다.",
      "syntax": [
        "truss [-f] [-d] [-o {{FILE}}] [-t {{SYSCALLS}}] {{COMMAND}} [{{ARGS}}]",
        "truss [-f] [-o {{FILE}}] -p {{PID}}",
        "truss -c -p {{PID}}"
      ],
      "options": [
        {
          "flag": "-p {{PID}}",
          "desc": "실행 중인 프로세스에 붙어서 추적 (Ctrl+C 로 분리)"
        },
        {
          "flag": "-f",
          "desc": "fork 로 생긴 자식 프로세스도 추적"
        },
        {
          "flag": "-o {{FILE}}",
          "desc": "출력을 파일로 저장"
        },
        {
          "flag": "-t {{SYSCALLS}}",
          "desc": "지정한 시스템 콜만 (예: -t open,read,write. !를 붙이면 제외)"
        },
        {
          "flag": "-d",
          "desc": "추적 시작 기준 경과 시간 표시"
        },
        {
          "flag": "-D",
          "desc": "직전 이벤트 대비 경과 시간 표시 (지연 구간 찾기)"
        },
        {
          "flag": "-c",
          "desc": "시스템 콜별 횟수·시간 요약만"
        },
        {
          "flag": "-a",
          "desc": "exec 시 인수 표시"
        },
        {
          "flag": "-e",
          "desc": "exec 시 환경 변수 표시"
        },
        {
          "flag": "-u {{LIB}}:{{FUNC}}",
          "desc": "사용자 라이브러리 함수 호출 추적"
        }
      ],
      "examples": [
        {
          "title": "프로그램이 여는 파일과 실패 확인",
          "command": "truss -f -t open,openat,stat -o /var/tmp/truss.out {{COMMAND}}\ngrep -i err /var/tmp/truss.out"
        },
        {
          "title": "멈춘 프로세스가 무엇을 기다리는지",
          "command": "truss -p {{PID}}",
          "note": "같은 시스템 콜(예: read, pollsys)에서 멈춰 있으면 그 대상(소켓·파일)을 pfiles 로 확인합니다."
        },
        {
          "title": "10초 동안 시스템 콜 통계",
          "command": "timeout 10 truss -c -p {{PID}}",
          "note": "timeout 이 없는 시스템은 Ctrl+C 로 중지하면 요약이 출력됩니다."
        }
      ],
      "cautions": [
        "추적 중 대상 프로세스가 크게 느려집니다. 운영 DB·WAS 프로세스는 짧게만 추적하세요.",
        "truss 를 강제 종료(kill -9)하면 대상 프로세스가 정지 상태로 남을 수 있습니다. Ctrl+C 로 끝내세요."
      ],
      "platformNotes": {
        "solaris": "Linux 의 strace 에 해당. 더 낮은 부하로 분석하려면 dtrace 를 씁니다."
      },
      "help": "man truss",
      "keywords": [
        "시스템 콜 추적",
        "truss",
        "strace",
        "프로세스 추적",
        "디버깅",
        "syscall"
      ],
      "related": [
        "solaris-dtrace",
        "solaris-pfiles",
        "solaris-pstack",
        "strace"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-pfiles",
      "name": "pfiles",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.open-files",
      "platforms": [
        "solaris"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "프로세스가 연 파일·소켓(포트) 목록 확인",
      "description": "프로세스가 열어 둔 파일 디스크립터(파일, 소켓, 파이프)를 보여 줍니다. 소켓은 로컬·원격 IP 와 포트가 함께 나오므로, Solaris 10 처럼 lsof 가 없는 환경에서 '이 포트를 어느 프로세스가 쓰는지' 찾는 기본 방법입니다.",
      "syntax": [
        "pfiles [-n] {{PID}}...",
        "pfiles {{CORE_FILE}}"
      ],
      "options": [
        {
          "flag": "-n",
          "desc": "파일 경로 등 상세 정보를 얻기 위한 추가 조회 생략 (대상 영향 최소화)"
        },
        {
          "flag": "-F",
          "desc": "다른 도구가 붙어 있어도 강제로 실행 (주의)"
        }
      ],
      "examples": [
        {
          "title": "프로세스가 연 파일·소켓",
          "command": "pfiles {{PID}}"
        },
        {
          "title": "특정 포트를 쓰는 프로세스 찾기",
          "command": "for p in $(ps -e -o pid=); do pfiles $p 2>/dev/null | grep -q \"port: {{PORT}}\" && echo \"PID $p: $(ps -o comm= -p $p)\"; done",
          "note": "모든 프로세스를 잠깐씩 멈추므로 운영 중에는 대상 사용자 프로세스로 범위를 좁히세요. Solaris 11.2 이상은 netstat -u 로도 확인할 수 있습니다."
        },
        {
          "title": "열린 파일 수 세기 (FD 고갈 점검)",
          "command": "pfiles {{PID}} | grep -c '^ *[0-9]*:'"
        }
      ],
      "cautions": [
        "pfiles 는 조회하는 동안 대상 프로세스를 잠시 정지시킵니다. 지연에 민감한 운영 프로세스에 반복 실행하지 마세요."
      ],
      "platformNotes": {
        "solaris": "Linux 의 lsof -p, ls -l /proc/PID/fd 에 해당. lsof 는 Solaris 기본 설치에 없습니다."
      },
      "help": "man proc (pfiles 는 proc 도구 모음)",
      "keywords": [
        "열린 파일",
        "포트 사용 프로세스",
        "소켓",
        "pfiles",
        "lsof",
        "파일 디스크립터"
      ],
      "related": [
        "lsof",
        "fuser",
        "netstat",
        "solaris-truss"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-pstack",
      "name": "pstack",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.dump",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "프로세스·코어 파일의 스레드별 호출 스택 출력",
      "description": "실행 중인 프로세스나 코어 파일의 스레드별 호출 스택을 출력합니다. 프로세스가 멈추거나(hang) CPU 를 계속 쓰는 원인을 찾을 때, 몇 초 간격으로 여러 번 떠서 같은 위치에 머무는지 비교합니다. Solaris 기본 proc 도구라 별도 설치가 필요 없습니다.",
      "syntax": [
        "pstack {{PID}}[/{{LWP}}]...",
        "pstack {{CORE_FILE}}"
      ],
      "options": [
        {
          "flag": "-F",
          "desc": "다른 도구가 붙어 있어도 강제로 실행 (주의)"
        }
      ],
      "examples": [
        {
          "title": "프로세스 스택 확인",
          "command": "pstack {{PID}}"
        },
        {
          "title": "5초 간격 3회 수집 (행 분석·벤더 전달용)",
          "command": "for i in 1 2 3; do date; pstack {{PID}}; sleep 5; done > /var/tmp/pstack_{{PID}}.txt"
        },
        {
          "title": "코어 파일 스택",
          "command": "pstack /var/cores/{{CORE_FILE}}"
        }
      ],
      "cautions": [
        "수집하는 동안 대상 프로세스가 잠깐 정지됩니다.",
        "Java 프로세스는 네이티브 스택만 보이므로 jstack(또는 kill -3)으로 스레드 덤프를 함께 받으세요."
      ],
      "help": "man proc",
      "keywords": [
        "스택 트레이스",
        "행 분석",
        "pstack",
        "스레드 덤프",
        "hang",
        "core"
      ],
      "related": [
        "solaris-mdb",
        "solaris-coreadm",
        "solaris-prstat",
        "pstack",
        "gcore"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-pargs",
      "name": "pargs",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.list",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "프로세스의 전체 실행 인수·환경 변수 출력",
      "description": "프로세스가 실행될 때의 전체 인수와 환경 변수를 출력합니다. Solaris 의 ps 는 인수를 80자에서 자르므로, 긴 Java 옵션이나 경로 전체를 확인할 때 pargs 를 씁니다.",
      "syntax": [
        "pargs [-l] [-e] [-a] {{PID}}"
      ],
      "options": [
        {
          "flag": "-a",
          "desc": "인수 출력 (기본)"
        },
        {
          "flag": "-e",
          "desc": "환경 변수 출력"
        },
        {
          "flag": "-l",
          "desc": "인수를 한 줄 명령 형태로 출력"
        }
      ],
      "examples": [
        {
          "title": "Java 프로세스 전체 옵션 확인",
          "command": "pargs -l {{PID}}"
        },
        {
          "title": "프로세스 환경 변수 확인",
          "command": "pargs -e {{PID}} | grep -i -e LANG -e PATH"
        }
      ],
      "cautions": [],
      "platformNotes": {
        "solaris": "Linux 의 cat /proc/PID/cmdline, ps -ww 에 해당. Solaris 11 은 /usr/bin/ps -ww 도 사용 가능합니다."
      },
      "help": "man proc",
      "keywords": [
        "프로세스 인수",
        "실행 옵션",
        "환경 변수",
        "pargs",
        "cmdline"
      ],
      "related": [
