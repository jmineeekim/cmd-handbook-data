    {
      "id": "solaris-dtrace",
      "name": "dtrace",
      "kind": "command",
      "shell": "sh",
      "category": "process",
      "task": "process.trace",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "커널·프로세스 동적 추적 (원라이너로 원인 분석)",
      "description": "운영 중인 시스템에 낮은 부하로 추적 지점(probe)을 걸어 시스템 콜, 프로세스 생성, I/O 등을 집계합니다. 복잡한 스크립트를 쓰지 않아도 잘 알려진 한 줄 명령으로 '누가 시스템 콜을 많이 하는지', '누가 디스크 I/O 를 일으키는지'를 바로 확인할 수 있습니다. Ctrl+C 로 멈추면 집계 결과가 출력됩니다.",
      "syntax": [
        "dtrace -n '{{PROBE}} { {{ACTION}} }'",
        "dtrace -l [-n {{PROBE}}]",
        "dtrace -s {{SCRIPT}}.d"
      ],
      "options": [
        {
          "flag": "-n '{{PROBE}} { ... }'",
          "desc": "프로브와 동작을 명령줄에서 지정"
        },
        {
          "flag": "-l",
          "desc": "사용 가능한 프로브 목록"
        },
        {
          "flag": "-s {{SCRIPT}}",
          "desc": "D 스크립트 파일 실행"
        },
        {
          "flag": "-p {{PID}}",
          "desc": "특정 프로세스를 대상으로 ($target 사용)"
        },
        {
          "flag": "-q",
          "desc": "프로브 일치 메시지 생략 (printf 결과만)"
        },
        {
          "flag": "-o {{FILE}}",
          "desc": "결과를 파일로 저장"
        }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 원라이너 (Ctrl+C 로 종료하면 결과 출력)",
          "type": "subcommand",
          "items": [
            {
              "cmd": "dtrace -n 'syscall:::entry { @[execname] = count(); }'",
              "desc": "프로세스 이름별 시스템 콜 횟수"
            },
            {
              "cmd": "dtrace -n 'syscall:::entry /pid == {{PID}}/ { @[probefunc] = count(); }'",
              "desc": "특정 프로세스의 시스템 콜 종류별 횟수"
            },
            {
              "cmd": "dtrace -n 'proc:::exec-success { trace(curpsinfo->pr_psargs); }'",
              "desc": "새로 실행되는 명령 실시간 출력 (짧게 실행되고 사라지는 프로세스 찾기)"
            },
            {
              "cmd": "dtrace -n 'io:::start { @[execname] = sum(args[0]->b_bcount); }'",
              "desc": "프로세스별 디스크 I/O 바이트"
            },
            {
              "cmd": "dtrace -n 'profile-997 /arg1/ { @[execname] = count(); }'",
              "desc": "사용자 모드 CPU 를 쓰는 프로세스 샘플링"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "시스템 콜을 가장 많이 하는 프로세스",
          "command": "dtrace -n 'syscall:::entry { @[execname] = count(); }'"
        },
        {
          "title": "10초만 집계하고 자동 종료",
          "command": "dtrace -n 'syscall:::entry { @[execname] = count(); } tick-10s { exit(0); }'"
        },
        {
          "title": "새로 실행되는 명령 감시",
          "command": "dtrace -qn 'proc:::exec-success { printf(\"%d %s\\n\", pid, curpsinfo->pr_psargs); }'"
        }
      ],
      "cautions": [
        "부하가 낮은 편이지만 모든 시스템 콜·함수에 프로브를 거는 등 범위가 넓으면 운영 성능에 영향을 줍니다. 처음에는 짧게(tick-10s) 실행하세요.",
        "검증되지 않은 인터넷 스크립트, 특히 destructive 동작(-w 옵션)을 쓰는 스크립트는 운영 서버에서 실행하지 마세요.",
        "non-global zone 에서는 zonecfg 의 limitpriv 에 dtrace 권한이 있어야 하며 볼 수 있는 범위가 제한됩니다."
      ],
      "platformNotes": {
        "solaris": "Solaris 10 이상 기본 포함. Linux 의 bpftrace/perf, strace 를 넘어서는 분석 도구."
      },
      "help": "man dtrace · Oracle Solaris Dynamic Tracing Guide",
      "keywords": [
