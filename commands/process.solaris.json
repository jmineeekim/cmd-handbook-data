        "echo '{{DCMD}}' | mdb -k",
        "mdb {{N}}",
        "mdb {{PROGRAM}} {{CORE_FILE}}"
      ],
      "options": [
        {
          "flag": "-k",
          "desc": "실행 중인 커널을 읽기 전용으로 조사"
        },
        {
          "flag": "-w",
          "desc": "쓰기 모드 (운영자는 사용 금지)"
        }
      ],
      "commandGroups": [
