            {
              "cmd": "::msgbuf",
              "desc": "커널 메시지 버퍼 (패닉 직전 메시지)"
            },
            {
              "cmd": "::panicinfo",
              "desc": "패닉 시점 CPU·스레드·레지스터 정보 (크래시 덤프)"
