    {
      "id": "aix-sysdumpdev",
      "name": "sysdumpdev",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.hw-errors",
      "platforms": [
        "aix"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "시스템 덤프 장치 설정·최근 덤프 정보 확인",
      "description": "커널 장애(시스템 크래시) 시 메모리 덤프를 저장할 장치를 설정하고, 마지막 덤프 정보를 확인합니다. 덤프 장치 크기가 부족하면 장애 원인 분석용 덤프가 잘리므로 -e 추정치와 덤프 LV 크기를 주기적으로 비교해야 합니다.",
      "syntax": [
        "sysdumpdev -l",
        "sysdumpdev -L",
        "sysdumpdev -e",
        "sysdumpdev -P -p {{DUMP_DEVICE}}"
      ],
      "options": [
        {
          "flag": "-l",
          "desc": "현재 1차·2차 덤프 장치와 복사 디렉토리 설정 표시"
        },
        {
          "flag": "-L",
          "desc": "가장 최근 덤프의 시각·크기·상태"
        },
        {
          "flag": "-e",
          "desc": "현재 시스템 상태 기준 필요한 덤프 크기 추정"
        },
        {
          "flag": "-p {{DUMP_DEVICE}}",
          "desc": "1차(primary) 덤프 장치 지정 (예: /dev/lg_dumplv)"
        },
        {
          "flag": "-s {{DUMP_DEVICE}}",
          "desc": "2차(secondary) 덤프 장치 지정"
        },
        {
          "flag": "-P",
          "desc": "변경을 영구 적용 (재부팅 후에도 유지)"
        }
      ],
      "examples": [
        {
          "title": "덤프 장치 크기 점검",
          "steps": [
            {
              "prompt": "#",
              "cmd": "sysdumpdev -l",
              "desc": "1차 덤프 장치(LV) 이름 확인"
            },
            {
              "prompt": "#",
              "cmd": "sysdumpdev -e",
              "desc": "필요한 덤프 크기 추정치 확인"
            },
            {
