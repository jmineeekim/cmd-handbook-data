{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "service",
  "commands": [
    {
      "id": "aix-lssrc",
      "name": "lssrc",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SRC 서비스(서브시스템) 상태 확인",
      "description": "AIX 의 SRC(System Resource Controller)에 등록된 서비스의 상태를 보여 줍니다. sshd, syslogd, xntpd, inetd, nfsd 같은 데몬은 SRC 로 관리하며 active / inoperative 로 상태가 나옵니다. -g 로 tcpip·nfs 같은 그룹 단위로 볼 수 있습니다.",
      "syntax": [
        "lssrc -a",
        "lssrc -s {{SUBSYSTEM}}",
        "lssrc -g {{GROUP}}",
        "lssrc -ls {{SUBSYSTEM}}"
      ],
      "options": [
        {
          "flag": "-a",
          "desc": "등록된 모든 서브시스템 상태"
        },
        {
          "flag": "-s {{SUBSYSTEM}}",
          "desc": "특정 서브시스템 (sshd, syslogd, xntpd ...)"
        },
        {
          "flag": "-g {{GROUP}}",
          "desc": "그룹 단위 (tcpip, nfs, spooler ...)"
        },
        {
          "flag": "-l",
          "desc": "서브시스템이 지원하면 상세 상태 표시 (예: xntpd 동기화 상태)"
        },
        {
          "flag": "-S",
          "desc": "서브시스템 정의 정보 (실행 파일 경로·인자 등)"
        }
      ],
      "examples": [
        {
          "title": "SSH·syslog 상태 확인",
          "command": "lssrc -s sshd\nlssrc -s syslogd"
        },
        {
          "title": "TCP/IP 그룹 데몬 전체 상태",
          "command": "lssrc -g tcpip"
        },
        {
          "title": "NTP(xntpd) 동기화 상태",
          "command": "lssrc -ls xntpd",
          "note": "Sys peer 항목에 동기화 대상 서버가 보이면 정상입니다. no peer 가 계속되면 /etc/ntp.conf 와 방화벽을 확인합니다."
        },
        {
          "title": "멈춰 있는(inoperative) 서비스만 보기",
          "command": "lssrc -a | grep inoperative"
        }
      ],
      "cautions": [],
      "help": "man lssrc",
      "keywords": [
        "서비스 상태",
        "SRC",
        "lssrc",
        "데몬 상태",
        "active",
        "inoperative",
        "xntpd"
      ],
      "related": [
        "aix-startsrc",
        "aix-stopsrc",
        "aix-refresh",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-startsrc",
      "name": "startsrc",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SRC 서비스(서브시스템·그룹) 시작",
      "description": "SRC 에 등록된 서브시스템이나 그룹을 시작합니다. 데몬을 직접 실행하지 않고 startsrc 로 올려야 lssrc·stopsrc·refresh 로 관리할 수 있습니다. -a 로 데몬 실행 인자를 넘길 수 있습니다.",
      "syntax": [
        "startsrc -s {{SUBSYSTEM}} [-a \"{{ARGS}}\"]",
        "startsrc -g {{GROUP}}"
      ],
      "options": [
        {
          "flag": "-s {{SUBSYSTEM}}",
          "desc": "시작할 서브시스템"
        },
        {
          "flag": "-g {{GROUP}}",
          "desc": "그룹 전체 시작 (예: nfs)"
        },
        {
          "flag": "-a \"{{ARGS}}\"",
          "desc": "데몬에 넘길 인자"
        },
        {
          "flag": "-e \"{{ENV}}\"",
          "desc": "데몬에 넘길 환경 변수"
        }
      ],
      "examples": [
        {
          "title": "SRC 로 서비스 재시작",
          "steps": [
            {
              "prompt": "#",
              "cmd": "lssrc -s {{SUBSYSTEM}}",
              "desc": "현재 상태·PID 확인"
            },
            {
              "prompt": "#",
              "cmd": "stopsrc -s {{SUBSYSTEM}}",
              "desc": "정상 종료 요청"
            },
            {
              "prompt": "#",
              "cmd": "lssrc -s {{SUBSYSTEM}}",
              "desc": "inoperative 가 될 때까지 확인"
            },
            {
              "prompt": "#",
              "cmd": "startsrc -s {{SUBSYSTEM}}",
              "desc": "다시 시작"
            },
            {
              "prompt": "#",
              "cmd": "lssrc -s {{SUBSYSTEM}}",
              "desc": "active 와 새 PID 확인"
            }
          ]
        },
        {
          "title": "NFS 서버 데몬 그룹 시작",
          "command": "startsrc -g nfs"
        },
        {
          "title": "패킷 추적(iptrace)을 SRC 로 시작",
          "command": "startsrc -s iptrace -a \"-i en0 -p {{PORT}} /tmp/iptrace.bin\""
        }
      ],
      "cautions": [
        "startsrc 는 이번 기동만 처리합니다. 부팅 시 자동 시작은 /etc/rc.tcpip(TCP/IP 데몬), /etc/inittab, /etc/rc.nfs 등 시작 스크립트에 등록되어 있어야 합니다."
      ],
      "help": "man startsrc",
      "keywords": [
        "서비스 시작",
        "startsrc",
        "SRC",
        "데몬 시작",
        "서비스 재시작"
      ],
      "related": [
        "aix-lssrc",
        "aix-stopsrc",
        "aix-refresh",
        "aix-etc-inittab",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-stopsrc",
      "name": "stopsrc",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SRC 서비스(서브시스템·그룹) 중지",
      "description": "SRC 로 관리되는 서브시스템이나 그룹을 중지합니다. 기본은 정상 종료(normal stop)이며, 응답하지 않으면 -f 로 강제 종료합니다.",
      "syntax": [
        "stopsrc -s {{SUBSYSTEM}} [-f]",
        "stopsrc -g {{GROUP}}"
      ],
      "options": [
        {
          "flag": "-s {{SUBSYSTEM}}",
          "desc": "중지할 서브시스템"
        },
        {
          "flag": "-g {{GROUP}}",
          "desc": "그룹 전체 중지"
        },
        {
          "flag": "-f",
          "desc": "강제 종료 (정리 작업 없이 즉시)"
        },
        {
          "flag": "-a",
          "desc": "모든 서브시스템 중지 (종료 절차용, 운영 중 사용 금지)"
        }
      ],
      "examples": [
        {
          "title": "sendmail 중지",
          "command": "stopsrc -s sendmail"
        },
        {
          "title": "SRC 로 돌린 iptrace 종료 (추적 파일 기록 완료)",
          "command": "stopsrc -s iptrace"
        }
      ],
      "cautions": [
        "원격 접속 중 stopsrc -s sshd 를 하면 새 SSH 접속이 막힙니다. 기존 세션은 유지되지만 콘솔 접속 수단을 확보한 뒤 수행하세요.",
        "stopsrc -a 는 SRC 의 모든 서비스를 내립니다. 운영 중에는 쓰지 마세요."
      ],
      "help": "man stopsrc",
      "keywords": [
        "서비스 중지",
        "stopsrc",
        "SRC",
        "데몬 종료"
      ],
      "related": [
        "aix-startsrc",
        "aix-lssrc",
        "aix-refresh"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-refresh",
      "name": "refresh",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SRC 서비스에 설정 다시 읽기 요청",
      "description": "SRC 서브시스템에 설정 파일을 다시 읽으라는 신호를 보냅니다. /etc/syslog.conf, /etc/inetd.conf 등을 고친 뒤 서비스를 끊지 않고 반영할 때 씁니다. refresh 를 지원하지 않는 서브시스템은 stopsrc/startsrc 로 재시작해야 합니다.",
      "syntax": [
        "refresh -s {{SUBSYSTEM}}",
        "refresh -g {{GROUP}}"
      ],
      "options": [
        {
          "flag": "-s {{SUBSYSTEM}}",
          "desc": "대상 서브시스템"
        },
        {
          "flag": "-g {{GROUP}}",
          "desc": "대상 그룹"
        }
      ],
      "examples": [
        {
          "title": "syslog 설정 변경 반영",
          "command": "cp -p /etc/syslog.conf /etc/syslog.conf.bak\nvi /etc/syslog.conf\nrefresh -s syslogd"
        },
        {
          "title": "inetd 설정(telnet·ftp 비활성화 등) 반영",
          "command": "refresh -s inetd"
        }
      ],
      "cautions": [
        "refresh 를 지원하지 않으면 오류 메시지가 나옵니다. 이때는 stopsrc/startsrc 로 재시작하세요.",
        "/etc/syslog.conf 에 지정한 로그 파일은 미리 만들어 두어야(touch) 기록됩니다."
      ],
      "help": "man refresh",
      "keywords": [
        "설정 반영",
        "refresh",
        "SRC",
        "reload",
        "syslogd",
        "inetd"
      ],
      "related": [
        "aix-lssrc",
        "aix-startsrc",
        "aix-stopsrc"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-errpt",
      "name": "errpt",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.hw-errors",
      "platforms": [
        "aix"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "AIX 에러 로그(하드웨어·소프트웨어 장애) 조회",
      "description": "AIX 에러 로그(/var/adm/ras/errlog)를 보여 줍니다. 디스크·FC·NIC·메모리 같은 하드웨어 장애와 커널·소프트웨어 오류가 기록되므로 AIX 장애 점검의 출발점입니다. 요약 목록에서 IDENTIFIER 를 확인한 뒤 errpt -aj 로 상세 내용을 봅니다.",
      "syntax": [
        "errpt [-d {{CLASS}}] [-T {{TYPE}}] [-N {{RESOURCE}}] [-s {{MMDDHHMMYY}}]",
        "errpt -a [-j {{IDENTIFIER}}]"
      ],
      "options": [
        {
          "flag": "-a",
          "desc": "상세 보고서 형식 (설명, 원인, 권장 조치, 상세 데이터)"
        },
        {
          "flag": "-j {{IDENTIFIER}}",
          "desc": "특정 IDENTIFIER 만 (쉼표로 여러 개)"
        },
        {
          "flag": "-k {{IDENTIFIER}}",
          "desc": "특정 IDENTIFIER 제외"
        },
        {
          "flag": "-J {{LABEL}}",
          "desc": "에러 레이블로 필터 (예: OPMSG)"
        },
        {
          "flag": "-d {{CLASS}}",
          "desc": "클래스로 필터 (H, S, O, U)"
        },
        {
          "flag": "-T {{TYPE}}",
          "desc": "유형으로 필터 (PERM, TEMP, PERF, PEND, INFO, UNKN)"
        },
        {
          "flag": "-N {{RESOURCE}}",
          "desc": "리소스 이름으로 필터 (hdisk2, fcs0 등)"
        },
        {
          "flag": "-s {{MMDDHHMMYY}}",
          "desc": "이 시각 이후 기록만"
        },
        {
          "flag": "-e {{MMDDHHMMYY}}",
          "desc": "이 시각 이전 기록만"
        },
        {
          "flag": "-c",
          "desc": "새 에러를 실시간으로 계속 표시 (concurrent)"
        }
      ],
      "commandGroups": [
        {
          "title": "요약 출력 열",
          "type": "directive",
          "note": "errpt 기본 출력의 각 열 의미입니다.",
          "items": [
            {
              "cmd": "IDENTIFIER",
              "desc": "에러 종류별 8자리 16진수 ID (errpt -aj 로 상세 조회)"
            },
            {
              "cmd": "TIMESTAMP",
              "desc": "발생 시각 MMDDhhmmYY (예: 0315143025 = 3월 15일 14:30, 2025년)"
            },
            {
              "cmd": "T",
              "desc": "유형 (P=PERM, T=TEMP, I=INFO 등)"
            },
            {
              "cmd": "C",
              "desc": "클래스 (H, S, O, U)"
            },
            {
              "cmd": "RESOURCE_NAME",
              "desc": "에러가 난 장치·구성요소 (hdisk2, fscsi0, SYSPROC 등)"
            },
            {
              "cmd": "DESCRIPTION",
              "desc": "에러 요약 설명"
            }
          ]
        },
        {
          "title": "에러 유형(-T)",
          "type": "directive",
          "items": [
            {
              "cmd": "PERM",
              "desc": "영구 장애. 재시도로 복구되지 않음 → 즉시 조치 대상"
            },
            {
              "cmd": "TEMP",
              "desc": "일시 장애. 재시도로 복구됨. 반복되면 장애 전조"
            },
            {
              "cmd": "PERF",
              "desc": "성능 저하"
            },
            {
              "cmd": "PEND",
              "desc": "곧 장애가 날 가능성 (예: 장치 소실 임박)"
            },
            {
              "cmd": "INFO",
              "desc": "정보성 기록"
            },
            {
              "cmd": "UNKN",
              "desc": "판단 불가"
            }
          ]
        },
        {
          "title": "에러 클래스(-d)",
          "type": "directive",
          "items": [
            {
              "cmd": "H",
              "desc": "하드웨어 (디스크, 어댑터, 메모리, CPU)"
            },
            {
              "cmd": "S",
              "desc": "소프트웨어 (커널, 애플리케이션, 덤프)"
            },
            {
              "cmd": "O",
              "desc": "운영자 메시지 (errlogger 로 기록한 것)"
            },
            {
              "cmd": "U",
              "desc": "판단 불가"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "장애 점검: 최근 에러 확인 후 상세 보기",
          "steps": [
            {
              "prompt": "#",
              "cmd": "errpt | head -20",
              "desc": "최근 에러 요약 (최신이 위)"
            },
            {
              "prompt": "#",
              "cmd": "errpt -d H -T PERM",
              "desc": "하드웨어 영구 장애만 추리기"
            },
            {
              "prompt": "#",
              "cmd": "errpt -aj {{IDENTIFIER}} | more",
              "desc": "해당 ID 의 상세 (PROBABLE CAUSES, RECOMMENDED ACTIONS)"
            },
            {
              "prompt": "#",
              "cmd": "errpt -a -N {{RESOURCE}} > /tmp/errpt_{{RESOURCE}}.txt",
              "desc": "장치별 상세를 파일로 저장해 벤더에 전달"
            }
          ]
        },
        {
          "title": "특정 시각 이후 에러만",
          "command": "errpt -s {{MMDDHHMMYY}}"
        },
        {
          "title": "새 에러를 실시간으로 지켜보기",
          "command": "errpt -c"
        }
      ],
      "cautions": [
        "에러 로그는 크기가 차면 오래된 항목부터 덮어씁니다. 장애 발생 시 errpt -a 결과를 먼저 파일로 저장하세요.",
        "같은 TEMP 에러가 반복되는 것은 경로·디스크 장애의 전조일 수 있으므로 무시하지 마세요."
      ],
      "help": "man errpt",
      "keywords": [
        "에러 로그",
        "errpt",
        "하드웨어 장애",
        "장애 로그",
        "IDENTIFIER",
        "PERM",
        "TEMP",
        "errlog"
      ],
      "related": [
        "aix-errclear",
        "aix-errlogger",
        "aix-snap",
        "aix-alog",
        "dmesg",
        "journalctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-errclear",
      "name": "errclear",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.hw-errors",
      "platforms": [
        "aix"
      ],
      "level": "frequent",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "에러 로그 항목 삭제",
      "description": "지정한 일수보다 오래된 에러 로그 항목을 지웁니다. 0 을 주면 조건에 맞는 모든 항목을 지웁니다. -j, -d, -N 등으로 특정 에러만 지울 수 있어 조치 완료된 에러를 정리할 때 씁니다.",
      "syntax": [
        "errclear [-j {{IDENTIFIER}}] [-d {{CLASS}}] [-N {{RESOURCE}}] {{DAYS}}"
      ],
      "options": [
        {
          "flag": "-j {{IDENTIFIER}}",
          "desc": "특정 IDENTIFIER 만 삭제"
        },
        {
          "flag": "-J {{LABEL}}",
          "desc": "특정 레이블만 삭제"
        },
        {
          "flag": "-d {{CLASS}}",
          "desc": "특정 클래스만 삭제"
        },
        {
          "flag": "-N {{RESOURCE}}",
          "desc": "특정 리소스만 삭제"
        },
        {
          "flag": "-T {{TYPE}}",
          "desc": "특정 유형만 삭제"
        }
      ],
      "examples": [
        {
          "title": "조치 완료된 장치 에러 정리 (백업 후)",
          "command": "errpt -a -N {{RESOURCE}} > /tmp/errpt_{{RESOURCE}}_$(date +%Y%m%d).txt\nerrclear -N {{RESOURCE}} 0"
        },
        {
          "title": "30일보다 오래된 항목 삭제",
          "command": "errclear 30"
        }
      ],
      "cautions": [
