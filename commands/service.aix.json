      "id": "aix-etc-inittab",
      "name": "/etc/inittab",
      "kind": "file",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "부팅 시 init 이 실행할 항목 (자동 시작 설정)",
      "description": "AIX 부팅 시 init 프로세스가 읽어 실행하는 항목 목록입니다. srcmstr, rc.tcpip, rc.nfs, cron 등 기본 서비스와 애플리케이션 자동 시작 스크립트가 여기 등록됩니다. 직접 편집보다 mkitab·chitab·rmitab·lsitab 명령 사용이 권장됩니다.",
      "syntax": [
        "{{IDENTIFIER}}:{{RUNLEVEL}}:{{ACTION}}:{{COMMAND}}"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "줄 형식 (콜론 구분 4개 필드)",
          "type": "directive",
          "items": [
            {
              "cmd": "{{IDENTIFIER}}",
              "desc": "항목 이름 (최대 14자, 파일 안에서 유일)"
            },
            {
              "cmd": "{{RUNLEVEL}}",
              "desc": "실행할 런레벨. AIX 기본 런레벨은 2 (예: 2, 23456789)"
            },
            {
              "cmd": "{{ACTION}}",
              "desc": "실행 방식 (아래 표)"
            },
            {
              "cmd": "{{COMMAND}}",
              "desc": "실행할 명령. 출력은 보통 >/dev/console 2>&1 로 돌림"
            }
          ]
        },
        {
          "title": "action 값",
          "type": "directive",
          "items": [
            {
              "cmd": "once",
              "desc": "런레벨 진입 시 한 번 실행하고 끝날 때까지 기다리지 않음"
            },
            {
              "cmd": "wait",
              "desc": "한 번 실행하고 끝날 때까지 기다림 (다음 항목은 그 뒤 실행)"
            },
            {
              "cmd": "respawn",
              "desc": "프로세스가 죽으면 다시 실행 (srcmstr 등)"
            },
            {
              "cmd": "boot",
              "desc": "부팅 시에만 실행, 기다리지 않음"
            },
            {
              "cmd": "bootwait",
              "desc": "부팅 시에만 실행, 끝날 때까지 기다림"
            },
            {
              "cmd": "sysinit",
              "desc": "콘솔 접근 전 가장 먼저 실행"
            },
            {
              "cmd": "off",
              "desc": "실행하지 않음 (실행 중이면 종료)"
            },
            {
              "cmd": "initdefault",
              "desc": "기본 런레벨 지정 (init:2:initdefault:)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "애플리케이션 자동 시작 항목 예시",
          "command": "{{APP}}:2:once:/etc/rc.{{APP}} >/dev/console 2>&1",
          "note": "등록은 mkitab 으로 합니다. 의존 서비스(NFS, DB) 보다 뒤에 오도록 mkitab -i 로 위치를 지정할 수 있습니다."
        },
        {
          "title": "변경 전 백업과 현재 항목 확인",
          "command": "cp -p /etc/inittab /etc/inittab.$(date +%Y%m%d)\nlsitab -a"
        }
      ],
      "cautions": [
        "형식이 잘못되거나 wait 항목이 끝나지 않으면 부팅이 멈출 수 있습니다. 편집 전 백업하고, 등록한 스크립트는 수동으로 먼저 테스트하세요.",
        "직접 vi 로 고친 뒤에는 init q 로 다시 읽게 해야 respawn 등의 변경이 반영됩니다."
      ],
      "help": "man inittab",
      "keywords": [
        "자동 시작",
        "inittab",
        "부팅 스크립트",
        "init",
        "런레벨",
        "respawn"
      ],
      "related": [
        "aix-mkitab",
        "aix-startsrc",
        "aix-lssrc",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-mkitab",
      "name": "mkitab",
      "aliases": [
        "lsitab",
        "chitab",
        "rmitab"
      ],
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "aix"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "/etc/inittab 항목 추가·조회·변경·삭제",
      "description": "/etc/inittab 을 안전하게 편집하는 명령 묶음입니다. mkitab 은 추가, lsitab 은 조회, chitab 은 변경, rmitab 은 삭제입니다. 형식 검사를 해 주므로 vi 로 직접 고치는 것보다 안전합니다.",
      "syntax": [
        "mkitab [-i {{AFTER_ID}}] \"{{IDENTIFIER}}:{{RUNLEVEL}}:{{ACTION}}:{{COMMAND}}\"",
        "lsitab -a | lsitab {{IDENTIFIER}}",
        "chitab \"{{IDENTIFIER}}:{{RUNLEVEL}}:{{ACTION}}:{{COMMAND}}\"",
        "rmitab {{IDENTIFIER}}"
      ],
      "options": [
        {
          "flag": "-i {{AFTER_ID}}",
          "desc": "mkitab: 지정한 항목 바로 다음에 추가 (생략하면 파일 끝)"
        },
        {
          "flag": "-a",
          "desc": "lsitab: 모든 항목 표시"
        }
      ],
      "commandGroups": [
        {
          "title": "명령별 용도",
          "type": "subcommand",
          "items": [
            {
              "cmd": "lsitab -a",
              "desc": "전체 항목 보기"
            },
            {
              "cmd": "lsitab {{IDENTIFIER}}",
              "desc": "특정 항목 보기 (없으면 아무것도 출력 안 함)"
            },
            {
              "cmd": "mkitab \"{{IDENTIFIER}}:2:once:{{COMMAND}}\"",
              "desc": "항목 추가"
            },
            {
              "cmd": "chitab \"{{IDENTIFIER}}:2:off:{{COMMAND}}\"",
              "desc": "같은 IDENTIFIER 항목을 새 내용으로 바꿈 (예: 임시로 off)"
            },
            {
              "cmd": "rmitab {{IDENTIFIER}}",
              "desc": "항목 삭제"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "애플리케이션 자동 시작 등록",
          "steps": [
            {
              "prompt": "#",
              "cmd": "cp -p /etc/inittab /etc/inittab.$(date +%Y%m%d)",
              "desc": "백업"
            },
            {
              "prompt": "#",
              "cmd": "/etc/rc.{{APP}}",
              "desc": "시작 스크립트를 수동으로 실행해 정상 동작 확인"
            },
            {
              "prompt": "#",
              "cmd": "mkitab -i rcnfs \"{{APP}}:2:once:/etc/rc.{{APP}} >/dev/console 2>&1\"",
              "desc": "NFS 시작(rcnfs) 다음에 등록"
            },
            {
              "prompt": "#",
              "cmd": "lsitab {{APP}}",
              "desc": "등록 확인"
            }
          ]
        },
        {
          "title": "자동 시작 해제",
          "command": "rmitab {{APP}}"
        }
      ],
      "cautions": [
        "rmitab 으로 시스템 기본 항목(srcmstr, rctcpip, cron 등)을 지우면 부팅 후 서비스가 올라오지 않습니다.",
        "-i 로 지정한 IDENTIFIER 가 없으면 실패합니다. lsitab -a 로 먼저 확인하세요."
      ],
      "help": "man mkitab · man lsitab · man chitab · man rmitab",
      "keywords": [
        "inittab 편집",
        "mkitab",
        "lsitab",
        "chitab",
        "rmitab",
        "자동 시작 등록"
      ],
      "related": [
        "aix-etc-inittab",
        "aix-startsrc"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "aix-audit",
      "name": "audit",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.audit",
      "platforms": [
        "aix"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "AIX 보안 감사(audit) 시작·중지·상태 확인",
      "description": "AIX 보안 감사 서브시스템을 제어합니다. /etc/security/audit/config 에 정의한 사용자·이벤트·객체 감사 설정에 따라 기록하며, bin 모드는 /audit/trail 에, stream 모드는 streamcmds 설정에 따라 기록합니다. 기록은 auditpr 로 읽습니다.",
      "syntax": [
        "audit start | shutdown | off | on | query"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "서브 명령",
          "type": "subcommand",
          "items": [
            {
              "cmd": "audit query",
              "desc": "감사 상태와 현재 적용된 이벤트·객체 설정 확인"
            },
            {
              "cmd": "audit start",
              "desc": "config 파일을 읽어 감사 시작"
            },
            {
              "cmd": "audit shutdown",
              "desc": "버퍼를 기록하고 감사 종료 (설정 변경 후 재시작 전에 사용)"
            },
            {
              "cmd": "audit off",
              "desc": "일시 중지 (설정은 유지)"
            },
            {
              "cmd": "audit on",
              "desc": "일시 중지 해제"
            }
          ]
        },
        {
          "title": "관련 설정 파일 (/etc/security/audit/)",
          "type": "directive",
          "items": [
            {
              "cmd": "config",
              "desc": "모드(binmode/streammode), 감사할 클래스, 사용자별 클래스 지정"
            },
            {
              "cmd": "events",
              "desc": "감사 이벤트별 출력 형식"
            },
            {
              "cmd": "objects",
              "desc": "파일 접근 감사 대상 (예: /etc/security/passwd 읽기·쓰기)"
            },
            {
              "cmd": "bincmds",
              "desc": "bin 모드에서 bin 파일이 찼을 때 실행할 명령 (보통 auditcat 으로 /audit/trail 에 누적)"
            },
            {
              "cmd": "streamcmds",
              "desc": "stream 모드에서 실행할 명령 (auditstream | auditpr 등)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "감사 설정 변경 후 재시작",
          "steps": [
            {
              "prompt": "#",
              "cmd": "cp -p /etc/security/audit/config /etc/security/audit/config.bak",
              "desc": "설정 백업"
            },
            {
              "prompt": "#",
              "cmd": "vi /etc/security/audit/config",
              "desc": "감사 클래스·사용자 설정 수정"
            },
            {
              "prompt": "#",
              "cmd": "audit shutdown",
              "desc": "현재 감사 종료"
            },
            {
              "prompt": "#",
              "cmd": "audit start",
              "desc": "새 설정으로 시작"
            },
            {
              "prompt": "#",
              "cmd": "audit query",
              "desc": "적용 상태 확인"
            }
          ]
        },
        {
          "title": "감사 기록 읽기",
          "command": "auditpr -v < /audit/trail | more"
        }
      ],
      "cautions": [
        "감사 이벤트를 너무 많이 켜면 /audit 파일시스템이 빨리 차고 성능에 영향을 줍니다. 별도 파일시스템과 보관·순환 정책을 두세요.",
        "부팅 시 자동 시작하려면 /etc/rc 등 시작 스크립트에 audit start 가 등록되어 있어야 합니다. 등록 방법은 내부 표준을 따르세요."
