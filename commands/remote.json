    {
      "id": "rsync",
      "name": "rsync",
      "kind": "command",
      "shell": "sh",
      "category": "remote",
      "task": "remote.sync",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": false,
      "summary": "변경분만 전송하는 로컬·원격 디렉토리 동기화",
      "description": "원본과 대상의 차이(변경된 파일·블록)만 전송해 디렉토리를 동기화합니다. SSH 를 통한 원격 전송, 권한·소유자·시간 보존, 중단된 전송 이어받기를 지원해 백업과 서버 이전에 널리 쓰입니다. 원본 경로 끝의 / 유무에 따라 결과가 달라지니 주의하세요.",
      "syntax": [
        "rsync -avz [--delete] {{SRC_DIR}}/ {{USER}}@{{HOST}}:{{DEST_DIR}}/",
        "rsync -avz {{USER}}@{{HOST}}:{{SRC_DIR}}/ {{DEST_DIR}}/"
      ],
      "options": [
        {
          "flag": "-a",
          "desc": "아카이브 모드: 재귀 + 권한·소유자·시간·링크 보존"
        },
        {
          "flag": "-v",
          "desc": "전송 파일 목록 출력"
        },
        {
          "flag": "-z",
          "desc": "전송 중 압축"
        },
        {
          "flag": "-h",
          "desc": "크기를 읽기 쉬운 단위로 표시"
        },
        {
          "flag": "-P",
          "desc": "--partial --progress: 진행률 표시 + 중단 시 이어받기"
        },
        {
          "flag": "-n, --dry-run",
          "desc": "실제 전송 없이 어떤 파일이 바뀔지만 확인"
        },
        {
          "flag": "--delete",
          "desc": "원본에 없는 파일을 대상에서 삭제 (완전 미러링)"
        },
        {
          "flag": "--exclude={{PATTERN}}",
          "desc": "제외할 파일·디렉토리 패턴 (여러 번 지정 가능)"
        },
        {
          "flag": "-e \"ssh -p {{PORT}}\"",
          "desc": "원격 셸 지정 (SSH 포트·키 변경 시)"
        },
        {
          "flag": "--bwlimit={{KBPS}}",
          "desc": "대역폭 제한 (기본 단위 KB/s)"
        }
      ],
      "examples": [
        {
          "title": "--dry-run 으로 먼저 확인 후 미러링",
          "command": "rsync -avhn --delete {{SRC_DIR}}/ {{USER}}@{{HOST}}:{{DEST_DIR}}/\nrsync -avh --delete {{SRC_DIR}}/ {{USER}}@{{HOST}}:{{DEST_DIR}}/",
          "note": "첫 줄 결과에 deleting 으로 표시된 파일이 실제로 삭제됨"
        },
        {
          "title": "SSH 포트를 바꿔 원격 백업 (진행률 표시)",
          "command": "rsync -avzP -e \"ssh -p {{PORT}}\" {{SRC_DIR}}/ {{USER}}@{{HOST}}:{{DEST_DIR}}/"
        },
        {
          "title": "로그·캐시 제외하고 동기화",
          "command": "rsync -av --exclude='*.log' --exclude='cache/' {{SRC_DIR}}/ {{DEST_DIR}}/"
        },
        {
          "title": "대역폭 제한해 업무 시간 중 전송",
          "command": "rsync -avP --bwlimit=10000 {{SRC_DIR}}/ {{USER}}@{{HOST}}:{{DEST_DIR}}/",
          "note": "약 10MB/s 로 제한"
        }
      ],
      "cautions": [
        "원본 끝에 / 가 있으면 '디렉토리 안의 내용'을, 없으면 '디렉토리 자체'를 대상 아래에 복사합니다.",
        "--delete 는 원본과 대상을 바꿔 쓰면 원본 데이터를 지울 수 있습니다. 반드시 -n 으로 먼저 확인하세요.",
        "원격 동기화 시 양쪽 서버 모두 rsync 가 설치되어 있어야 합니다."
      ],
      "install": {
        "rhel": {
          "package": "rsync",
          "preinstalled": false,
          "note": "minimal 설치에는 없을 수 있음: dnf install rsync"
        },
        "debian": {
          "package": "rsync",
          "preinstalled": true,
          "note": "Ubuntu Server 는 기본 포함. Debian 최소 설치에는 없을 수 있음"
        }
      },
      "platformNotes": {
        "rhel": "Windows 에서는 robocopy 가 비슷한 역할(미러링 /MIR)을 합니다."
      },
      "help": "man rsync",
      "keywords": [
        "동기화",
        "백업",
        "미러링",
        "변경분 전송",
        "이어받기",
        "rsync",
        "sync",
        "dry-run"
      ],
      "related": [
        "scp",
        "robocopy",
        "ssh",
        "tar"
      ]
    },
    {
      "id": "ssh-keygen",
      "name": "ssh-keygen",
      "kind": "command",
      "shell": "sh",
      "category": "remote",
      "task": "remote.keys",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": false,
      "summary": "SSH 키 쌍 생성·지문 확인·known_hosts 정리",
      "description": "SSH 공개키 인증에 쓰는 개인키·공개키 쌍을 만들고, 키 지문 확인, 암호 변경, known_hosts 의 오래된 호스트 키 삭제 등을 합니다. Windows 내장 OpenSSH 에도 같은 ssh-keygen 이 있으며 키는 %USERPROFILE%\\.ssh\\ 에 저장됩니다.",
      "syntax": [
        "ssh-keygen -t ed25519 [-C {{COMMENT}}] [-f {{KEY_FILE}}]",
        "ssh-keygen -R {{HOST}}"
      ],
      "options": [
        {
          "flag": "-t {{TYPE}}",
          "desc": "키 종류 (ed25519 권장, rsa, ecdsa)"
        },
        {
          "flag": "-b {{BITS}}",
          "desc": "키 길이 (RSA 는 3072 이상 권장)"
        },
        {
          "flag": "-C {{COMMENT}}",
          "desc": "키 주석 (보통 user@host 나 이메일)"
        },
        {
          "flag": "-f {{KEY_FILE}}",
          "desc": "키 파일 경로 지정"
        },
        {
          "flag": "-N {{PASSPHRASE}}",
          "desc": "개인키 암호 지정 (빈 값 '' 은 암호 없음)"
        },
        {
          "flag": "-p -f {{KEY_FILE}}",
          "desc": "기존 개인키의 암호 변경"
        },
        {
          "flag": "-l -f {{KEY_FILE}}",
          "desc": "키 지문(fingerprint) 출력"
        },
        {
          "flag": "-y -f {{KEY_FILE}}",
          "desc": "개인키에서 공개키 다시 추출"
        },
        {
          "flag": "-R {{HOST}}",
          "desc": "known_hosts 에서 해당 호스트 키 삭제"
        },
        {
          "flag": "-F {{HOST}}",
          "desc": "known_hosts 에서 해당 호스트 키 검색"
        }
      ],
      "examples": [
        {
          "title": "ed25519 키 생성",
          "command": "ssh-keygen -t ed25519 -C \"{{USER}}@{{HOST}}\"",
          "note": "기본 저장 위치 ~/.ssh/id_ed25519(개인키), id_ed25519.pub(공개키)"
        },
        {
          "title": "구형 장비 호환용 RSA 4096 키 생성",
          "command": "ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_legacy"
        },
        {
          "title": "서버 재설치 후 호스트 키 경고 해결",
          "command": "ssh-keygen -R {{HOST}}"
        },
        {
          "title": "서버 호스트 키 지문 확인 (서버에서)",
          "command": "ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub"
        }
      ],
      "cautions": [
        "기존 키 파일과 같은 경로로 생성하면 덮어쓸지 묻습니다. 덮어쓰면 그 키로 등록된 서버에 접속할 수 없게 됩니다.",
        "개인키(.pub 가 없는 파일)는 절대 다른 곳에 복사·공유하지 말고 권한을 600 으로 유지하세요."
      ],
      "install": {
