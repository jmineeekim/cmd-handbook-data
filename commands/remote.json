    {
      "id": "invoke-command",
      "name": "Invoke-Command",
      "aliases": [
        "icm"
      ],
      "kind": "command",
      "shell": "powershell",
      "category": "remote",
      "task": "remote.manage",
      "platforms": [
        "windows"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "여러 원격 Windows 서버에 명령 일괄 실행",
      "description": "PowerShell 원격(WinRM)으로 하나 이상의 원격 컴퓨터에서 스크립트 블록이나 스크립트 파일을 실행하고 결과를 받아옵니다. 여러 서버에 동시에 실행되며 결과에 PSComputerName 속성이 붙어 어느 서버의 결과인지 구분됩니다.",
      "syntax": [
        "Invoke-Command -ComputerName {{HOST}},{{HOST2}} -ScriptBlock { {{COMMAND}} }",
        "Invoke-Command -ComputerName {{HOST}} -FilePath {{SCRIPT_FILE}}"
      ],
      "options": [
        {
          "flag": "-ComputerName {{HOST}}",
          "desc": "실행할 원격 컴퓨터 (쉼표로 여러 대)"
        },
        {
          "flag": "-ScriptBlock { }",
          "desc": "원격에서 실행할 명령"
        },
        {
          "flag": "-FilePath {{SCRIPT_FILE}}",
          "desc": "로컬 스크립트 파일을 원격에서 실행"
        },
        {
          "flag": "-ArgumentList {{VALUE}}",
          "desc": "스크립트 블록에 인자 전달 (param() 으로 받음)"
        },
        {
          "flag": "-Credential {{USER}}",
          "desc": "다른 계정으로 실행"
        },
        {
          "flag": "-Session {{SESSION}}",
          "desc": "New-PSSession 으로 만든 세션 재사용"
        },
        {
          "flag": "-AsJob",
          "desc": "백그라운드 작업으로 실행 (Receive-Job 으로 결과 수신)"
        },
        {
          "flag": "-ThrottleLimit {{N}}",
          "desc": "동시 연결 수 (기본 32)"
        }
      ],
      "examples": [
        {
          "title": "여러 서버의 서비스 상태 확인",
          "command": "Invoke-Command -ComputerName {{HOST}},{{HOST2}} -ScriptBlock { Get-Service W32Time }"
        },
        {
          "title": "로컬 변수 값을 원격에 전달",
          "command": "$svc = 'Spooler'\nInvoke-Command -ComputerName {{HOST}} -ScriptBlock { Get-Service -Name $using:svc }",
          "note": "$using: 접두어로 로컬 변수 참조"
        },
        {
          "title": "서버 목록 파일로 일괄 실행",
          "command": "Invoke-Command -ComputerName (Get-Content .\\servers.txt) -ScriptBlock { Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 1 }"
        },
        {
          "title": "세션을 만들어 여러 번 재사용",
          "command": "$s = New-PSSession -ComputerName {{HOST}}\nInvoke-Command -Session $s -ScriptBlock { hostname }\nRemove-PSSession $s"
        }
      ],
      "cautions": [
        "변경 명령(재시작·삭제 등)은 여러 서버에 동시에 적용되므로 대상 목록을 먼저 확인하세요.",
        "원격에서 다른 서버 자원(파일 공유 등)에 접근하면 2차 홉 문제로 인증이 실패할 수 있습니다."
      ],
      "help": "Get-Help Invoke-Command -Full",
      "keywords": [
        "원격 실행",
        "일괄 실행",
        "원격 명령",
        "PowerShell 원격",
        "Invoke-Command",
        "WinRM",
        "icm"
      ],
      "related": [
        "enter-pssession",
        "winrm"
      ]
    }
  ]
