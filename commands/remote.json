{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "remote",
  "commands": [
    {
      "id": "ssh",
      "name": "ssh",
      "kind": "command",
      "shell": "sh",
      "category": "remote",
      "task": "remote.connect",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SSH 원격 접속·원격 명령 실행·포트 포워딩",
      "description": "OpenSSH 클라이언트로 원격 서버에 암호화된 셸 접속을 합니다. 원격 명령 한 줄 실행, 점프 호스트 경유 접속, 로컬·원격·동적(SOCKS) 포트 포워딩까지 처리합니다. 자주 쓰는 접속 정보는 ~/.ssh/config 에 Host 별칭으로 저장해 두면 편합니다.",
      "syntax": [
        "ssh [-p {{PORT}}] [-i {{KEY_FILE}}] {{USER}}@{{HOST}} [{{COMMAND}}]",
        "ssh -L {{LOCAL_PORT}}:{{TARGET_HOST}}:{{TARGET_PORT}} {{USER}}@{{HOST}}"
      ],
      "options": [
        {
          "flag": "-p {{PORT}}",
          "desc": "접속 포트 지정 (기본 22)"
        },
        {
          "flag": "-i {{KEY_FILE}}",
          "desc": "사용할 개인키 파일 지정"
        },
        {
          "flag": "-J {{USER}}@{{JUMP_HOST}}",
          "desc": "점프 호스트(배스천)를 경유해 접속 (ProxyJump)"
        },
        {
          "flag": "-L {{LOCAL_PORT}}:{{TARGET_HOST}}:{{TARGET_PORT}}",
          "desc": "로컬 포트 포워딩: 내 PC 포트 → 원격에서 본 대상"
        },
        {
          "flag": "-R {{REMOTE_PORT}}:{{TARGET_HOST}}:{{TARGET_PORT}}",
          "desc": "원격(리버스) 포트 포워딩: 원격 서버 포트 → 내 쪽 대상"
        },
        {
          "flag": "-D {{LOCAL_PORT}}",
          "desc": "동적 포워딩 (SOCKS 프록시)"
        },
        {
          "flag": "-N",
          "desc": "원격 명령 실행 없이 포워딩만 유지"
        },
        {
          "flag": "-f",
          "desc": "인증 후 백그라운드로 전환 (-N 과 함께 터널용)"
        },
        {
          "flag": "-o {{OPTION}}={{VALUE}}",
          "desc": "설정 옵션 직접 지정 (예: -o StrictHostKeyChecking=no, -o ConnectTimeout=5)"
        },
        {
          "flag": "-v",
          "desc": "디버그 출력 (-vvv 까지). 인증 실패 원인 확인용"
        }
      ],
      "examples": [
        {
          "title": "포트·키를 지정해 접속",
          "command": "ssh -p {{PORT}} -i ~/.ssh/id_ed25519 {{USER}}@{{HOST}}"
        },
        {
          "title": "원격 명령 한 줄 실행",
          "command": "ssh {{USER}}@{{HOST}} 'uptime; df -h'"
        },
        {
          "title": "점프 호스트 경유 접속",
          "command": "ssh -J {{USER}}@{{JUMP_HOST}} {{USER}}@{{HOST}}",
          "note": "여러 단계는 -J host1,host2 처럼 쉼표로 연결"
        },
        {
          "title": "로컬 포트 포워딩으로 내부 DB 접근",
          "command": "ssh -N -L 13306:{{DB_HOST}}:3306 {{USER}}@{{HOST}}",
          "note": "내 PC 의 127.0.0.1:13306 으로 접속하면 {{HOST}} 를 거쳐 {{DB_HOST}}:3306 으로 연결됨"
        },
        {
          "title": "SOCKS 프록시 터널을 백그라운드로 열기",
          "command": "ssh -f -N -D 1080 {{USER}}@{{HOST}}",
          "note": "브라우저 프록시를 SOCKS5 127.0.0.1:1080 으로 설정"
        }
      ],
      "cautions": [
        "호스트 키가 바뀌었다는 경고(REMOTE HOST IDENTIFICATION HAS CHANGED)는 서버 재설치 또는 중간자 공격일 수 있으니 확인 후 ssh-keygen -R {{HOST}} 로 지우세요.",
        "-o StrictHostKeyChecking=no 는 호스트 키 검증을 끄므로 테스트 환경에서만 쓰세요.",
        "-R 로 연 원격 포트는 기본적으로 원격 서버의 localhost 에만 열립니다 (sshd 의 GatewayPorts 설정에 따라 다름)."
      ],
      "install": {
        "rhel": {
          "package": "openssh-clients",
          "preinstalled": true
        },
        "debian": {
          "package": "openssh-client",
          "preinstalled": true
        }
      },
      "help": "man ssh, man ssh_config",
      "keywords": [
        "원격 접속",
        "SSH 접속",
        "터널링",
        "포트 포워딩",
        "점프 호스트",
        "배스천",
        "ssh",
        "ProxyJump",
        "SOCKS"
      ],
      "related": [
        "scp",
        "sftp",
        "rsync",
        "ssh-keygen",
        "ssh-copy-id",
        "etc-ssh-sshd-config"
      ]
    },
    {
      "id": "win-ssh",
      "name": "ssh",
      "kind": "command",
      "shell": "cmd",
      "category": "remote",
      "task": "remote.connect",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "Windows 내장 OpenSSH 클라이언트로 SSH 접속",
      "description": "Windows 10 1809 / Server 2019 이후 기본 제공되는 OpenSSH 클라이언트입니다. 사용법과 옵션은 Linux 의 ssh 와 거의 같으며, scp·sftp·ssh-keygen 도 함께 들어 있습니다. PuTTY 없이 CMD·PowerShell 에서 바로 Linux 서버에 접속할 수 있습니다.",
      "syntax": [
        "ssh [-p {{PORT}}] [-i {{KEY_FILE}}] {{USER}}@{{HOST}} [{{COMMAND}}]"
      ],
      "options": [
        {
          "flag": "-p {{PORT}}",
          "desc": "접속 포트 지정 (기본 22)"
        },
        {
          "flag": "-i {{KEY_FILE}}",
          "desc": "개인키 파일 지정 (기본 %USERPROFILE%\\.ssh\\id_ed25519 등)"
        },
        {
          "flag": "-J {{USER}}@{{JUMP_HOST}}",
          "desc": "점프 호스트 경유 접속"
        },
        {
          "flag": "-L {{LOCAL_PORT}}:{{TARGET_HOST}}:{{TARGET_PORT}}",
          "desc": "로컬 포트 포워딩"
        },
        {
          "flag": "-D {{LOCAL_PORT}}",
          "desc": "SOCKS 프록시 (동적 포워딩)"
        },
        {
          "flag": "-N",
          "desc": "명령 실행 없이 포워딩만 유지"
        },
        {
          "flag": "-v",
          "desc": "디버그 출력"
        }
      ],
      "examples": [
        {
          "title": "Linux 서버 접속",
          "command": "ssh {{USER}}@{{HOST}}"
        },
        {
          "title": "OpenSSH 클라이언트 설치 여부 확인 (PowerShell, 관리자)",
          "command": "Get-WindowsCapability -Online -Name OpenSSH.Client*"
        },
        {
          "title": "OpenSSH 클라이언트 설치 (PowerShell, 관리자)",
          "command": "Add-WindowsCapability -Online -Name OpenSSH.Client~~~~0.0.1.0"
        },
        {
          "title": "공개키를 Linux 서버에 등록 (ssh-copy-id 대체)",
          "command": "type %USERPROFILE%\\.ssh\\id_ed25519.pub | ssh {{USER}}@{{HOST}} \"mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys\"",
          "note": "Windows 에는 ssh-copy-id 가 없음"
        }
      ],
      "cautions": [
        "개인키 파일 권한이 넓으면(다른 사용자 읽기 가능) 'UNPROTECTED PRIVATE KEY FILE' 오류로 키가 무시됩니다. 파일 속성 > 보안에서 본인만 남기세요.",
        "Windows 를 SSH 서버(sshd)로 쓸 때 관리자 계정의 공개키는 C:\\ProgramData\\ssh\\administrators_authorized_keys 에 넣어야 합니다."
      ],
      "install": {
        "windows": {
          "package": "OpenSSH.Client (선택적 기능)",
          "preinstalled": true,
          "note": "Windows 10 1809+/Server 2019+ 에서 기본 설치. 없으면 설정 > 선택적 기능 또는 Add-WindowsCapability 로 추가"
        }
      },
      "platformNotes": {
        "windows": "설정 파일·키 위치는 %USERPROFILE%\\.ssh\\ (config, known_hosts, id_ed25519). 실행 파일은 C:\\Windows\\System32\\OpenSSH\\ 에 있습니다."
      },
      "help": "ssh (인자 없이 실행하면 사용법 출력)",
      "keywords": [
        "원격 접속",
        "SSH 접속",
        "윈도우 SSH",
        "OpenSSH",
        "ssh",
        "PuTTY 대체"
      ],
      "related": [
        "mstsc",
        "enter-pssession",
        "ssh-keygen",
        "scp"
      ]
    },
    {
      "id": "mstsc",
      "name": "mstsc",
      "kind": "command",
      "shell": "cmd",
      "category": "remote",
      "task": "remote.connect",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "원격 데스크톱(RDP) 연결 실행",
      "description": "원격 데스크톱 연결(RDP) 클라이언트를 실행합니다. 명령줄 옵션으로 접속 대상·포트·전체 화면·해상도를 지정할 수 있고, 관리 세션(/admin)이나 세션 섀도잉도 가능합니다.",
      "syntax": [
        "mstsc [/v:{{HOST}}[:{{PORT}}]] [/admin] [/f] [/w:{{WIDTH}} /h:{{HEIGHT}}]",
        "mstsc {{RDP_FILE}}"
      ],
      "options": [
        {
          "flag": "/v:{{HOST}}:{{PORT}}",
          "desc": "접속할 서버와 포트 (기본 3389)"
        },
        {
          "flag": "/admin",
          "desc": "관리 세션으로 접속 (RDS 라이선스를 쓰지 않는 관리용 접속)"
        },
        {
          "flag": "/f",
          "desc": "전체 화면으로 시작"
        },
        {
          "flag": "/w:{{WIDTH}} /h:{{HEIGHT}}",
          "desc": "창 크기 지정"
        },
        {
          "flag": "/multimon",
          "desc": "여러 모니터 사용"
        },
        {
          "flag": "/edit {{RDP_FILE}}",
          "desc": ".rdp 파일 편집 창 열기"
        },
        {
          "flag": "/shadow:{{SESSION_ID}}",
          "desc": "다른 사용자 세션 섀도잉 (/control 로 제어, /noConsentPrompt 로 동의 생략)"
        },
        {
          "flag": "/restrictedAdmin",
          "desc": "자격 증명을 원격에 넘기지 않는 제한된 관리 모드"
        }
      ],
      "examples": [
        {
          "title": "포트를 지정해 원격 데스크톱 접속",
          "command": "mstsc /v:{{HOST}}:{{PORT}}"
        },
        {
          "title": "관리 세션으로 전체 화면 접속",
          "command": "mstsc /v:{{HOST}} /admin /f"
        },
        {
          "title": "원격 서버의 세션 확인 후 섀도잉",
          "command": "qwinsta /server:{{HOST}}\nmstsc /v:{{HOST}} /shadow:{{SESSION_ID}} /control",
          "note": "섀도잉은 그룹 정책(원격 제어 규칙) 설정과 관리자 권한이 필요"
        }
      ],
      "cautions": [
        "서버 측에서 원격 데스크톱 허용과 방화벽(TCP 3389) 허용이 되어 있어야 합니다.",
        "Windows Server 기본은 관리용 동시 접속 2세션입니다. 초과 시 기존 세션을 끊어야 접속됩니다."
      ],
      "help": "mstsc /?",
      "keywords": [
        "원격 데스크톱",
        "RDP",
        "원격 접속",
        "mstsc",
        "Remote Desktop",
        "3389",
        "섀도잉"
      ],
      "related": [
        "win-ssh",
        "enter-pssession"
      ]
    },
    {
      "id": "enter-pssession",
      "name": "Enter-PSSession",
      "aliases": [
        "etsn"
      ],
      "kind": "command",
      "shell": "powershell",
      "category": "remote",
      "task": "remote.connect",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "원격 Windows 에 대화형 PowerShell 세션 접속",
      "description": "WinRM(WS-Management)을 통해 원격 컴퓨터에 대화형 PowerShell 세션으로 들어갑니다. 프롬프트 앞에 [서버명]: 이 붙고, Exit-PSSession 으로 빠져나옵니다. 대상 서버에 PowerShell Remoting 이 활성화되어 있어야 합니다.",
      "syntax": [
        "Enter-PSSession -ComputerName {{HOST}} [-Credential {{DOMAIN}}\\{{USER}}]",
        "Enter-PSSession -HostName {{HOST}} -UserName {{USER}}"
      ],
      "options": [
        {
          "flag": "-ComputerName {{HOST}}",
          "desc": "접속할 컴퓨터 (WinRM 사용)"
        },
        {
          "flag": "-Credential {{USER}}",
          "desc": "다른 계정으로 접속 (암호 입력 창 표시)"
        },
        {
          "flag": "-UseSSL",
          "desc": "HTTPS(5986) 리스너로 접속"
        },
        {
          "flag": "-Port {{PORT}}",
          "desc": "WinRM 포트 지정 (기본 HTTP 5985 / HTTPS 5986)"
        },
        {
          "flag": "-Authentication {{AUTH}}",
          "desc": "인증 방식 (Default, Kerberos, Negotiate, CredSSP 등)"
        },
        {
          "flag": "-Session {{SESSION}}",
          "desc": "New-PSSession 으로 만든 기존 세션에 접속"
        },
        {
          "flag": "-HostName {{HOST}}",
          "desc": "WinRM 대신 SSH 로 접속 (PowerShell 7 이상)"
        }
      ],
      "examples": [
        {
          "title": "도메인 서버에 원격 접속",
          "command": "Enter-PSSession -ComputerName {{HOST}}\nExit-PSSession"
        },
        {
          "title": "다른 계정으로 접속",
          "command": "Enter-PSSession -ComputerName {{HOST}} -Credential (Get-Credential)"
        },
        {
          "title": "워크그룹(비도메인) 서버 접속 준비",
          "command": "Set-Item WSMan:\\localhost\\Client\\TrustedHosts -Value '{{HOST}}' -Force\nEnter-PSSession -ComputerName {{HOST}} -Credential {{HOST}}\\{{USER}}",
          "note": "TrustedHosts 설정은 클라이언트(내 PC)에서 관리자 권한으로 실행"
        }
      ],
      "cautions": [
        "원격 세션 안에서는 GUI 프로그램을 실행할 수 없고, 다른 서버로 다시 접속할 때(2차 홉) 자격 증명이 전달되지 않습니다.",
        "TrustedHosts 에 '*' 를 넣으면 모든 호스트를 신뢰하게 되므로 피하세요."
      ],
      "platformNotes": {
        "windows": "Windows Server 는 기본으로 WinRM 이 켜져 있고, Windows 10/11 은 Enable-PSRemoting 또는 winrm quickconfig 로 켜야 합니다."
      },
      "help": "Get-Help Enter-PSSession -Full",
      "keywords": [
        "원격 PowerShell",
        "원격 접속",
        "PS 원격",
        "WinRM",
        "PSSession",
        "PowerShell Remoting"
      ],
      "related": [
        "invoke-command",
        "winrm",
        "mstsc"
      ]
    },
    {
      "id": "scp",
      "name": "scp",
      "kind": "command",
      "shell": "sh",
      "category": "remote",
      "task": "remote.transfer",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "caution",
      "requiresAdmin": false,
      "summary": "SSH 로 원격 서버와 파일 복사",
      "description": "SSH 연결을 이용해 로컬과 원격, 또는 원격과 원격 사이에 파일을 복사합니다. 사용법이 cp 와 비슷해 간단한 전송에 적합하며, 대용량·반복 전송이나 이어받기가 필요하면 rsync 가 낫습니다.",
      "syntax": [
        "scp [-P {{PORT}}] [-r] {{FILE}} {{USER}}@{{HOST}}:{{REMOTE_PATH}}",
        "scp [-P {{PORT}}] {{USER}}@{{HOST}}:{{REMOTE_PATH}} {{LOCAL_PATH}}"
      ],
      "options": [
        {
          "flag": "-P {{PORT}}",
          "desc": "SSH 포트 지정 (대문자 P, ssh 의 -p 와 다름)"
        },
        {
          "flag": "-r",
          "desc": "디렉토리 전체 재귀 복사"
        },
        {
          "flag": "-p",
          "desc": "수정 시간·권한 보존"
        },
        {
          "flag": "-i {{KEY_FILE}}",
          "desc": "개인키 파일 지정"
        },
        {
          "flag": "-C",
          "desc": "전송 중 압축"
        },
        {
          "flag": "-l {{KBITS}}",
          "desc": "대역폭 제한 (Kbit/s 단위)"
        },
        {
          "flag": "-J {{USER}}@{{JUMP_HOST}}",
          "desc": "점프 호스트 경유"
        },
        {
          "flag": "-3",
          "desc": "원격↔원격 복사 시 로컬을 거쳐 전송"
        },
        {
          "flag": "-O",
          "desc": "구식 SCP 프로토콜 강제 (SFTP 서버가 없는 구형 장비용)"
        }
      ],
      "examples": [
        {
          "title": "로컬 파일을 원격으로 업로드",
          "command": "scp {{FILE}} {{USER}}@{{HOST}}:/tmp/"
        },
        {
          "title": "원격 로그를 로컬로 다운로드 (포트 지정)",
          "command": "scp -P {{PORT}} {{USER}}@{{HOST}}:/var/log/messages ./"
        },
        {
          "title": "디렉토리 전체를 권한 보존하며 복사",
          "command": "scp -rp {{DIR}} {{USER}}@{{HOST}}:/backup/"
        },
        {
          "title": "점프 호스트 너머 서버로 복사",
          "command": "scp -J {{USER}}@{{JUMP_HOST}} {{FILE}} {{USER}}@{{HOST}}:/tmp/"
        }
      ],
      "cautions": [
        "대상에 같은 이름 파일이 있으면 확인 없이 덮어씁니다.",
        "원격 경로에 공백·특수문자가 있으면 따옴표로 감싸야 합니다."
      ],
      "install": {
        "rhel": {
          "package": "openssh-clients",
          "preinstalled": true
        },
        "debian": {
          "package": "openssh-client",
          "preinstalled": true
        }
      },
      "platformNotes": {
