    {
      "id": "etc-ssh-sshd-config",
      "name": "/etc/ssh/sshd_config",
      "kind": "file",
      "category": "remote",
      "task": "remote.keys",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SSH 서버(sshd) 설정 파일: 포트·root 로그인·인증 방식",
      "description": "SSH 서버의 포트, root 로그인 허용 여부, 비밀번호·키 인증 방식, 접속 허용 사용자 등을 설정하는 파일입니다. 최근 배포판은 /etc/ssh/sshd_config.d/*.conf 를 먼저 Include 하므로 그쪽 파일 설정이 우선할 수 있습니다. 수정 후 sshd -t 로 문법을 검사하고 서비스를 reload 하세요.",
      "syntax": [
        "/etc/ssh/sshd_config",
        "/etc/ssh/sshd_config.d/{{NAME}}.conf"
      ],
      "options": [
        {
          "flag": "Port {{PORT}}",
          "desc": "SSH 수신 포트 (기본 22)"
        },
        {
          "flag": "ListenAddress {{IP}}",
          "desc": "수신할 IP 주소 제한"
        },
        {
          "flag": "PermitRootLogin no|prohibit-password|yes",
          "desc": "root 직접 로그인 허용 여부 (prohibit-password = 키만 허용)"
        },
        {
          "flag": "PasswordAuthentication yes|no",
          "desc": "비밀번호 인증 허용 여부"
        },
        {
          "flag": "PubkeyAuthentication yes",
          "desc": "공개키 인증 허용 (기본 yes)"
        },
        {
          "flag": "AllowUsers {{USER}} {{USER}}@{{CIDR}}",
          "desc": "접속 허용 사용자 제한 (AllowGroups 도 가능)"
        },
        {
          "flag": "ClientAliveInterval {{SECONDS}}",
          "desc": "유휴 세션 확인 주기 (ClientAliveCountMax 와 함께 끊김 시간 결정)"
        },
        {
          "flag": "MaxAuthTries {{N}}",
          "desc": "접속당 최대 인증 시도 횟수"
        },
        {
          "flag": "Include /etc/ssh/sshd_config.d/*.conf",
          "desc": "추가 설정 파일 포함 (파일 맨 위에 있음)"
        }
      ],
      "examples": [
        {
          "title": "실제 적용되는 설정값 확인",
          "command": "sshd -T | grep -Ei 'port|permitrootlogin|passwordauthentication'"
        },
        {
          "title": "문법 검사 후 반영",
          "command": "sshd -t && systemctl reload sshd",
          "platforms": [
            "rhel"
          ]
        },
        {
          "title": "문법 검사 후 반영",
          "command": "sshd -t && systemctl reload ssh",
          "platforms": [
            "debian"
          ]
        },
        {
          "title": "포트 변경 시 SELinux·방화벽 허용 (RHEL)",
          "command": "semanage port -a -t ssh_port_t -p tcp {{PORT}}\nfirewall-cmd --permanent --add-port={{PORT}}/tcp\nfirewall-cmd --reload\nsystemctl restart sshd",
          "platforms": [
            "rhel"
          ]
        },
        {
          "title": "포트 변경 반영 (Ubuntu 24.04 소켓 활성화)",
