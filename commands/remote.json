    {
      "id": "sftp",
      "name": "sftp",
      "kind": "command",
      "shell": "sh",
      "category": "remote",
      "task": "remote.transfer",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "basic",
      "risk": "caution",
      "requiresAdmin": false,
      "summary": "SSH 기반 대화형 파일 전송 (SFTP)",
      "description": "SSH 위에서 동작하는 대화형 파일 전송 클라이언트입니다. FTP 처럼 ls, cd, get, put 명령으로 원격 파일을 탐색하며 주고받을 수 있고, -b 배치 파일로 자동화도 가능합니다.",
      "syntax": [
        "sftp [-P {{PORT}}] [-i {{KEY_FILE}}] {{USER}}@{{HOST}}",
        "sftp -b {{BATCH_FILE}} {{USER}}@{{HOST}}"
      ],
      "options": [
        {
          "flag": "-P {{PORT}}",
          "desc": "SSH 포트 지정 (대문자 P)"
        },
        {
          "flag": "-i {{KEY_FILE}}",
          "desc": "개인키 파일 지정"
        },
        {
          "flag": "-b {{BATCH_FILE}}",
          "desc": "파일에 적힌 sftp 명령을 순서대로 실행 (- 는 표준입력)"
        },
        {
          "flag": "-r",
          "desc": "get/put 시 디렉토리 재귀 전송"
        },
        {
          "flag": "-J {{USER}}@{{JUMP_HOST}}",
          "desc": "점프 호스트 경유"
        },
        {
          "flag": "-l {{KBITS}}",
          "desc": "대역폭 제한 (Kbit/s)"
        },
        {
          "flag": "-o {{OPTION}}={{VALUE}}",
          "desc": "ssh 설정 옵션 전달"
        }
      ],
      "examples": [
        {
          "title": "대화형으로 접속해 파일 주고받기",
          "command": "sftp {{USER}}@{{HOST}}\nsftp> ls -l\nsftp> cd /var/log\nsftp> get messages\nsftp> lcd /tmp\nsftp> put {{FILE}}\nsftp> bye",
          "note": "lcd·lls 는 로컬 쪽 명령. get -r / put -r 로 디렉토리 전송"
        },
        {
          "title": "배치로 파일 업로드 (표준입력)",
          "command": "echo \"put {{FILE}} /upload/\" | sftp -b - {{USER}}@{{HOST}}"
        }
      ],
      "cautions": [
        "-b 배치 모드에서는 비밀번호 입력이 안 되므로 키 인증이 필요합니다.",
        "put/get 은 같은 이름 파일을 확인 없이 덮어씁니다."
      ],
      "install": {
