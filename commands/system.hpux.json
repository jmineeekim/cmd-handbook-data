            },
            {
              "cmd": "d",
              "desc": "디스크 I/O 요약"
            },
            {
              "cmd": "u",
              "desc": "디스크(장치)별 I/O"
            },
            {
              "cmd": "v",
              "desc": "논리 볼륨별 I/O"
            },
            {
              "cmd": "l",
              "desc": "네트워크 인터페이스별"
            },
            {
              "cmd": "w",
              "desc": "스왑 공간"
            },
            {
              "cmd": "t",
              "desc": "시스템 테이블 사용률 (nproc, nfile 등 커널 한계)"
