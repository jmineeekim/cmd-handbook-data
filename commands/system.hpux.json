    {
      "id": "hpux-bdf",
      "name": "bdf",
      "kind": "command",
      "shell": "sh",
      "category": "system",
      "task": "system.disk-usage",
      "platforms": [
        "hpux"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일시스템 사용량 확인 (HP-UX 의 df -k)",
      "description": "마운트된 파일시스템의 크기, 사용량, 남은 공간, 사용률을 KB 단위로 보여 줍니다. HP-UX 의 df 는 출력 형식이 달라 실무에서는 bdf 를 주로 씁니다. 장치 이름이 길면 한 항목이 두 줄로 나뉘어 출력됩니다.",
      "syntax": [
        "bdf [-i] [-l] [-t {{FSTYPE}}] [{{MOUNT_POINT}}]"
      ],
      "options": [
        {
          "flag": "-i",
          "desc": "inode 사용량도 표시"
        },
        {
          "flag": "-l",
          "desc": "로컬 파일시스템만 (NFS 제외)"
        },
        {
          "flag": "-t {{FSTYPE}}",
          "desc": "특정 유형만 (vxfs, nfs 등)"
        }
      ],
      "examples": [
        {
          "title": "전체 사용량",
          "command": "bdf"
        },
        {
          "title": "특정 파일시스템",
          "command": "bdf {{MOUNT_POINT}}"
        },
        {
          "title": "사용률 80% 이상만 찾기",
          "command": "bdf -l | awk 'NF==1{dev=$1;next} NF==5{print dev,$0;next} {print}' | awk '$(NF-1)+0>=80'",
          "note": "두 줄로 나뉜 항목을 한 줄로 합친 뒤 사용률을 비교합니다."
        }
      ],
      "cautions": [
        "장치 이름이 긴 항목은 두 줄로 출력되므로 awk 로 열 번호를 고정해 파싱하면 틀립니다.",
        "NFS 서버가 응답하지 않으면 bdf 가 멈출 수 있습니다. 이때는 bdf -l 을 쓰세요."
      ],
      "help": "man bdf",
      "keywords": [
        "디스크 용량",
        "파일시스템 사용량",
        "bdf",
        "df",
        "남은 공간",
        "inode"
      ],
      "related": [
        "df",
        "du",
        "hpux-vgdisplay",
        "hpux-lvextend",
        "hpux-fsadm"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
