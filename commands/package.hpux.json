{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "package",
  "commands": [
    {
      "id": "hpux-swlist",
      "name": "swlist",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.single",
      "platforms": ["hpux"],
      "level": "critical",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "설치된 소프트웨어·패치·OE 버전·depot 내용 조회 (SD-UX)",
      "description": "HP-UX 의 소프트웨어 배포 도구(SD-UX)에서 설치된 번들·제품·파일셋·패치를 조회합니다. 소프트웨어는 번들 > 제품 > 파일셋 계층이고 패치는 PHxx_nnnnn 이름의 제품입니다. -s 로 설치용 저장소(depot)의 내용도 볼 수 있습니다.",
      "syntax": [
        "swlist [-l {{LEVEL}}] [-a {{ATTRIBUTE}}] [{{SOFTWARE}}]",
        "swlist -s {{DEPOT}}",
        "swlist -d @ {{DEPOT_DIR}}"
      ],
      "options": [
        { "flag": "-l bundle|product|fileset|patch", "desc": "보여 줄 계층" },
        { "flag": "-l depot", "desc": "등록된 depot 목록" },
        { "flag": "-a {{ATTRIBUTE}}", "desc": "특정 속성 표시 (revision, state, install_date, size 등)" },
        { "flag": "-s {{DEPOT}}", "desc": "설치 원본(depot)의 내용 조회 (디렉토리, .depot 파일, host:/path)" },
        { "flag": "-d", "desc": "시스템이 아닌 depot 을 대상으로 조회" },
        { "flag": "-v", "desc": "모든 속성을 자세히" }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 조회",
          "type": "subcommand",
          "items": [
            { "cmd": "swlist", "desc": "설치된 번들·최상위 제품 목록" },
            { "cmd": "swlist -l bundle | grep -i OE", "desc": "OE(운영 환경) 종류와 버전 (예: HPUX11i-DC-OE B.11.31.xxxx)" },
            { "cmd": "swlist -l product | grep PH", "desc": "설치된 패치 목록" },
            { "cmd": "swlist -l fileset -a state | grep -v -E 'configured|^#'", "desc": "configured 가 아닌(설치 미완료·손상) 파일셋 찾기" },
            { "cmd": "swlist -l product -a revision {{PRODUCT}}", "desc": "특정 제품 버전" },
            { "cmd": "swlist -l file {{PRODUCT}}", "desc": "제품에 포함된 파일 목록" }
          ]
        }
      ],
      "examples": [
        { "title": "OS 업데이트 수준 확인", "command": "uname -r\nswlist -l bundle | grep -i -E 'OE|QPK'" },
        { "title": "특정 소프트웨어 설치 여부 확인", "command": "swlist -l product | grep -i {{KEYWORD}}" },
        { "title": "설치 전 depot 내용 확인", "command": "swlist -s {{DEPOT}}" },
        { "title": "패치 이후 손상·미구성 파일셋 점검", "command": "swlist -l fileset -a state | grep -v -E 'configured|^#'" }
      ],
      "cautions": [
        "swlist 는 SD-UX 데이터베이스(IPD) 기준입니다. swinstall 을 거치지 않고 복사한 파일은 나타나지 않습니다."
      ],
      "help": "man swlist · man sd",
      "keywords": ["설치 목록", "swlist", "패치 목록", "OE 버전", "depot", "SD-UX", "번들", "파일셋"],
      "related": ["hpux-swinstall", "hpux-swremove", "hpux-swverify", "hpux-show-patches", "hpux-machinfo"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-swinstall",
      "name": "swinstall",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.install",
      "platforms": ["hpux"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "depot 에서 소프트웨어·패치 설치 (SD-UX)",
      "description": "depot(설치 저장소)에서 소프트웨어나 패치를 설치합니다. 설치할 대상을 지정하지 않으면 터미널 화면(TUI)이 열리고, 지정하면 명령행으로 바로 진행합니다. 커널 관련 패치는 설치 후 재부팅이 필요하며 -x autoreboot=true 가 없으면 설치가 진행되지 않습니다.",
      "syntax": [
        "swinstall -s {{DEPOT}} [-x {{OPTION}}={{VALUE}}] {{SOFTWARE}}",
        "swinstall -p -s {{DEPOT}} {{SOFTWARE}}",
        "swinstall -s {{DEPOT}}"
      ],
      "options": [
        { "flag": "-s {{DEPOT}}", "desc": "원본 depot (디렉토리, .depot 파일 경로, host:/path)" },
        { "flag": "-p", "desc": "미리보기: 의존성·디스크 공간만 분석하고 설치하지 않음" },
        { "flag": "-x {{OPTION}}={{VALUE}}", "desc": "동작 옵션 지정 (아래 목록)" },
        { "flag": "\\*", "desc": "depot 의 모든 소프트웨어 선택 (셸 확장을 막기 위해 \\ 사용)" }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 -x 옵션",
          "type": "directive",
          "items": [
            { "cmd": "-x autoreboot=true", "desc": "재부팅이 필요한 소프트웨어(커널 패치 등) 설치 허용 후 자동 재부팅" },
            { "cmd": "-x mount_all_filesystems=false", "desc": "fstab 의 일부 파일시스템이 마운트되지 않았어도 진행" },
            { "cmd": "-x reinstall=true", "desc": "이미 설치된 같은 버전도 다시 설치" },
            { "cmd": "-x patch_match_target=true", "desc": "depot 패치 중 현재 설치된 소프트웨어에 해당하는 것만 선택" },
            { "cmd": "-x enforce_dependencies=false", "desc": "의존성 검사 무시 (권장하지 않음)" }
          ]
        }
      ],
      "examples": [
        {
          "title": "패치 번들 설치 절차",
          "steps": [
            { "prompt": "#", "cmd": "/opt/ignite/bin/make_tape_recovery -A -v -x inc_entire=vg00 -a /dev/rtape/tape0_BEST", "desc": "작업 전 OS 복구 이미지 확보 (또는 make_net_recovery)" },
            { "prompt": "#", "cmd": "swlist -s {{DEPOT}}", "desc": "depot 내용 확인" },
            { "prompt": "#", "cmd": "swinstall -p -s {{DEPOT}} -x patch_match_target=true", "desc": "미리보기로 선택 결과·의존성·공간 점검" },
            { "prompt": "#", "cmd": "bdf /var /opt /usr /stand", "desc": "설치 공간 확인" },
            { "prompt": "#", "cmd": "swinstall -s {{DEPOT}} -x patch_match_target=true -x autoreboot=true", "desc": "설치 (필요하면 자동 재부팅)" },
            { "prompt": "#", "cmd": "tail -50 /var/adm/sw/swagent.log\nswlist -l fileset -a state | grep -v -E 'configured|^#'", "desc": "재부팅 후 오류·미구성 파일셋 확인" }
          ]
        },
        { "title": "단일 패치 파일(.depot) 설치", "command": "swinstall -s /var/tmp/{{PATCH_ID}}.depot {{PATCH_ID}}" },
        { "title": "원격 depot 서버에서 설치", "command": "swinstall -s {{DEPOT_SERVER}}:/var/depot/{{DEPOT_NAME}} {{PRODUCT}}" }
      ],
      "cautions": [
        "-x autoreboot=true 를 주면 설치 직후 확인 없이 재부팅됩니다. Serviceguard 노드는 패키지를 먼저 옮기고 cmhaltnode 한 뒤 실행하세요.",
        "설치 결과와 오류는 /var/adm/sw/swagent.log(대상 시스템)와 /var/adm/sw/swinstall.log 에 남습니다. 성공 메시지만 보지 말고 ERROR·WARNING 을 확인하세요.",
        "되돌리기는 swremove 로 하지만 커널·라이브러리 패치는 제거가 어렵거나 불가능할 수 있으므로 Ignite 복구 이미지를 먼저 받으세요."
      ],
      "help": "man swinstall · man sd",
      "keywords": ["설치", "패치 설치", "swinstall", "depot", "autoreboot", "SD-UX", "HP-UX 패치"],
      "related": ["hpux-swlist", "hpux-swremove", "hpux-swcopy", "hpux-swverify", "hpux-make-tape-recovery"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-swremove",
      "name": "swremove",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.install",
      "platforms": ["hpux"],
      "level": "frequent",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "설치된 소프트웨어·패치 제거 (depot 정리 포함)",
      "description": "설치된 제품·파일셋·패치를 제거합니다. -d 를 주면 시스템이 아니라 depot 에서 소프트웨어를 지웁니다. -p 로 먼저 미리보기를 해서 의존 관계로 함께 영향을 받는 것이 없는지 확인합니다.",
      "syntax": [
        "swremove [-p] [-x {{OPTION}}={{VALUE}}] {{SOFTWARE}}",
        "swremove -d {{SOFTWARE}} @ {{DEPOT_DIR}}"
      ],
      "options": [
        { "flag": "-p", "desc": "미리보기 (실제로 지우지 않음)" },
        { "flag": "-d", "desc": "depot 에서 제거" },
        { "flag": "-x autoreboot=true", "desc": "재부팅이 필요한 소프트웨어 제거 허용" }
      ],
      "examples": [
        { "title": "제품 제거 전 미리보기 후 제거", "command": "swremove -p {{PRODUCT}}\nswremove {{PRODUCT}}\ntail -30 /var/adm/sw/swagent.log" },
        { "title": "depot 에서 소프트웨어 지우기", "command": "swremove -d {{PRODUCT}} @ /var/depot/{{DEPOT_NAME}}" }
      ],
      "cautions": [
        "패치를 제거하면 그 패치가 대체(supersede)했던 이전 상태로 돌아가지 않을 수 있습니다. 제거 전 패치 문서와 의존 관계를 확인하세요.",
        "운영 서버에서는 반드시 -p 로 영향을 먼저 확인하세요."
      ],
      "help": "man swremove",
      "keywords": ["제거", "삭제", "swremove", "패치 제거", "depot 정리", "SD-UX"],
      "related": ["hpux-swlist", "hpux-swinstall", "hpux-swverify"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-swverify",
      "name": "swverify",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.single",
      "platforms": ["hpux"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "설치 소프트웨어 무결성·의존성 검증",
      "description": "설치된 소프트웨어의 파일이 설치 당시와 같은지(크기, 권한, 체크섬)와 의존성이 충족되는지 검사합니다. 패치 작업 후나 파일 변조 의심 시 점검용으로 씁니다. 결과 상세는 /var/adm/sw/swagent.log 에 남습니다.",
      "syntax": [
        "swverify {{SOFTWARE}}",
        "swverify \\*"
      ],
      "options": [
        { "flag": "-d", "desc": "depot 을 검증" },
        { "flag": "-x {{OPTION}}={{VALUE}}", "desc": "검증 동작 옵션" }
      ],
      "examples": [
        { "title": "특정 제품 검증", "command": "swverify {{PRODUCT}}\ntail -50 /var/adm/sw/swagent.log" },
        { "title": "전체 검증 (시간이 오래 걸림)", "command": "swverify \\* > /var/tmp/swverify.out 2>&1" }
      ],
      "cautions": [
        "설정 파일처럼 설치 후 바뀌는 것이 정상인 파일도 경고로 나옵니다. 경고 내용을 보고 판단하세요."
      ],
      "help": "man swverify",
      "keywords": ["무결성 검증", "swverify", "설치 검증", "변조 점검", "의존성"],
      "related": ["hpux-swlist", "hpux-swinstall"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-swcopy",
      "name": "swcopy",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.offline",
      "platforms": ["hpux"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "소프트웨어·패치를 로컬 depot 으로 복사 (폐쇄망 설치용)",
      "description": "DVD, .depot 파일, 다른 서버의 depot 에서 소프트웨어를 지정한 디렉토리 depot 으로 복사합니다. 여러 패치를 하나의 depot 에 모아 두고 여러 서버가 네트워크로 swinstall 하게 하는 폐쇄망 환경의 기본 방식입니다.",
      "syntax": [
        "swcopy -s {{SOURCE}} {{SOFTWARE}} @ {{DEPOT_DIR}}"
      ],
      "options": [
        { "flag": "-s {{SOURCE}}", "desc": "원본 (DVD 마운트 경로, .depot 파일, host:/path)" },
        { "flag": "-p", "desc": "미리보기" },
        { "flag": "-x enforce_dependencies=false", "desc": "의존 소프트웨어 없이도 복사" }
      ],
      "examples": [
        {
          "title": "개별 패치를 하나의 depot 으로 모으기",
          "steps": [
            { "prompt": "#", "cmd": "cd /var/tmp/patches", "desc": "HPE 에서 받은 패치 파일 위치" },
            { "prompt": "#", "cmd": "sh {{PATCH_ID}}", "desc": "shar 형식 패치를 풀어 {{PATCH_ID}}.depot 생성 (이미 .depot 이면 생략)" },
            { "prompt": "#", "cmd": "swcopy -s /var/tmp/patches/{{PATCH_ID}}.depot \\* @ /var/depot/{{DEPOT_NAME}}", "desc": "통합 depot 으로 복사" },
            { "prompt": "#", "cmd": "swlist -d @ /var/depot/{{DEPOT_NAME}}", "desc": "depot 내용 확인" }
          ]
        }
      ],
      "cautions": [
        "depot 디렉토리 용량을 미리 확인하세요(bdf). OE 전체 복사는 수 GB 가 필요합니다.",
        "원격 서버가 이 depot 을 쓰려면 depot 이 등록돼 있어야 합니다(swreg -l depot {{DEPOT_DIR}})."
      ],
      "help": "man swcopy · man swreg",
      "keywords": ["depot 생성", "swcopy", "폐쇄망 설치", "패치 저장소", "로컬 저장소", "swreg"],
      "related": ["hpux-swinstall", "hpux-swlist", "hpux-swremove"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-show-patches",
      "name": "show_patches",
      "kind": "command",
      "shell": "sh",
      "category": "package",
      "task": "package.update",
      "platforms": ["hpux"],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "현재 활성(대체되지 않은) 패치 목록",
      "description": "설치된 패치 중 다른 패치에 의해 대체(supersede)되지 않고 실제로 적용 중인 패치를 패치 ID 와 설명으로 보여 줍니다. swlist 로 보면 대체된 패치까지 섞여 나오므로 현재 패치 수준을 정리할 때 편합니다.",
      "syntax": [
        "/usr/contrib/bin/show_patches"
      ],
      "options": [],
      "examples": [
        { "title": "활성 패치 목록 저장", "command": "/usr/contrib/bin/show_patches > /var/tmp/patches_$(hostname).txt" },
        { "title": "특정 패치 적용 여부 확인", "command": "/usr/contrib/bin/show_patches | grep {{PATCH_ID}}" }
      ],
      "cautions": [],
      "help": "/usr/contrib/bin/show_patches -h",
      "keywords": ["패치 목록", "show_patches", "적용 패치", "패치 수준", "supersede"],
      "related": ["hpux-swlist", "hpux-swinstall"],
      "review": { "status": "ai-draft", "note": "옵션은 버전별 차이 가능, 기본 사용법만 기재" }
    }
  ]
}
