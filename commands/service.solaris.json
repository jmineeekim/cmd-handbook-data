          "type": "directive",
          "items": [
            {
              "cmd": "/var/adm/messages",
              "desc": "현재 시스템 로그"
            },
            {
              "cmd": "/var/adm/messages.0, .1 …",
              "desc": "순환된 이전 로그 (숫자가 클수록 오래됨)"
            },
            {
