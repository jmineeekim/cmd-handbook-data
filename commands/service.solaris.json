{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "service",
  "commands": [
    {
      "id": "solaris-svcs",
      "name": "svcs",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "solaris"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SMF 서비스 상태 조회·장애 원인 설명",
      "description": "SMF(Service Management Facility)에 등록된 서비스의 상태를 조회합니다. svcs -xv 는 정상 동작하지 않는 서비스와 그 원인, 로그 파일 위치, 영향받는 서비스를 설명해 주므로 장애 확인의 출발점입니다. 서비스는 svc:/network/ssh:default 같은 FMRI 로 표시되며 줄여서 ssh 처럼 써도 됩니다.",
      "syntax": [
        "svcs [-a] [-H] [-o {{COLUMNS}}] [{{FMRI}}]",
        "svcs -x [-v] [{{FMRI}}]",
        "svcs -l | -d | -D | -p {{FMRI}}"
      ],
      "options": [
        {
          "flag": "-a",
          "desc": "disabled 포함 모든 서비스 (기본은 enabled 이거나 문제 있는 것만)"
        },
        {
          "flag": "-x",
          "desc": "문제 있는 서비스와 원인 설명"
        },
        {
          "flag": "-v",
          "desc": "-x 와 함께: 상세 설명·로그 위치·참고 문서"
        },
        {
          "flag": "-l {{FMRI}}",
          "desc": "서비스 상세 (상태, 로그 파일, 의존성)"
        },
        {
          "flag": "-d {{FMRI}}",
          "desc": "이 서비스가 의존하는 서비스"
        },
        {
          "flag": "-D {{FMRI}}",
          "desc": "이 서비스에 의존하는 서비스"
        },
        {
          "flag": "-p {{FMRI}}",
          "desc": "서비스에 속한 프로세스(PID) 표시"
        },
        {
          "flag": "-L {{FMRI}}",
          "desc": "서비스 로그 파일 경로 출력 (Solaris 11 이상)"
        },
        {
          "flag": "-o state,stime,fmri",
          "desc": "출력 열 지정"
        },
        {
          "flag": "-H",
          "desc": "헤더 생략 (스크립트용)"
        }
      ],
      "commandGroups": [
        {
          "title": "SMF 서비스 상태 (STATE 열)",
          "type": "directive",
          "items": [
            {
              "cmd": "online",
              "desc": "정상 실행 중"
            },
            {
              "cmd": "offline",
              "desc": "enabled 이지만 의존 서비스가 준비되지 않아 대기 중 (svcs -d 로 의존 서비스 확인)"
            },
            {
              "cmd": "disabled",
              "desc": "관리자가 비활성화함"
            },
            {
              "cmd": "maintenance",
              "desc": "시작 실패·반복 종료로 SMF 가 중지시킴. 원인 해결 후 svcadm clear 필요"
            },
            {
              "cmd": "degraded",
              "desc": "실행 중이지만 성능·기능이 일부 저하"
            },
            {
              "cmd": "legacy_run",
              "desc": "SMF 가 아닌 /etc/rc*.d 스크립트로 시작된 레거시 서비스 (상태 관리 불가)"
            },
            {
              "cmd": "uninitialized",
              "desc": "아직 설정을 읽지 않은 상태 (부팅 중 잠깐 보임)"
            },
            {
              "cmd": "online*",
              "desc": "* 표시는 상태 전환 중 (예: 시작 중)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "문제 있는 서비스 확인 (아무것도 안 나오면 정상)",
          "command": "svcs -xv"
        },
        {
          "title": "장애 서비스 복구",
          "steps": [
            {
              "prompt": "#",
              "cmd": "svcs -xv",
              "desc": "maintenance 서비스와 원인, 로그 파일 경로 확인"
            },
            {
              "prompt": "#",
              "cmd": "tail -50 $(svcs -L {{FMRI}})",
              "desc": "서비스 로그 확인 (Solaris 10 은 svcs -l 의 logfile 경로, 보통 /var/svc/log/)"
            },
            {
              "prompt": "#",
              "cmd": "vi {{CONFIG_FILE}}",
              "desc": "로그에 나온 원인(설정 오류, 포트 충돌 등) 수정"
            },
            {
              "prompt": "#",
              "cmd": "svcadm clear {{FMRI}}",
              "desc": "maintenance 해제 → SMF 가 다시 시작"
            },
            {
              "prompt": "#",
              "cmd": "svcs {{FMRI}}",
              "desc": "online 이 되었는지 확인"
            }
          ]
        },
        {
          "title": "서비스 상세와 프로세스",
          "command": "svcs -l ssh\nsvcs -p ssh"
        },
        {
          "title": "online 이 아닌 서비스만 보기",
          "command": "svcs -a -H -o state,fmri | grep -v -e '^online' -e '^disabled' -e '^legacy_run'"
        }
      ],
      "cautions": [
        "offline 상태는 대부분 의존 서비스 문제입니다. 해당 서비스를 계속 재시작하지 말고 svcs -xv 가 가리키는 원인 서비스를 먼저 해결하세요."
      ],
      "platformNotes": {
        "solaris": "Solaris 10 이상. Linux 의 systemctl status / list-units 에 해당합니다. 서비스 로그는 /var/svc/log/<FMRI 를 - 로 바꾼 이름>.log 입니다."
      },
      "help": "man svcs · man smf",
      "keywords": [
        "서비스 상태",
        "SMF",
        "maintenance",
        "svcs -xv",
        "svcs",
        "service status",
        "FMRI"
      ],
      "related": [
        "solaris-svcadm",
        "solaris-svccfg",
        "solaris-svcprop",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-svcadm",
      "name": "svcadm",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "solaris"
      ],
      "level": "basic",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SMF 서비스 시작·중지·재시작·장애 해제",
      "description": "SMF 서비스를 enable(시작+부팅 시 자동 시작), disable(중지+자동 시작 해제), restart, refresh(설정 다시 읽기)하고 maintenance 상태를 clear 로 해제합니다. enable/disable 은 기본적으로 영구 설정이며, -t 를 붙이면 재부팅 전까지만 적용됩니다.",
      "syntax": [
        "svcadm enable [-r] [-s] [-t] {{FMRI}}",
        "svcadm disable [-s] [-t] {{FMRI}}",
        "svcadm restart | refresh | clear {{FMRI}}"
      ],
      "options": [
        {
          "flag": "-t",
          "desc": "임시 적용 (재부팅하면 원래 설정으로 돌아감)"
        },
        {
          "flag": "-s",
          "desc": "상태가 바뀔 때까지 기다렸다가 종료 (스크립트용)"
        },
        {
          "flag": "-r",
          "desc": "enable 시 의존하는 서비스도 함께 enable"
        },
        {
          "flag": "-v",
          "desc": "처리 내용 출력"
        }
      ],
      "commandGroups": [
        {
          "title": "서브 명령",
          "type": "subcommand",
          "items": [
            {
              "cmd": "svcadm enable {{FMRI}}",
              "desc": "시작 + 부팅 시 자동 시작"
            },
            {
              "cmd": "svcadm disable {{FMRI}}",
              "desc": "중지 + 자동 시작 해제"
            },
            {
              "cmd": "svcadm restart {{FMRI}}",
              "desc": "재시작 (online 상태일 때만)"
            },
            {
              "cmd": "svcadm refresh {{FMRI}}",
              "desc": "svccfg 로 바꾼 설정을 반영 (서비스에 따라 재시작 효과)"
            },
            {
              "cmd": "svcadm clear {{FMRI}}",
              "desc": "maintenance / degraded 상태 해제"
            },
            {
              "cmd": "svcadm mark maintenance {{FMRI}}",
              "desc": "서비스를 강제로 maintenance 로 표시 (점검 중 자동 재시작 방지)"
            },
            {
              "cmd": "svcadm milestone {{MILESTONE}}",
              "desc": "마일스톤 전환 (예: svc:/milestone/single-user:default, all)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "서비스 재시작 후 상태 확인",
          "command": "svcadm restart {{FMRI}}\nsvcs {{FMRI}}"
        },
        {
          "title": "maintenance 서비스 복구",
          "command": "svcs -xv {{FMRI}}\nsvcadm clear {{FMRI}}"
        },
        {
          "title": "보안 점검: telnet·ftp 비활성화",
          "command": "svcadm disable svc:/network/telnet:default\nsvcadm disable svc:/network/ftp:default\nsvcs -a | egrep 'telnet|ftp'"
        },
        {
          "title": "설정 변경 반영 (예: DNS 클라이언트)",
          "command": "svcadm refresh svc:/network/dns/client:default\nsvcs dns/client"
        }
      ],
      "cautions": [
        "disable 은 재부팅 후에도 유지됩니다. 점검 중 잠시만 내리려면 disable -t 를 쓰세요.",
        "maintenance 상태에서는 restart 가 동작하지 않습니다. 원인을 고친 뒤 clear 하세요.",
        "ssh 를 restart/disable 하면 원격 세션이 끊길 수 있습니다. 콘솔 접근 경로를 확보하세요."
      ],
      "platformNotes": {
        "solaris": "Solaris 10 이상. Linux 의 systemctl start/stop/enable/disable 을 합친 개념 (enable = start + enable)."
      },
      "help": "man svcadm",
      "keywords": [
        "서비스 시작",
        "서비스 중지",
        "재시작",
        "maintenance 해제",
        "svcadm",
        "clear",
        "SMF"
      ],
      "related": [
        "solaris-svcs",
        "solaris-svccfg",
        "solaris-inetadm",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-svccfg",
      "name": "svccfg",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SMF 서비스 설정(속성) 조회·변경·매니페스트 등록",
      "description": "SMF 저장소의 서비스 속성(property)을 조회·변경하고, 매니페스트(XML)를 import/export 합니다. Solaris 11 에서는 DNS·nsswitch·호스트명·타임존 같은 시스템 설정도 SMF 속성으로 관리되므로 설정 파일 대신 svccfg setprop 후 svcadm refresh 로 반영합니다.",
      "syntax": [
        "svccfg -s {{FMRI}} listprop [{{PG}}]",
        "svccfg -s {{FMRI}} setprop {{PG}}/{{PROP}} = {{TYPE}}: {{VALUE}}",
        "svccfg import | export {{ARG}}"
      ],
      "options": [
        {
          "flag": "-s {{FMRI}}",
          "desc": "작업할 서비스 선택"
        },
        {
          "flag": "-v",
          "desc": "상세 출력"
        }
      ],
      "commandGroups": [
        {
          "title": "서브 명령 (svccfg -s {{FMRI}} …)",
          "type": "subcommand",
          "items": [
            {
              "cmd": "listprop [{{PG}}]",
              "desc": "속성 목록 (속성 그룹 지정 가능)"
            },
            {
              "cmd": "setprop {{PG}}/{{PROP}} = {{TYPE}}: {{VALUE}}",
              "desc": "속성 변경 (type 예: astring, boolean, count, net_address)"
            },
            {
              "cmd": "delprop {{PG}}/{{PROP}}",
              "desc": "속성 삭제"
            },
            {
              "cmd": "listcust",
              "desc": "관리자가 기본값에서 바꾼 항목만 표시",
              "version": "Solaris 11 이상"
            },
            {
              "cmd": "refresh",
              "desc": "변경 사항을 실행 스냅샷에 반영 (svcadm refresh 와 같음)"
            }
          ]
        },
        {
          "title": "매니페스트·백업",
          "type": "subcommand",
          "items": [
            {
              "cmd": "svccfg import {{MANIFEST_XML}}",
              "desc": "사용자 정의 서비스 매니페스트 등록"
            },
            {
              "cmd": "svccfg export {{FMRI}} > {{FILE}}.xml",
              "desc": "서비스 정의를 XML 로 백업"
            },
            {
              "cmd": "svccfg validate {{MANIFEST_XML}}",
              "desc": "매니페스트 문법 검사"
            },
            {
              "cmd": "svccfg delete {{FMRI}}",
              "desc": "서비스 삭제 (먼저 disable)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "DNS 서버 설정 (Solaris 11)",
          "version": "Solaris 11 이상",
          "steps": [
            {
              "prompt": "#",
              "cmd": "svccfg -s network/dns/client listprop config",
              "desc": "현재 설정 확인"
            },
            {
              "prompt": "#",
              "cmd": "svccfg -s network/dns/client setprop config/nameserver = net_address: \\( {{DNS1}} {{DNS2}} \\)",
              "desc": "네임서버 지정 (여러 개는 괄호로)"
            },
            {
              "prompt": "#",
              "cmd": "svccfg -s network/dns/client setprop config/search = astring: {{DOMAIN}}",
              "desc": "검색 도메인"
            },
            {
              "prompt": "#",
              "cmd": "svccfg -s system/name-service/switch setprop config/host = astring: '\"files dns\"'",
              "desc": "호스트 조회 순서 (nsswitch)"
            },
            {
              "prompt": "#",
              "cmd": "svcadm refresh network/dns/client system/name-service/switch",
              "desc": "반영 (/etc/resolv.conf, /etc/nsswitch.conf 가 자동 재생성됨)"
            },
            {
              "prompt": "#",
              "cmd": "svcadm enable network/dns/client",
              "desc": "DNS 클라이언트 활성화"
            }
          ]
        },
        {
          "title": "서비스의 시작 명령 확인",
          "command": "svccfg -s {{FMRI}} listprop start/exec"
        },
        {
          "title": "바꾼 설정만 보기",
          "command": "svccfg -s {{FMRI}} listcust",
          "version": "Solaris 11 이상"
        }
      ],
      "cautions": [
        "Solaris 11 에서 /etc/resolv.conf, /etc/nsswitch.conf 를 직접 고치면 서비스 refresh·재부팅 시 SMF 값으로 덮어써집니다. svccfg 로 바꾸세요.",
        "setprop 만으로는 실행 중인 서비스에 반영되지 않습니다. svcadm refresh 를 해야 합니다.",
        "변경 전 svccfg export {{FMRI}} 로 백업해 두세요."
      ],
      "help": "man svccfg",
      "keywords": [
        "SMF 설정",
        "서비스 속성",
        "setprop",
        "매니페스트",
        "svccfg",
        "DNS 설정",
        "nameserver"
      ],
      "related": [
        "solaris-svcs",
        "solaris-svcadm",
        "solaris-svcprop",
        "etc-resolv-conf"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-svcprop",
      "name": "svcprop",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SMF 서비스 속성 값 읽기 (스크립트용)",
      "description": "SMF 서비스의 속성 값을 읽어 출력합니다. svccfg listprop 과 비슷하지만 읽기 전용이고, 실행 중인(반영된) 값을 보여 주므로 스크립트에서 설정 값을 확인할 때 편합니다.",
      "syntax": [
        "svcprop [-p {{PG}}/{{PROP}}] {{FMRI}}"
      ],
      "options": [
        {
          "flag": "-p {{PG}}/{{PROP}}",
          "desc": "특정 속성(또는 속성 그룹)만 출력"
        },
        {
          "flag": "-c",
          "desc": "실행 스냅샷이 아닌 현재 저장소 값(refresh 전 값) 출력"
        },
        {
          "flag": "-q",
          "desc": "출력 없이 종료 코드로만 존재 여부 확인"
        }
      ],
      "examples": [
        {
          "title": "DNS 네임서버 값 확인",
          "command": "svcprop -p config/nameserver network/dns/client"
        },
        {
          "title": "서비스 전체 속성",
          "command": "svcprop {{FMRI}}"
        },
        {
          "title": "refresh 전후 값 비교",
          "command": "svcprop -c -p {{PG}}/{{PROP}} {{FMRI}}\nsvcprop -p {{PG}}/{{PROP}} {{FMRI}}"
        }
      ],
      "cautions": [],
      "help": "man svcprop",
      "keywords": [
        "SMF 속성",
        "서비스 설정 확인",
        "svcprop",
        "property"
      ],
      "related": [
        "solaris-svccfg",
        "solaris-svcs"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "solaris-inetadm",
      "name": "inetadm",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "solaris"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "inetd 기반 서비스(telnet·ftp·rlogin 등) 조회·설정",
      "description": "inetd 가 관리하는 네트워크 서비스(telnet, ftp, rlogin, finger 등)의 상태와 속성을 조회·변경합니다. 금융권 보안 점검에서 불필요한 inetd 서비스 비활성화를 확인할 때 많이 씁니다. Solaris 10 이상에서는 /etc/inetd.conf 가 아닌 SMF 로 관리됩니다.",
      "syntax": [
        "inetadm [-l {{FMRI}}]",
        "inetadm -e | -d {{FMRI}}",
        "inetadm -m {{FMRI}} {{PROP}}={{VALUE}}"
      ],
      "options": [
        {
          "flag": "-l {{FMRI}}",
          "desc": "서비스 속성 상세"
        },
        {
          "flag": "-e {{FMRI}}",
          "desc": "서비스 활성화"
        },
