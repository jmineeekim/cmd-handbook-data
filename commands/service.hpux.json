{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "service",
  "commands": [
    {
      "id": "hpux-var-adm-syslog-syslog-log",
      "name": "/var/adm/syslog/syslog.log",
      "kind": "file",
      "category": "service",
      "task": "service.logs",
      "platforms": [
        "hpux"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "HP-UX 기본 시스템 로그 (Linux 의 messages)",
      "description": "HP-UX 의 syslogd 가 기록하는 기본 시스템 로그입니다. 커널·디스크·LVM·네트워크·Serviceguard·로그인 관련 메시지가 대부분 여기 남습니다. 부팅할 때마다 이전 로그는 OLDsyslog.log 로 옮겨지므로 재부팅 전 장애 기록은 OLDsyslog.log 에서 찾습니다. 기록 규칙은 /etc/syslog.conf 에 있습니다.",
      "syntax": [
        "/var/adm/syslog/syslog.log",
        "/var/adm/syslog/OLDsyslog.log"
      ],
      "options": [],
      "examples": [
        {
          "title": "실시간 로그 보기",
          "command": "tail -f /var/adm/syslog/syslog.log"
        },
        {
          "title": "디스크·LVM 오류 찾기",
          "command": "grep -i -E 'lvm|disk|scsi|error' /var/adm/syslog/syslog.log | tail -50"
        },
        {
          "title": "재부팅 전 마지막 기록 확인",
          "command": "tail -100 /var/adm/syslog/OLDsyslog.log"
        },
        {
          "title": "syslog.conf 수정 후 다시 읽기",
          "command": "cp -p /etc/syslog.conf /etc/syslog.conf.bak\nvi /etc/syslog.conf\nkill -HUP $(cat /var/run/syslog.pid)"
        }
      ],
      "cautions": [
        "syslog.log 는 자동 순환되지 않고 재부팅 때만 OLDsyslog.log 로 옮겨집니다. 오래 켜 둔 서버는 크기가 커지므로 cron 으로 보관·정리 정책을 두세요(감사 기준 보존 기간 확인).",
        "syslog.conf 는 선택자와 동작 사이를 탭으로 구분해야 합니다."
      ],
      "help": "man syslogd · man syslog.conf",
      "keywords": [
        "시스템 로그",
        "syslog.log",
        "OLDsyslog",
        "HP-UX 로그",
        "messages",
        "장애 로그"
      ],
      "related": [
        "hpux-etc-rc-log",
        "hpux-var-opt-resmon-log-event-log",
        "tail",
        "grep",
        "var-log-messages"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-sbin-init-d",
      "name": "/sbin/init.d",
      "kind": "file",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "hpux"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "서비스 시작·종료 스크립트 위치 (start/stop)",
      "description": "HP-UX 의 서비스 제어 스크립트가 있는 디렉토리입니다. 각 스크립트는 start·stop 인자를 받으며, /sbin/rcN.d 의 S(시작)·K(종료) 링크를 통해 런레벨 전환 때 순서대로 실행됩니다. 부팅 시 실행 여부는 /etc/rc.config.d 의 설정 변수로 정합니다. systemctl 이 없는 HP-UX 의 서비스 관리 방식입니다.",
      "syntax": [
        "/sbin/init.d/{{SERVICE}} start|stop"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "구성 요소",
          "type": "directive",
          "items": [
            {
              "cmd": "/sbin/init.d/{{SERVICE}}",
              "desc": "실제 스크립트 (start, stop, start_msg, stop_msg 인자 처리)"
            },
            {
              "cmd": "/sbin/rc3.d/S{{NNN}}{{SERVICE}}",
              "desc": "런레벨 3 진입 시 시작 링크 (번호 작은 순서로 실행)"
            },
            {
              "cmd": "/sbin/rc2.d/K{{NNN}}{{SERVICE}}",
              "desc": "런레벨을 내릴 때 종료 링크 (보통 시작 런레벨보다 한 단계 아래)"
            },
            {
              "cmd": "/etc/rc.config.d/{{SERVICE}}",
              "desc": "부팅 시 시작 여부 변수 (예: =1 켬, =0 끔)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "서비스 재시작 (예: cron)",
          "command": "/sbin/init.d/cron stop\n/sbin/init.d/cron start\nps -ef | grep cron"
        },
        {
          "title": "NTP 데몬 재시작",
          "command": "/sbin/init.d/xntpd stop\n/sbin/init.d/xntpd start"
        },
        {
          "title": "어떤 순서로 시작되는지 확인",
          "command": "ls /sbin/rc2.d /sbin/rc3.d\nwho -r"
        },
        {
          "title": "애플리케이션 자동 시작 스크립트 등록",
          "steps": [
            {
              "prompt": "#",
              "cmd": "cp /sbin/init.d/template /sbin/init.d/{{APP}}",
              "desc": "기본 템플릿 복사 후 start/stop 부분 작성"
            },
            {
              "prompt": "#",
              "cmd": "vi /etc/rc.config.d/{{APP}}",
              "desc": "시작 여부 변수 작성 (예: APP_START=1)"
            },
            {
              "prompt": "#",
              "cmd": "ln -s /sbin/init.d/{{APP}} /sbin/rc3.d/S900{{APP}}",
              "desc": "런레벨 3 시작 링크"
            },
            {
              "prompt": "#",
              "cmd": "ln -s /sbin/init.d/{{APP}} /sbin/rc2.d/K100{{APP}}",
              "desc": "종료 링크"
            },
            {
              "prompt": "#",
              "cmd": "/sbin/init.d/{{APP}} start",
              "desc": "수동 실행으로 검증 (결과는 재부팅 후 /etc/rc.log 에서도 확인)"
            }
          ]
        }
      ],
      "cautions": [
        "네트워크(/sbin/init.d/net) 같은 핵심 스크립트를 원격 세션에서 stop 하면 접속이 끊깁니다. 콘솔에서 하세요.",
        "Serviceguard 가 관리하는 애플리케이션은 init 스크립트로 자동 시작하지 말고 패키지로 관리합니다.",
        "/sbin/init.d/template 의 존재와 형식은 환경에 따라 다를 수 있으니 기존 스크립트를 참고해 작성하세요."
      ],
      "help": "man rc · man rc.config",
      "keywords": [
        "서비스 시작",
        "서비스 재시작",
        "init.d",
        "rc 스크립트",
        "자동 시작",
        "런레벨",
        "start stop"
      ],
      "related": [
        "hpux-etc-rc-config-d",
        "hpux-etc-rc-log",
        "service",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-etc-rc-config-d",
      "name": "/etc/rc.config.d",
      "kind": "file",
      "category": "service",
      "task": "service.manage",
      "platforms": [
        "hpux"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "부팅 시 서비스 켜기·끄기 설정 변수 디렉토리",
      "description": "부팅 때 /sbin/init.d 스크립트가 읽는 설정 파일 모음입니다. 서비스별 파일에 VAR=1(사용)·VAR=0(사용 안 함) 형태로 시작 여부와 인자를 적습니다. Linux 의 systemctl enable/disable 에 해당하는 역할이며, 네트워크 주소(netconf)도 여기 있습니다.",
      "syntax": [
        "/etc/rc.config.d/{{FILE}}"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "자주 쓰는 파일과 변수",
          "type": "directive",
          "items": [
            {
              "cmd": "netconf: HOSTNAME, INTERFACE_NAME[0], IP_ADDRESS[0] …",
              "desc": "호스트명·IP·라우팅"
            },
            {
              "cmd": "nfsconf: NFS_CLIENT=1, NFS_SERVER=1",
              "desc": "NFS 클라이언트·서버 시작 여부"
            },
            {
              "cmd": "netdaemons: XNTPD=1",
              "desc": "NTP 데몬(xntpd) 시작 여부"
            },
            {
              "cmd": "mailservs: SENDMAIL_SERVER=1",
              "desc": "sendmail 데몬 시작 여부 (불필요하면 0)"
            },
            {
              "cmd": "cmcluster: AUTOSTART_CMCLD=1",
              "desc": "부팅 시 Serviceguard 클러스터 자동 참여"
            },
            {
              "cmd": "nddconf: TRANSPORT_NAME[0], NDD_NAME[0], NDD_VALUE[0]",
              "desc": "부팅 시 적용할 ndd 네트워크 파라미터"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "켜져 있는 서비스 변수 찾기",
          "command": "grep -E '^[A-Z_]+=1' /etc/rc.config.d/*"
        },
        {
          "title": "불필요 서비스(sendmail) 부팅 시 끄기 (보안 점검)",
          "command": "cp -p /etc/rc.config.d/mailservs /etc/rc.config.d/mailservs.bak\nvi /etc/rc.config.d/mailservs\n/sbin/init.d/sendmail stop",
          "note": "SENDMAIL_SERVER=0 으로 바꾸고 현재 실행 중인 데몬은 stop 으로 멈춥니다."
        }
      ],
      "cautions": [
        "파일은 셸 스크립트로 읽히므로 문법 오류(따옴표 누락 등)가 있으면 부팅 때 해당 서비스가 시작되지 않습니다. 수정 후 sh -n {{FILE}} 으로 문법을 점검하세요.",
        "변수 변경은 다음 부팅 또는 해당 init.d 스크립트를 다시 실행해야 반영됩니다."
      ],
      "help": "man rc.config",
      "keywords": [
        "서비스 자동 시작",
        "rc.config.d",
        "부팅 설정",
        "enable",
        "disable",
        "netconf",
        "nfsconf"
      ],
      "related": [
        "hpux-sbin-init-d",
        "hpux-etc-rc-config-d-netconf",
        "hpux-ndd",
        "hpux-etc-rc-log"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-etc-rc-log",
      "name": "/etc/rc.log",
      "kind": "file",
      "category": "service",
      "task": "service.logs",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "부팅·종료 시 시작 스크립트 실행 결과 로그",
      "description": "부팅과 런레벨 전환 때 /sbin/init.d 스크립트가 출력한 결과가 기록됩니다. 각 서비스가 OK, FAIL, N/A 중 무엇으로 끝났는지 볼 수 있어 재부팅 후 서비스가 안 올라올 때 가장 먼저 확인합니다. 이전 부팅 기록은 /etc/rc.log.old 에 있고, 종료·재부팅 이력은 /etc/shutdownlog 에 남습니다.",
      "syntax": [
        "/etc/rc.log",
        "/etc/rc.log.old"
      ],
      "options": [],
      "examples": [
        {
          "title": "실패한 시작 스크립트 찾기",
          "command": "grep -n -i fail /etc/rc.log\nmore /etc/rc.log"
        },
        {
          "title": "최근 종료·재부팅 이력",
          "command": "tail -20 /etc/shutdownlog"
        }
      ],
      "cautions": [],
      "help": "man rc",
      "keywords": [
        "부팅 로그",
        "rc.log",
        "시작 스크립트 실패",
        "shutdownlog",
        "재부팅 이력"
      ],
      "related": [
        "hpux-sbin-init-d",
        "hpux-var-adm-syslog-syslog-log",
        "hpux-shutdown"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-var-opt-resmon-log-event-log",
      "name": "/var/opt/resmon/log/event.log",
      "kind": "file",
      "category": "service",
      "task": "service.hw-errors",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "EMS 하드웨어 모니터 이벤트 로그",
      "description": "EMS(Event Monitoring Service) 하드웨어 모니터가 감지한 디스크·메모리·CPU·전원·팬 등 하드웨어 이벤트가 심각도와 함께 기록됩니다. 하드웨어 장애 의심 시 syslog.log 와 함께 HPE 에 제출하는 주요 자료입니다. 모니터 설정은 /etc/opt/resmon/lbin/monconfig 로 확인합니다.",
      "syntax": [
        "/var/opt/resmon/log/event.log"
      ],
      "options": [],
      "examples": [
        {
          "title": "최근 하드웨어 이벤트 확인",
          "command": "tail -100 /var/opt/resmon/log/event.log"
        },
        {
          "title": "심각한 이벤트만 찾기",
          "command": "grep -i -E 'critical|serious|major' /var/opt/resmon/log/event.log"
        }
      ],
      "cautions": [
        "11i v3 최신 환경에서 System Fault Management(SFM, WBEM 기반)를 쓰는 경우 이벤트는 evweb 등 SFM 도구로도 조회합니다. 서버 구성에 따라 이 파일이 갱신되지 않을 수 있습니다."
      ],
      "help": "man monconfig",
      "keywords": [
        "하드웨어 장애",
        "EMS",
        "event.log",
        "하드웨어 로그",
        "resmon",
        "디스크 장애"
      ],
      "related": [
        "hpux-cstm",
        "hpux-var-adm-syslog-syslog-log",
        "hpux-ioscan"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-cstm",
      "name": "cstm",
      "kind": "command",
      "shell": "sh",
      "category": "service",
      "task": "service.hw-errors",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "STM 진단 도구(명령행) — CPU·메모리·디스크 정보·오류 로그",
      "description": "Support Tools Manager(STM) 의 명령행 버전으로, 하드웨어 장치 목록을 보고 장치별 정보(info)와 오류 로그(infolog)를 수집합니다. 메모리 오류 이력, CPU·디스크 펌웨어 정보 확인에 씁니다. 대화형(cstm>)으로 쓰거나 echo 로 명령을 넘겨 한 번에 실행합니다.",
      "syntax": [
        "cstm",
        "echo \"{{CSTM_COMMANDS}}\" | cstm"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "주요 내부 명령",
          "type": "interactive",
          "prompt": "cstm>",
          "items": [
            {
              "cmd": "map",
              "desc": "장치 목록과 번호·하드웨어 경로"
            },
            {
              "cmd": "selclass qualifier {{CLASS}}",
              "desc": "장치 종류로 선택 (cpu, memory 등)"
            },
            {
              "cmd": "sel path {{HW_PATH}}",
              "desc": "하드웨어 경로로 장치 선택"
            },
            {
              "cmd": "selall",
              "desc": "모든 장치 선택"
            },
            {
              "cmd": "info",
              "desc": "선택한 장치의 정보 수집 실행"
            },
            {
              "cmd": "wait",
              "desc": "실행 중인 작업이 끝날 때까지 대기"
            },
            {
              "cmd": "infolog",
              "desc": "수집 결과 보기 (메모리 오류 이력 등 포함)"
            },
            {
              "cmd": "help",
              "desc": "명령 목록"
            },
            {
              "cmd": "exit",
              "desc": "종료"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "메모리 정보·오류 이력 수집",
          "command": "echo \"selclass qualifier memory;info;wait;infolog\" | cstm > /var/tmp/mem_info.txt"
        },
        {
          "title": "CPU 정보 수집",
          "command": "echo \"selclass qualifier cpu;info;wait;infolog\" | cstm"
        },
        {
          "title": "대화형으로 디스크 정보 보기",
          "steps": [
            {
              "prompt": "#",
              "cmd": "cstm",
              "desc": "STM 실행"
            },
            {
              "prompt": "cstm>",
              "cmd": "map",
              "desc": "장치 목록 확인"
            },
            {
              "prompt": "cstm>",
              "cmd": "sel path {{HW_PATH}}",
              "desc": "대상 장치 선택"
            },
            {
              "prompt": "cstm>",
              "cmd": "info",
              "desc": "정보 수집"
            },
            {
              "prompt": "cstm>",
              "cmd": "infolog",
              "desc": "결과 확인"
            },
            {
              "prompt": "cstm>",
              "cmd": "exit",
              "desc": "종료"
            }
          ]
        }
      ],
      "cautions": [
        "info·infolog 는 읽기 작업이지만 exercise·verify 같은 진단 실행은 I/O 부하가 있으니 운영 중에는 HPE 지침에 따라서만 하세요.",
        "최신 Integrity 서버(일부 i2 이후 기종)·11i v3 환경에서는 STM 대신 SFM(WBEM) 기반 도구를 쓰도록 바뀌어 일부 장치가 지원되지 않을 수 있습니다."
      ],
      "install": {
        "hpux": {
          "package": "OnlineDiag",
          "preinstalled": true,
          "note": "Online Diagnostics(Support Tools) 번들. OE 설치 시 보통 포함"
        }
      },
      "help": "cstm 실행 후 help · man cstm",
      "keywords": [
        "하드웨어 진단",
        "STM",
        "cstm",
        "메모리 오류",
        "CPU 정보",
        "infolog",
        "Support Tools"
      ],
      "related": [
        "hpux-var-opt-resmon-log-event-log",
        "hpux-machinfo",
        "hpux-ioscan"
      ],
