      "syntax": [
        "cmviewcl [-v]",
        "cmviewcl -v -p {{PKG}}",
        "cmviewcl -l package|node"
      ],
      "options": [
        {
          "flag": "-v",
          "desc": "자세히: 노드별 네트워크, 패키지 서비스·전환 설정"
        },
        {
          "flag": "-p {{PKG}}",
          "desc": "특정 패키지만"
        },
        {
          "flag": "-n {{NODE}}",
          "desc": "특정 노드만"
        },
        {
          "flag": "-l package|node",
          "desc": "패키지 또는 노드 정보만"
        },
        {
          "flag": "-f line",
          "desc": "한 줄 키=값 형식 출력 (스크립트용, 최신 Serviceguard)"
        }
      ],
      "commandGroups": [
        {
          "title": "상태값 의미",
          "type": "directive",
          "items": [
            {
              "cmd": "CLUSTER STATUS up / down",
              "desc": "클러스터 동작 여부"
            },
            {
              "cmd": "NODE STATUS up, STATE running",
              "desc": "노드가 클러스터에 참여 중"
            },
            {
              "cmd": "NODE STATE halted",
              "desc": "노드가 클러스터에서 빠짐 (cmhaltnode 했거나 미참여)"
            },
            {
              "cmd": "PACKAGE STATUS up, STATE running",
              "desc": "패키지 정상 실행 중 (NODE 열이 실행 노드)"
            },
            {
              "cmd": "PACKAGE STATE halted / failed",
              "desc": "중지됨 / 시작·실행 실패 (패키지 로그 확인)"
            },
            {
              "cmd": "AUTO_RUN enabled / disabled",
              "desc": "장애 시 다른 노드로 자동 전환 가능 여부. 수동 중지 후 disabled 로 남는 경우가 많음"
            },
            {
              "cmd": "Node Switching Parameters: SWITCHING enabled",
              "desc": "그 노드에서 패키지 실행 허용 여부"
