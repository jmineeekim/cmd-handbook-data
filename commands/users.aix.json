        { "flag": "-c", "desc": "콜론(:) 구분 형식" }
      ],
      "examples": [
        { "title": "그룹 구성원 확인", "command": "lsgroup -a id users {{GROUP}}" },
        { "title": "전체 그룹의 GID 목록", "command": "lsgroup -a id ALL" }
      ],
      "cautions": [],
      "help": "man lsgroup",
      "keywords": ["그룹 조회", "lsgroup", "그룹 구성원", "GID", "groups"],
      "related": ["aix-mkgroup", "aix-chgroup", "aix-lsuser", "groups"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-chsec",
      "name": "chsec",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.password-policy",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "보안 설정 파일(stanza) 속성 변경",
      "description": "/etc/security 아래 stanza 형식 설정 파일의 속성을 안전하게 바꿉니다. /etc/security/user 의 default stanza 로 전체 비밀번호 정책을, /etc/security/limits 로 자원 제한을, /etc/security/lastlog 로 로그인 실패 횟수를 바꿀 때 씁니다. vi 로 직접 고치는 것보다 형식 오류 위험이 적습니다.",
      "syntax": [
        "chsec -f {{FILE}} -s {{STANZA}} -a {{ATTR}}={{VALUE}} [-a {{ATTR2}}={{VALUE2}}]"
      ],
      "options": [
        { "flag": "-f {{FILE}}", "desc": "대상 파일 (/etc/security/user, limits, login.cfg, lastlog 등)" },
        { "flag": "-s {{STANZA}}", "desc": "stanza 이름 (default, 사용자명, 포트명 등)" },
        { "flag": "-a {{ATTR}}={{VALUE}}", "desc": "바꿀 속성 (여러 개 가능)" }
      ],
      "examples": [
        {
          "title": "전체 비밀번호 정책 강화 (default stanza)",
          "steps": [
            { "prompt": "#", "cmd": "cp -p /etc/security/user /etc/security/user.$(date +%Y%m%d)", "desc": "백업" },
            { "prompt": "#", "cmd": "lssec -f /etc/security/user -s default -a minlen maxage loginretries histsize", "desc": "현재 값 확인" },
            { "prompt": "#", "cmd": "chsec -f /etc/security/user -s default -a minlen=9 -a maxage=12 -a loginretries=5 -a histsize=5", "desc": "정책 변경 (값은 내부 기준에 맞게)" },
            { "prompt": "#", "cmd": "lsuser -a minlen maxage loginretries {{USER}}", "desc": "개별 사용자에 적용된 값 확인 (사용자 stanza 에 따로 지정된 값이 우선)" }
          ]
        },
        { "title": "로그인 실패 횟수 초기화", "command": "chsec -f /etc/security/lastlog -s {{USER}} -a unsuccessful_login_count=0" },
        { "title": "사용자 열린 파일 수 제한 변경", "command": "chsec -f /etc/security/limits -s {{USER}} -a nofiles={{VALUE}}" }
      ],
      "cautions": [
        "default stanza 변경은 개별 값을 지정하지 않은 모든 사용자에게 적용됩니다. root·애플리케이션 계정이 잠기지 않는지 영향을 먼저 확인하세요.",
        "사용자 stanza 에 같은 속성이 있으면 default 보다 우선합니다."
      ],
      "help": "man chsec",
      "keywords": ["보안 설정", "chsec", "비밀번호 정책", "stanza", "default stanza", "loginretries", "minlen"],
      "related": ["aix-lssec", "aix-etc-security-user", "aix-etc-security-limits", "chage"],
      "review": { "status": "ai-draft" }
    },
