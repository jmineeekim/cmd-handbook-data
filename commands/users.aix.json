    {
      "id": "aix-etc-security-user",
      "name": "/etc/security/user",
      "kind": "file",
      "category": "users",
      "task": "users.password-policy",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "AIX 사용자별·기본 계정 보안 정책 파일",
      "description": "사용자별 로그인 허용, su 허용, 잠금, 비밀번호 규칙을 stanza 형식으로 정의하는 파일입니다. default stanza 가 전체 기본값이고, 사용자 이름 stanza 의 값이 우선합니다. 보안 점검(취약점 진단)의 비밀번호 정책 항목 대부분이 이 파일에 있습니다. 편집은 chsec 또는 chuser 를 권장합니다.",
      "syntax": [
        "default:\n        admin = false\n        login = true\n        rlogin = true\n        loginretries = {{COUNT}}\n        maxage = {{WEEKS}}\n        minlen = {{LENGTH}}"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "로그인·권한 관련 속성",
          "type": "directive",
          "items": [
            { "cmd": "login = true|false", "desc": "콘솔 등 직접 로그인 허용" },
            { "cmd": "rlogin = true|false", "desc": "원격(telnet, ssh, rlogin) 로그인 허용. root 는 보통 false" },
            { "cmd": "su = true|false", "desc": "다른 사용자가 이 계정으로 su 할 수 있는지" },
            { "cmd": "sugroups = {{GROUP}}", "desc": "이 계정으로 su 할 수 있는 그룹 제한 (예: root 에 system)" },
            { "cmd": "account_locked = true|false", "desc": "계정 잠금" },
            { "cmd": "loginretries = {{COUNT}}", "desc": "연속 로그인 실패 허용 횟수 (초과 시 잠김, 0 은 제한 없음)" },
            { "cmd": "expires = {{MMDDHHMMYY}}", "desc": "계정 만료 시각 (0 은 만료 없음)" },
            { "cmd": "logintimes = {{TIMES}}", "desc": "로그인 허용 시간대" },
            { "cmd": "umask = {{UMASK}}", "desc": "로그인 시 기본 umask (예: 022, 027)" },
            { "cmd": "SYSTEM = \"compat\"", "desc": "인증 방식 (compat=로컬 파일, LDAP 등)" }
          ]
        },
        {
          "title": "비밀번호 규칙 속성",
          "type": "directive",
          "note": "기간 단위에 주의: maxage·minage·maxexpired 는 주(week), pwdwarntime 은 일(day), histexpire 는 주 단위입니다.",
          "items": [
            { "cmd": "maxage = {{WEEKS}}", "desc": "비밀번호 최대 사용 기간 (주, 0 은 무제한)" },
            { "cmd": "minage = {{WEEKS}}", "desc": "변경 후 다시 바꿀 수 있기까지 최소 기간 (주)" },
            { "cmd": "maxexpired = {{WEEKS}}", "desc": "만료 후 직접 변경 가능한 유예 기간 (주, -1 무제한)" },
            { "cmd": "pwdwarntime = {{DAYS}}", "desc": "만료 전 경고 시작 (일)" },
            { "cmd": "minlen = {{LENGTH}}", "desc": "최소 길이" },
            { "cmd": "minalpha = {{COUNT}}", "desc": "최소 영문자 수" },
            { "cmd": "minother = {{COUNT}}", "desc": "최소 비영문자(숫자·특수문자) 수" },
            { "cmd": "mindigit / minspecialchar / minupperalpha / minloweralpha", "desc": "숫자·특수문자·대문자·소문자 최소 개수" },
            { "cmd": "mindiff = {{COUNT}}", "desc": "이전 비밀번호와 달라야 하는 최소 글자 수" },
            { "cmd": "maxrepeats = {{COUNT}}", "desc": "같은 문자 최대 반복 횟수" },
            { "cmd": "histsize = {{COUNT}}", "desc": "재사용 금지할 이전 비밀번호 개수" },
            { "cmd": "histexpire = {{WEEKS}}", "desc": "이전 비밀번호 재사용 금지 기간 (주)" }
          ]
        }
      ],
      "examples": [
        { "title": "root 원격 로그인 금지·su 그룹 제한", "command": "cp -p /etc/security/user /etc/security/user.bak\nchuser rlogin=false sugroups=system root\nlsuser -a rlogin sugroups root", "note": "root 로 직접 SSH 접속 중인 운영 절차가 있다면 먼저 일반 계정 + su 로 바꿔 두세요. sshd 의 PermitRootLogin 설정도 함께 확인합니다." },
        { "title": "현재 기본 정책 확인", "command": "lssec -f /etc/security/user -s default -a maxage -a minlen -a loginretries -a histsize" }
      ],
      "cautions": [
        "default 의 loginretries·maxage 를 강화하면 비밀번호를 오래 안 바꾼 애플리케이션 계정이 잠길 수 있습니다. 적용 전 대상 계정에 예외 값을 지정하세요.",
        "형식을 깨뜨리면 로그인이 안 될 수 있습니다. 직접 편집하지 말고 chsec·chuser 를 쓰고, 열린 root 세션을 유지한 채 다른 창에서 로그인 테스트를 하세요."
      ],
      "help": "man user (파일 형식) · man chsec",
      "keywords": ["비밀번호 정책", "계정 정책", "security/user", "loginretries", "maxage", "minlen", "rlogin", "취약점 진단"],
      "related": ["aix-chsec", "aix-lssec", "aix-chuser", "aix-etc-security-passwd", "chage", "etc-security-limits-conf"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-etc-security-passwd",
      "name": "/etc/security/passwd",
      "kind": "file",
      "category": "users",
      "task": "users.password-policy",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "AIX 암호화 비밀번호 저장 파일 (shadow 역할)",
      "description": "AIX 에서 Linux 의 /etc/shadow 역할을 하는 파일로, 사용자별 암호화 비밀번호와 마지막 변경 시각(lastupdate), 플래그(ADMCHG 등)를 stanza 형식으로 저장합니다. root 만 읽을 수 있으며 직접 편집하지 않고 passwd·pwdadm 으로 관리합니다. /etc/passwd 의 두 번째 필드는 '!' 로 표시됩니다.",
      "syntax": [
        "{{USER}}:\n        password = ...\n        lastupdate = {{EPOCH}}\n        flags = {{FLAGS}}"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "stanza 항목",
          "type": "directive",
          "items": [
            { "cmd": "password", "desc": "암호화된 비밀번호. * 이면 비밀번호 로그인 불가" },
            { "cmd": "lastupdate", "desc": "마지막 비밀번호 변경 시각 (epoch 초). maxage 계산 기준" },
            { "cmd": "flags = ADMCHG", "desc": "관리자가 설정함 → 다음 로그인 때 변경 강제" },
            { "cmd": "flags = ADMIN", "desc": "root 만 이 사용자의 비밀번호를 바꿀 수 있음" },
            { "cmd": "flags = NOCHECK", "desc": "비밀번호 규칙 검사 생략 (사용 비권장)" }
          ]
        }
      ],
      "examples": [
        { "title": "파일 권한 점검 (보안 진단 항목)", "command": "ls -l /etc/security/passwd", "note": "소유자 root, 그룹 security, 권한 600 수준이어야 합니다." },
        { "title": "비밀번호 마지막 변경 시각·플래그 확인 (파일을 직접 열지 않고)", "command": "pwdadm -q {{USER}}" },
        { "title": "비밀번호 해시 알고리즘 설정 확인", "command": "lssec -f /etc/security/login.cfg -s usw -a pwd_algorithm", "note": "값이 없으면 기존 crypt 방식입니다. ssha256 등으로 바꾸면 이후 변경되는 비밀번호부터 적용됩니다." }
      ],
      "cautions": [
        "이 파일을 직접 편집하거나 다른 서버에서 복사하면 로그인 불가·인증 우회 같은 심각한 문제가 생길 수 있습니다. passwd·pwdadm 만 사용하세요.",
        "파일 내용(해시)을 화면 캡처·메일 등으로 외부에 공유하지 마세요."
      ],
      "help": "man passwd (파일 형식: /etc/security/passwd)",
      "keywords": ["shadow", "비밀번호 파일", "security/passwd", "ADMCHG", "lastupdate", "pwd_algorithm"],
      "related": ["aix-pwdadm", "aix-etc-security-user", "passwd"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-aclget",
      "name": "aclget",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.acl",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "파일·디렉토리의 ACL 조회",
      "description": "파일의 접근 제어 목록(ACL)을 보여 줍니다. AIX 는 기본 AIXC 형식과 JFS2(EAv2)·NFS4 에서 쓰는 NFS4 형식 ACL 을 지원하며 aclget 은 해당 파일의 형식에 맞춰 출력합니다. -o 로 파일에 저장해 aclput 으로 다른 파일에 적용할 수 있습니다.",
      "syntax": [
        "aclget [-o {{OUTPUT_FILE}}] {{FILE}}"
      ],
      "options": [
        { "flag": "-o {{OUTPUT_FILE}}", "desc": "ACL 을 파일로 저장" }
      ],
      "examples": [
        { "title": "ACL 확인", "command": "aclget {{FILE}}" },
        { "title": "한 파일의 ACL 을 다른 파일에 그대로 복사", "command": "aclget {{SOURCE_FILE}} | aclput {{TARGET_FILE}}" },
        { "title": "파일시스템이 지원하는 ACL 형식 확인", "command": "aclgettypes {{MOUNT_POINT}}" }
      ],
      "cautions": [],
      "help": "man aclget",
      "keywords": ["ACL", "aclget", "접근 제어", "권한 확인", "getfacl", "NFS4 ACL"],
      "related": ["aix-aclput", "getfacl", "chmod"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-aclput",
      "name": "aclput",
      "aliases": ["acledit"],
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.acl",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": false,
      "summary": "파일·디렉토리에 ACL 적용",
      "description": "파일이나 표준입력에서 ACL 정의를 읽어 대상 파일에 적용합니다. 직접 편집하려면 acledit 를 쓰며, EDITOR 환경 변수의 편집기로 열리고 저장하면 적용됩니다.",
      "syntax": [
        "aclput [-i {{INPUT_FILE}}] {{FILE}}",
        "EDITOR=/usr/bin/vi acledit {{FILE}}"
      ],
      "options": [
        { "flag": "-i {{INPUT_FILE}}", "desc": "ACL 정의를 읽을 파일 (생략하면 표준입력)" }
      ],
      "examples": [
        {
          "title": "ACL 을 파일로 받아 수정 후 적용",
          "steps": [
            { "prompt": "$", "cmd": "aclget -o /tmp/acl.txt {{FILE}}", "desc": "현재 ACL 저장 (원복용 백업 겸)" },
            { "prompt": "$", "cmd": "vi /tmp/acl.txt", "desc": "AIXC 형식이면 extended permissions 를 enabled 로 바꾸고 permit/deny 줄 추가 (예: permit rw- u:{{USER}})" },
            { "prompt": "$", "cmd": "aclput -i /tmp/acl.txt {{FILE}}", "desc": "적용" },
            { "prompt": "$", "cmd": "aclget {{FILE}}", "desc": "결과 확인" }
          ]
        },
        { "title": "편집기로 바로 수정", "command": "EDITOR=/usr/bin/vi acledit {{FILE}}" }
      ],
      "cautions": [
        "AIXC ACL 에서 extended permissions 가 disabled 이면 추가한 permit/deny 줄이 적용되지 않습니다.",
        "chmod 로 기본 권한을 바꾸면 확장 ACL 이 비활성화되거나 바뀔 수 있습니다. 변경 후 aclget 으로 다시 확인하세요."
      ],
      "help": "man aclput · man acledit",
      "keywords": ["ACL 설정", "aclput", "acledit", "setfacl", "접근 제어 변경"],
      "related": ["aix-aclget", "setfacl", "chmod"],
      "review": { "status": "ai-draft" }
    }
  ]
