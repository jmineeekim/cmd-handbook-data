      "examples": [
        { "title": "그룹에 사용자 한 명 추가", "command": "chgrpmem -m + {{USER}} {{GROUP}}\nlsgroup -a users {{GROUP}}" },
        { "title": "그룹 구성원 목록 전체 지정", "command": "chgroup users={{USER}},{{USER2}} {{GROUP}}" }
      ],
      "cautions": [
        "chgroup users= 에 기존 구성원을 빠뜨리면 그 사용자는 그룹에서 빠집니다.",
        "GID 를 바꾸면 기존 파일의 그룹 소유권은 숫자로 남습니다."
      ],
      "help": "man chgroup · man chgrpmem",
      "keywords": ["그룹 변경", "chgroup", "chgrpmem", "그룹 구성원 추가", "gpasswd"],
      "related": ["aix-mkgroup", "aix-lsgroup", "aix-chuser"],
      "review": { "status": "ai-draft" }
    },
    {
