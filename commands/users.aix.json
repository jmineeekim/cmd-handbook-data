      "syntax": [
        "mkgroup [-a] [id={{GID}}] [users={{USER}},{{USER2}}] {{GROUP}}"
      ],
      "options": [
        { "flag": "-a", "desc": "관리(administrative) 그룹으로 생성" }
      ],
      "examples": [
        { "title": "GID 를 지정해 그룹 생성", "command": "mkgroup id={{GID}} {{GROUP}}\nlsgroup {{GROUP}}" },
        { "title": "구성원과 함께 생성", "command": "mkgroup id={{GID}} users={{USER}},{{USER2}} {{GROUP}}" }
      ],
      "cautions": [
        "클러스터·NFS 를 쓰는 서버들 사이에서는 같은 그룹의 GID 를 일치시키세요."
      ],
      "help": "man mkgroup",
      "keywords": ["그룹 생성", "mkgroup", "groupadd", "GID"],
      "related": ["aix-chgroup", "aix-lsgroup", "groupadd"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-chgroup",
      "name": "chgroup",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "그룹 속성·구성원 변경",
      "description": "그룹의 GID, 구성원 목록, 관리자를 바꿉니다. users= 는 구성원 목록 전체를 교체하므로, 한 명만 추가·제거할 때는 chgrpmem 을 쓰는 것이 안전합니다.",
      "syntax": [
