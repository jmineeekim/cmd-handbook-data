{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "users",
  "commands": [
    {
      "id": "aix-mkuser",
      "name": "mkuser",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "AIX 사용자 계정 생성 (속성 지정)",
      "description": "AIX 에서 사용자 계정을 만듭니다. Linux 의 useradd 와 달리 속성=값 형식으로 UID·그룹·홈·셸·비밀번호 정책을 함께 지정합니다. 지정하지 않은 속성은 /usr/lib/security/mkuser.default 와 /etc/security/user 의 default stanza 를 따릅니다. 비밀번호는 생성 후 passwd 또는 pwdadm 으로 설정합니다.",
      "syntax": [
        "mkuser [{{ATTR}}={{VALUE}} ...] {{USER}}",
        "mkuser -a {{USER}}"
      ],
      "options": [
        { "flag": "-a", "desc": "관리(administrative) 사용자로 생성 (root 만 속성 변경 가능)" }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 속성",
          "type": "directive",
          "note": "mkuser·chuser 공통. 공백 없이 속성=값 으로 씁니다.",
          "items": [
            { "cmd": "id={{UID}}", "desc": "UID (클러스터·NFS 환경에서는 서버 간 같은 값으로)" },
            { "cmd": "pgrp={{GROUP}}", "desc": "기본(primary) 그룹" },
            { "cmd": "groups={{GROUP}},{{GROUP2}}", "desc": "소속 그룹 목록 (기본 그룹 포함)" },
            { "cmd": "home={{HOME_DIR}}", "desc": "홈 디렉토리" },
            { "cmd": "shell=/usr/bin/ksh", "desc": "로그인 셸 (AIX 기본은 ksh)" },
            { "cmd": "gecos=\"{{COMMENT}}\"", "desc": "설명(이름·부서)" },
            { "cmd": "login=false", "desc": "직접 로그인 금지 (su 로만 전환하는 애플리케이션 계정)" },
            { "cmd": "rlogin=false", "desc": "원격(telnet·ssh 등) 로그인 금지" },
            { "cmd": "maxage={{WEEKS}}", "desc": "비밀번호 최대 사용 기간 (주 단위, 0 은 만료 없음)" },
            { "cmd": "expires={{MMDDHHMMYY}}", "desc": "계정 만료 시각 (0 은 만료 없음)" }
          ]
        }
      ],
      "examples": [
        {
          "title": "운영 계정 생성 후 초기 비밀번호 설정",
          "steps": [
            { "prompt": "#", "cmd": "lsuser -a id ALL | grep {{UID}}", "desc": "같은 UID 를 쓰는 계정이 없는지 확인" },
            { "prompt": "#", "cmd": "mkuser id={{UID}} pgrp={{GROUP}} groups={{GROUP}} home=/home/{{USER}} shell=/usr/bin/ksh gecos=\"{{COMMENT}}\" {{USER}}", "desc": "계정 생성" },
            { "prompt": "#", "cmd": "passwd {{USER}}", "desc": "초기 비밀번호 입력 (첫 로그인 시 변경 요구됨)" },
            { "prompt": "#", "cmd": "lsuser -a id pgrp groups home shell {{USER}}", "desc": "생성 결과 확인" }
          ]
        },
        { "title": "로그인 불가 애플리케이션 계정", "command": "mkuser id={{UID}} pgrp={{GROUP}} login=false rlogin=false {{USER}}" }
      ],
      "cautions": [
        "사용자 이름 길이는 기본 8자로 제한됩니다. 더 길게 쓰려면 chdev -l sys0 -a max_logname={{LENGTH}} 로 늘려야 합니다 (변경 후 재부팅 필요).",
        "root 가 passwd 로 설정한 비밀번호는 ADMCHG 플래그가 붙어 첫 로그인 때 변경을 요구합니다."
      ],
      "help": "man mkuser",
      "keywords": ["사용자 생성", "계정 생성", "mkuser", "useradd", "UID", "AIX 계정"],
      "related": ["aix-chuser", "aix-lsuser", "aix-rmuser", "aix-pwdadm", "useradd"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-chuser",
      "name": "chuser",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "사용자 속성 변경 (잠금 해제, 그룹, 셸, 정책)",
      "description": "사용자 계정 속성을 속성=값 형식으로 바꿉니다. 로그인 실패로 잠긴 계정 해제(unsuccessful_login_count=0), 계정 잠금(account_locked), 그룹·셸 변경, 개별 비밀번호 정책 적용에 씁니다.",
      "syntax": [
        "chuser {{ATTR}}={{VALUE}} [{{ATTR2}}={{VALUE2}} ...] {{USER}}"
      ],
      "options": [],
      "examples": [
        {
          "title": "로그인 실패로 잠긴 계정 풀기",
          "steps": [
            { "prompt": "#", "cmd": "lsuser -a account_locked unsuccessful_login_count loginretries {{USER}}", "desc": "잠금 원인 확인 (실패 횟수가 loginretries 이상이면 잠김)" },
            { "prompt": "#", "cmd": "chuser unsuccessful_login_count=0 {{USER}}", "desc": "실패 횟수 초기화" },
            { "prompt": "#", "cmd": "chuser account_locked=false {{USER}}", "desc": "관리자가 잠근 경우 잠금 해제" },
            { "prompt": "#", "cmd": "lsuser -a account_locked unsuccessful_login_count {{USER}}", "desc": "결과 확인" }
          ]
        },
        { "title": "퇴사자 계정 잠금 (삭제 전 단계)", "command": "chuser account_locked=true login=false rlogin=false {{USER}}" },
        { "title": "보조 그룹 변경", "command": "chuser groups={{GROUP}},{{GROUP2}} {{USER}}", "note": "groups 는 목록 전체를 바꿉니다. 기존 그룹을 빠뜨리지 않도록 lsuser -a groups 로 먼저 확인하세요." }
      ],
      "cautions": [
        "groups= 는 추가가 아니라 교체입니다. 그룹 하나만 추가하려면 chgrpmem -m + {{USER}} {{GROUP}} 을 쓰는 것이 안전합니다.",
        "변경한 속성은 다음 로그인부터 적용됩니다 (이미 로그인한 세션에는 반영되지 않음)."
      ],
      "help": "man chuser",
      "keywords": ["계정 잠금 해제", "chuser", "unlock", "unsuccessful_login_count", "account_locked", "사용자 속성 변경", "usermod"],
      "related": ["aix-lsuser", "aix-mkuser", "aix-pwdadm", "aix-etc-security-user", "usermod"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-lsuser",
      "name": "lsuser",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "사용자 속성 조회 (UID, 그룹, 잠금, 마지막 로그인)",
      "description": "사용자 계정의 속성을 보여 줍니다. -a 로 원하는 속성만 골라 보며, ALL 을 주면 전체 사용자를 조회합니다. 보안 점검에서 잠금 상태, 로그인 실패 횟수, 마지막 로그인 시각(time_last_login, epoch 초)을 확인할 때 씁니다. 일부 속성(로그인 이력 등)은 root 만 볼 수 있습니다.",
      "syntax": [
        "lsuser [-a {{ATTR}} ...] {{USER}} | ALL",
        "lsuser -f {{USER}}"
      ],
      "options": [
        { "flag": "-a {{ATTR}} ...", "desc": "표시할 속성만 지정" },
        { "flag": "-f", "desc": "stanza 형식(속성마다 한 줄)으로 표시" },
        { "flag": "-c", "desc": "콜론(:) 구분 형식 (스크립트용)" }
      ],
      "examples": [
        { "title": "계정 기본 정보", "command": "lsuser -a id pgrp groups home shell {{USER}}" },
        { "title": "모든 계정의 잠금·로그인 실패 횟수 점검", "command": "lsuser -a account_locked unsuccessful_login_count ALL" },
        { "title": "마지막 로그인 시각을 사람이 읽는 형식으로", "command": "lsuser -a time_last_login {{USER}}", "note": "값은 epoch 초입니다. perl -le 'print scalar localtime({{EPOCH}})' 등으로 변환합니다." },
        { "title": "한 사용자의 모든 속성", "command": "lsuser -f {{USER}}" }
      ],
      "cautions": [],
      "help": "man lsuser",
      "keywords": ["사용자 조회", "lsuser", "계정 정보", "마지막 로그인", "time_last_login", "잠금 확인", "id"],
      "related": ["aix-chuser", "aix-lsgroup", "aix-etc-security-lastlog", "id"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-rmuser",
      "name": "rmuser",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "사용자 계정 삭제",
      "description": "사용자 계정을 삭제합니다. -p 를 붙이면 /etc/security/passwd 의 비밀번호 정보 등 인증 정보까지 지웁니다. 홈 디렉토리와 파일은 지우지 않으므로 필요하면 따로 정리합니다.",
      "syntax": [
        "rmuser [-p] {{USER}}"
      ],
      "options": [
        { "flag": "-p", "desc": "비밀번호 등 인증 관련 정보도 함께 삭제" }
      ],
      "examples": [
        {
          "title": "퇴사자 계정 정리",
          "steps": [
            { "prompt": "#", "cmd": "lsuser -a id home {{USER}}", "desc": "UID·홈 디렉토리 기록" },
            { "prompt": "#", "cmd": "ps -fu {{USER}}; crontab -l {{USER}}", "desc": "실행 중인 프로세스·예약 작업 확인" },
            { "prompt": "#", "cmd": "rmuser -p {{USER}}", "desc": "계정 삭제" },
            { "prompt": "#", "cmd": "find / -xdev -user {{UID}} -ls 2>/dev/null | head", "desc": "삭제 후 남은 파일(소유자가 숫자로 보임) 확인" }
          ]
        }
      ],
      "cautions": [
        "애플리케이션 실행 계정을 지우면 서비스가 바로 실패합니다. 삭제 전 chuser account_locked=true 로 일정 기간 잠가 영향을 확인하는 방식을 권장합니다.",
        "같은 UID 를 다른 계정에 다시 쓰면 남은 파일의 소유권이 새 계정으로 넘어갑니다."
      ],
      "help": "man rmuser",
      "keywords": ["계정 삭제", "rmuser", "사용자 삭제", "userdel", "퇴사자"],
      "related": ["aix-chuser", "aix-lsuser", "userdel"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-pwdadm",
      "name": "pwdadm",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.password-policy",
      "platforms": ["aix"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "관리자용 비밀번호 설정·플래그(ADMCHG 등) 관리",
      "description": "관리자(root 또는 security 그룹)가 다른 사용자의 비밀번호를 설정하고 비밀번호 플래그를 관리합니다. pwdadm 으로 설정한 비밀번호에는 ADMCHG 가 붙어 첫 로그인 때 변경을 요구합니다. -c 로 플래그를 지우면 변경 요구 없이 사용할 수 있습니다.",
      "syntax": [
        "pwdadm {{USER}}",
        "pwdadm -q {{USER}}",
        "pwdadm -f {{FLAGS}} {{USER}}",
        "pwdadm -c {{USER}}"
      ],
      "options": [
        { "flag": "-q", "desc": "마지막 변경 시각(lastupdate)과 플래그 조회" },
        { "flag": "-f {{FLAGS}}", "desc": "플래그 설정: ADMCHG(다음 로그인 때 변경 강제), ADMIN(root 만 변경 가능), NOCHECK(비밀번호 규칙 검사 안 함)" },
        { "flag": "-c", "desc": "모든 플래그 제거" }
      ],
      "examples": [
        { "title": "비밀번호 초기화 (첫 로그인 시 변경 요구)", "command": "pwdadm {{USER}}\npwdadm -q {{USER}}" },
        { "title": "애플리케이션 계정 비밀번호를 변경 요구 없이 설정", "command": "pwdadm {{USER}}\npwdadm -c {{USER}}", "note": "보안 정책상 변경 요구를 없애도 되는 계정인지 확인하세요." },
        { "title": "다음 로그인 때 비밀번호 변경 강제", "command": "pwdadm -f ADMCHG {{USER}}" }
      ],
      "cautions": [
        "NOCHECK 는 비밀번호 복잡도·이력 규칙을 건너뜁니다. 금융권 보안 기준 위반이 될 수 있으므로 쓰지 마세요."
      ],
      "help": "man pwdadm",
      "keywords": ["비밀번호 초기화", "pwdadm", "ADMCHG", "비밀번호 변경 강제", "passwd", "비밀번호 플래그"],
      "related": ["passwd", "aix-chuser", "aix-etc-security-passwd", "aix-etc-security-user"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-mkgroup",
      "name": "mkgroup",
      "kind": "command",
      "shell": "sh",
      "category": "users",
      "task": "users.account",
      "platforms": ["aix"],
      "level": "frequent",
