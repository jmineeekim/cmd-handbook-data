{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "disk",
  "commands": [
    {
      "id": "solaris-format",
      "name": "format",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.partition",
      "platforms": ["solaris"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "디스크 목록 확인·슬라이스(파티션) 편집·레이블 작성",
      "description": "Solaris 의 디스크 관리 도구로, 인식된 디스크 목록을 보여 주고 선택한 디스크의 슬라이스(파티션) 테이블을 편집하고 레이블(SMI/VTOC 또는 EFI)을 씁니다. 실행하면 디스크 번호를 고른 뒤 format> 메뉴로 들어가며, partition> 하위 메뉴에서 슬라이스를 수정합니다. 디스크 이름은 c(컨트롤러)t(타깃)d(디스크)s(슬라이스) 형식입니다.",
      "syntax": ["format", "format [-e] [{{DISK}}]", "echo | format"],
      "options": [
        {"flag": "-e", "desc": "전문가 모드 (label 시 SMI/EFI 선택, 2TB 초과 디스크 등)"},
        {"flag": "-d {{DISK}}", "desc": "디스크를 지정해서 바로 시작"}
      ],
      "commandGroups": [
        {"title": "주 메뉴", "type": "interactive", "prompt": "format>", "items": [
          {"cmd": "disk", "desc": "다른 디스크 선택"},
          {"cmd": "partition", "desc": "슬라이스 편집 메뉴로 이동 (partition>)"},
          {"cmd": "verify", "desc": "현재 레이블·슬라이스 정보 확인"},
          {"cmd": "label", "desc": "현재 슬라이스 테이블을 디스크에 기록"},
          {"cmd": "inquiry", "desc": "디스크 제조사·모델·펌웨어 확인"},
          {"cmd": "type", "desc": "디스크 유형 선택 (보통 Auto configure)"},
          {"cmd": "analyze", "desc": "표면 검사 (일부 테스트는 데이터를 덮어씀)"},
          {"cmd": "quit", "desc": "종료"}
        ]},
        {"title": "슬라이스 편집", "type": "interactive", "prompt": "partition>", "note": "SMI(VTOC) 레이블은 0~7 슬라이스를 쓰며 s2(backup)는 디스크 전체를 뜻하므로 수정하지 않습니다.", "items": [
          {"cmd": "print", "desc": "현재 슬라이스 테이블 표시"},
          {"cmd": "0 … 7", "desc": "슬라이스 번호를 입력해 태그·플래그·시작 실린더·크기 지정 (예: 10gb, $ = 남은 전체)"},
          {"cmd": "modify", "desc": "전체 슬라이스를 한 번에 재배치"},
          {"cmd": "label", "desc": "변경 내용을 디스크에 기록 (기록 전까지는 반영 안 됨)"},
          {"cmd": "quit", "desc": "format> 메뉴로 돌아감"}
        ]}
      ],
      "examples": [
        {"title": "디스크 목록만 보고 바로 종료", "command": "echo | format", "note": "번호 입력 대기에서 빈 줄이 들어가 목록만 출력하고 끝납니다."},
        {"title": "새 디스크에 슬라이스 0 을 전체 크기로 만들기", "steps": [
          {"prompt": "#", "cmd": "format", "desc": "실행 후 목록에서 대상 디스크 번호 입력 (디스크 이름 꼭 재확인)"},
          {"prompt": "format>", "cmd": "partition", "desc": "슬라이스 편집 메뉴"},
          {"prompt": "partition>", "cmd": "print", "desc": "현재 구성 확인"},
          {"prompt": "partition>", "cmd": "0", "desc": "슬라이스 0 선택 → tag usr, flag wm, 시작 실린더, 크기 $ 입력"},
          {"prompt": "partition>", "cmd": "label", "desc": "디스크에 기록 (y 확인)"},
          {"prompt": "partition>", "cmd": "quit", "desc": "주 메뉴로"},
          {"prompt": "format>", "cmd": "quit", "desc": "종료 후 newfs 또는 zpool create 진행"}
        ]},
        {"title": "디스크 모델·펌웨어 확인", "steps": [
          {"prompt": "#", "cmd": "format", "desc": "디스크 선택"},
          {"prompt": "format>", "cmd": "inquiry", "desc": "Vendor, Product, Revision 표시"},
          {"prompt": "format>", "cmd": "quit", "desc": "종료"}
        ]}
      ],
      "cautions": [
        "label 은 기존 슬라이스 테이블을 덮어씁니다. 디스크 이름을 잘못 고르면 운영 데이터가 사라질 수 있으므로 작업 전 prtvtoc 로 기존 레이블을 파일로 백업하세요.",
        "사용 중인 슬라이스(마운트, ZFS, SVM, 스왑)는 format 이 경고를 표시합니다. 경고를 무시하고 진행하지 마세요.",
        "ZFS 에 디스크 전체(c1t1d0)를 주면 ZFS 가 EFI 레이블을 자동으로 씁니다. 이 경우 format 으로 따로 나눌 필요가 없습니다."
      ],
      "platformNotes": {"solaris": "Linux 의 fdisk/parted 에 해당. 디스크 장치는 /dev/dsk(블록), /dev/rdsk(raw) 아래 cXtYdZsN 형식."},
      "help": "man format · format> help",
      "keywords": ["디스크 목록", "파티션", "슬라이스", "레이블", "format", "VTOC", "EFI"],
      "related": ["solaris-prtvtoc", "solaris-newfs", "solaris-zpool", "solaris-devfsadm", "fdisk"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-prtvtoc",
      "name": "prtvtoc",
      "aliases": ["fmthard"],
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.partition",
      "platforms": ["solaris"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "디스크 슬라이스 테이블 출력·백업·다른 디스크로 복사",
      "description": "디스크의 레이블(VTOC 또는 EFI)과 슬라이스 테이블을 출력합니다. 출력 결과를 fmthard 에 넘기면 같은 레이아웃을 다른 디스크에 그대로 복사할 수 있어 SVM 미러 디스크 교체·구성에 필수로 씁니다. 작업 전 레이블 백업 용도로도 사용합니다.",
      "syntax": ["prtvtoc /dev/rdsk/{{DISK}}s2", "prtvtoc /dev/rdsk/{{SRC_DISK}}s2 | fmthard -s - /dev/rdsk/{{DST_DISK}}s2"],
      "options": [
        {"flag": "-h", "desc": "헤더 없이 슬라이스 줄만 출력"},
        {"flag": "fmthard -s {{FILE}}", "desc": "파일(또는 - 표준입력)의 슬라이스 테이블을 대상 디스크에 기록"}
      ],
      "examples": [
        {"title": "슬라이스 테이블 백업", "command": "prtvtoc /dev/rdsk/{{DISK}}s2 > /var/tmp/{{DISK}}.vtoc"},
        {"title": "루트 미러 디스크로 레이아웃 복사", "command": "prtvtoc /dev/rdsk/{{SRC_DISK}}s2 | fmthard -s - /dev/rdsk/{{DST_DISK}}s2", "note": "두 디스크의 크기가 같거나 대상이 더 커야 합니다."},
        {"title": "백업해 둔 레이블 복원", "command": "fmthard -s /var/tmp/{{DISK}}.vtoc /dev/rdsk/{{DISK}}s2"}
      ],
      "cautions": [
        "fmthard 는 대상 디스크의 슬라이스 테이블을 확인 없이 덮어씁니다. 원본과 대상 디스크 이름을 바꿔 쓰지 않도록 두 번 확인하세요.",
        "EFI 레이블 디스크는 s2 가 없을 수 있으므로 /dev/rdsk/{{DISK}} 또는 s0 을 지정합니다."
      ],
      "help": "man prtvtoc · man fmthard",
      "keywords": ["VTOC", "슬라이스 테이블", "레이블 복사", "fmthard", "prtvtoc", "미러 디스크"],
      "related": ["solaris-format", "solaris-metastat", "solaris-metattach"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-zpool",
      "name": "zpool",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": ["solaris"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "ZFS 스토리지 풀 생성·상태 확인·디스크 교체",
      "description": "여러 디스크를 묶어 ZFS 스토리지 풀을 만들고 관리합니다. 풀의 상태(ONLINE/DEGRADED/FAULTED), 용량, 미러·RAID-Z 구성을 확인하고, 디스크 교체(replace), 미러 추가(attach), 데이터 무결성 검사(scrub), 다른 서버로 옮기기(export/import)를 수행합니다. Solaris 11 과 Solaris 10(10/08 이후)의 루트 풀은 보통 rpool 입니다.",
      "syntax": ["zpool create {{POOL}} [mirror | raidz | raidz2] {{DISK1}} {{DISK2}} ...", "zpool status [-x] [-v] [{{POOL}}]", "zpool list [{{POOL}}]", "zpool {{SUBCOMMAND}} {{POOL}} [{{ARGS}}]"],
      "options": [],
      "commandGroups": [
        {"title": "조회", "type": "subcommand", "items": [
          {"cmd": "zpool list", "desc": "풀별 크기·사용량·남은 용량·상태(HEALTH)"},
          {"cmd": "zpool status -x", "desc": "문제 있는 풀만 표시 (정상이면 all pools are healthy)"},
          {"cmd": "zpool status -v {{POOL}}", "desc": "구성 디스크별 상태·오류 수·손상 파일 목록"},
          {"cmd": "zpool iostat -v {{POOL}} 5", "desc": "디스크별 I/O 통계 (5초 간격)"},
          {"cmd": "zpool history {{POOL}}", "desc": "풀에 실행된 zpool/zfs 명령 이력"},
          {"cmd": "zpool get all {{POOL}}", "desc": "풀 속성 (version, autoexpand 등)"}
        ]},
        {"title": "생성·확장", "type": "subcommand", "items": [
          {"cmd": "zpool create {{POOL}} mirror {{DISK1}} {{DISK2}}", "desc": "미러 풀 생성"},
          {"cmd": "zpool create {{POOL}} raidz {{DISK1}} {{DISK2}} {{DISK3}}", "desc": "RAID-Z(단일 패리티) 풀 생성 (raidz2 는 이중 패리티)"},
          {"cmd": "zpool add {{POOL}} mirror {{DISK3}} {{DISK4}}", "desc": "풀에 미러 묶음 추가 (용량 확장)"},
          {"cmd": "zpool attach {{POOL}} {{EXISTING_DISK}} {{NEW_DISK}}", "desc": "기존 디스크에 미러 붙이기 (단일 → 미러)"},
          {"cmd": "zpool detach {{POOL}} {{DISK}}", "desc": "미러에서 디스크 떼기"}
        ]},
        {"title": "유지보수", "type": "subcommand", "items": [
          {"cmd": "zpool scrub {{POOL}}", "desc": "전체 데이터 체크섬 검사·자동 복구 (진행률은 status 로 확인, 중지는 scrub -s)"},
          {"cmd": "zpool replace {{POOL}} {{OLD_DISK}} [{{NEW_DISK}}]", "desc": "디스크 교체 (같은 자리에 교체했으면 새 디스크 생략)"},
          {"cmd": "zpool offline / online {{POOL}} {{DISK}}", "desc": "디스크 일시 분리·복귀"},
          {"cmd": "zpool clear {{POOL}} [{{DISK}}]", "desc": "오류 카운터 초기화"},
          {"cmd": "zpool export {{POOL}}", "desc": "풀을 내보내기 (다른 서버로 옮기기 전)"},
          {"cmd": "zpool import", "desc": "가져올 수 있는 풀 목록"},
          {"cmd": "zpool import {{POOL}}", "desc": "풀 가져오기 (-f 는 다른 호스트가 쓰던 풀 강제)"},
          {"cmd": "zpool destroy {{POOL}}", "desc": "풀 삭제 (모든 데이터 삭제)"}
        ]}
      ],
      "examples": [
        {"title": "풀 상태 일일 점검", "command": "zpool status -x\nzpool list", "output": "all pools are healthy"},
        {"title": "ZFS 풀·데이터셋 생성과 용량 제한", "steps": [
          {"prompt": "#", "cmd": "echo | format", "desc": "사용할 디스크 이름 확인 (다른 용도로 쓰이지 않는지 확인)"},
          {"prompt": "#", "cmd": "zpool create {{POOL}} mirror {{DISK1}} {{DISK2}}", "desc": "미러 풀 생성"},
          {"prompt": "#", "cmd": "zfs create -o mountpoint=/{{APP}} {{POOL}}/{{APP}}", "desc": "데이터셋 생성과 마운트 위치 지정"},
          {"prompt": "#", "cmd": "zfs set quota={{SIZE}} {{POOL}}/{{APP}}", "desc": "용량 상한 지정 (예: 100G)"},
          {"prompt": "#", "cmd": "zfs list -o name,used,avail,quota,mountpoint -r {{POOL}}", "desc": "결과 확인"}
        ]},
        {"title": "장애 디스크 교체 (핫스왑)", "steps": [
          {"prompt": "#", "cmd": "zpool status -x", "desc": "DEGRADED 풀과 UNAVAIL/FAULTED 디스크 확인"},
          {"prompt": "#", "cmd": "zpool offline {{POOL}} {{DISK}}", "desc": "장애 디스크 오프라인 (이미 UNAVAIL 이면 생략 가능)"},
          {"prompt": "#", "cmd": "cfgadm -c unconfigure {{AP_ID}}", "desc": "OS 에서 분리 후 물리 교체"},
          {"prompt": "#", "cmd": "cfgadm -c configure {{AP_ID}}", "desc": "새 디스크 연결"},
          {"prompt": "#", "cmd": "zpool replace {{POOL}} {{DISK}}", "desc": "같은 자리 디스크로 교체 → resilver 시작"},
          {"prompt": "#", "cmd": "zpool status {{POOL}}", "desc": "resilver 완료와 ONLINE 상태 확인"}
        ]},
        {"title": "루트 풀 미러 추가", "command": "zpool attach rpool {{EXISTING_DISK}} {{NEW_DISK}}\nzpool status rpool", "note": "resilver 완료 후 부팅 블록 설치가 필요한지 확인하세요 (Solaris 11 x86/SPARC 최신 버전은 자동 설치, Solaris 10 은 installboot/installgrub 필요)."}
      ],
      "cautions": [
        "zpool create·add 에 사용 중인 디스크를 넣으면 데이터가 사라집니다. -f 로 경고를 무시하지 마세요.",
        "zpool add 로 단일 디스크를 미러 풀에 붙이면 중복성이 없는 구성이 되고, 버전에 따라 되돌릴 수 없습니다. 미러를 만들려면 attach 를 쓰세요.",
        "zpool destroy 는 확인 없이 풀 전체를 삭제합니다.",
        "용량이 80% 를 넘으면 ZFS 성능이 떨어지므로 여유 공간을 관리하세요."
      ],
      "platformNotes": {"solaris": "Solaris 10 10/08 이후 ZFS 루트 지원, Solaris 11 은 ZFS 루트가 기본. 풀 버전이 높으면 이전 OS 에서 import 가 안 될 수 있습니다 (zpool upgrade 는 신중히)."},
      "help": "man zpool",
      "keywords": ["ZFS", "스토리지 풀", "디스크 교체", "미러", "zpool", "scrub", "resilver", "RAID-Z"],
      "related": ["solaris-zfs", "solaris-format", "solaris-cfgadm", "solaris-fmadm"],
      "review": {"status": "ai-draft"}
    },
    {
      "id": "solaris-zfs",
      "name": "zfs",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": ["solaris"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "ZFS 데이터셋 생성·용량 제한·스냅샷·복제·전송",
      "description": "ZFS 풀 안의 파일시스템(데이터셋)과 볼륨(zvol)을 만들고 속성(quota, reservation, mountpoint, compression)을 관리합니다. 순간 스냅샷과 롤백, 스냅샷 기반 복제(clone), 다른 서버로 전송(send/receive)이 핵심 기능입니다. ZFS 데이터셋은 /etc/vfstab 없이 mountpoint 속성으로 자동 마운트됩니다.",
      "syntax": ["zfs create [-o {{PROP}}={{VALUE}}] {{POOL}}/{{FS}}", "zfs set | get {{PROP}}[={{VALUE}}] {{POOL}}/{{FS}}", "zfs snapshot [-r] {{POOL}}/{{FS}}@{{SNAP}}", "zfs list [-t snapshot] [-o {{COLUMNS}}] [-r {{DATASET}}]"],
      "options": [],
      "commandGroups": [
        {"title": "데이터셋·속성", "type": "subcommand", "items": [
          {"cmd": "zfs create {{POOL}}/{{FS}}", "desc": "파일시스템 생성 (부모의 mountpoint 아래 자동 마운트)"},
          {"cmd": "zfs create -V {{SIZE}} {{POOL}}/{{VOL}}", "desc": "블록 볼륨(zvol) 생성 → /dev/zvol/dsk/{{POOL}}/{{VOL}}"},
          {"cmd": "zfs list -o name,used,avail,refer,quota,mountpoint", "desc": "데이터셋 목록과 용량"},
          {"cmd": "zfs set quota={{SIZE}} {{POOL}}/{{FS}}", "desc": "용량 상한 (하위 데이터셋·스냅샷 포함)"},
          {"cmd": "zfs set reservation={{SIZE}} {{POOL}}/{{FS}}", "desc": "최소 용량 예약"},
          {"cmd": "zfs set mountpoint={{PATH}} {{POOL}}/{{FS}}", "desc": "마운트 위치 변경 (legacy 로 하면 vfstab 으로 관리)"},
          {"cmd": "zfs set compression=on {{POOL}}/{{FS}}", "desc": "압축 사용 (이후 쓰는 데이터부터 적용)"},
          {"cmd": "zfs get all {{POOL}}/{{FS}}", "desc": "모든 속성 확인 (zfs get quota,used 처럼 일부만도 가능)"},
          {"cmd": "zfs rename {{POOL}}/{{FS}} {{POOL}}/{{NEW_FS}}", "desc": "이름 변경"},
          {"cmd": "zfs destroy [-r] {{POOL}}/{{FS}}", "desc": "데이터셋 삭제 (-r 하위·스냅샷 포함)"}
        ]},
        {"title": "스냅샷·복제·전송", "type": "subcommand", "items": [
          {"cmd": "zfs snapshot {{POOL}}/{{FS}}@{{SNAP}}", "desc": "스냅샷 생성 (-r 하위 데이터셋 모두)"},
          {"cmd": "zfs list -t snapshot -o name,used,creation", "desc": "스냅샷 목록"},
