{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "shell",
  "commands": [
    {
      "id": "hpux-kctune",
      "name": "kctune",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["hpux"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "커널 파라미터(tunable) 조회·변경 (HP-UX 의 sysctl)",
      "description": "HP-UX 11i v2 이상의 커널 파라미터 관리 명령입니다. 값을 조회하고 바꿀 수 있으며, 동적 파라미터는 즉시 적용되고 정적 파라미터는 다음 부팅부터 적용됩니다. 변경 내역은 /var/adm/kc.log 에 기록됩니다. DB 설치 요건(세마포어, 공유 메모리, nproc 등) 맞출 때 자주 씁니다.",
      "syntax": [
        "kctune [-v] [{{PARAM}}]",
        "kctune {{PARAM}}={{VALUE}}",
        "kctune -h {{PARAM}}={{VALUE}}"
      ],
      "options": [
        { "flag": "-v", "desc": "자세히: 설명, 허용 범위, 동적 변경 가능 여부, 다음 부팅 값" },
        { "flag": "-h", "desc": "지금 적용하지 않고 다음 부팅 때 적용(hold)" },
        { "flag": "-B", "desc": "변경 전에 현재 커널 구성을 백업 구성으로 저장" }
      ],
      "commandGroups": [
        {
          "title": "사용 형식",
          "type": "subcommand",
          "items": [
            { "cmd": "kctune", "desc": "모든 파라미터의 현재 값·식(expression)·변경 가능 여부 목록" },
            { "cmd": "kctune {{PARAM}}", "desc": "한 파라미터 조회" },
            { "cmd": "kctune {{PARAM}}={{VALUE}}", "desc": "값 설정 (동적이면 즉시, 정적이면 다음 부팅에 적용된다고 안내)" },
            { "cmd": "kctune {{PARAM}}+={{N}}", "desc": "현재 값에서 N 만큼 증가" },
            { "cmd": "kctune {{PARAM}}=Default", "desc": "기본값으로 되돌림" },
            { "cmd": "kconfig -s {{CONFIG_NAME}}", "desc": "현재 커널 구성을 이름 붙여 저장 (롤백용)" },
            { "cmd": "kconfig -l", "desc": "저장된 커널 구성 목록" }
          ]
        },
        {
          "title": "자주 확인하는 파라미터",
          "type": "directive",
          "note": "이름·기본값은 11i v3 기준. 11i v2 이하는 이름이 다른 것이 있습니다(예: 파일 캐시 dbc_max_pct).",
          "items": [
            { "cmd": "nproc", "desc": "시스템 전체 최대 프로세스 수" },
            { "cmd": "maxuprc", "desc": "사용자당 최대 프로세스 수" },
            { "cmd": "maxfiles / maxfiles_lim", "desc": "프로세스당 열린 파일 수 기본값(soft) / 최대값(hard)" },
            { "cmd": "nfile", "desc": "시스템 전체 열린 파일 수" },
            { "cmd": "shmmax / shmmni / shmseg", "desc": "공유 메모리 최대 크기·식별자 수·프로세스당 세그먼트 수" },
            { "cmd": "semmni / semmns / semmsl", "desc": "세마포어 식별자 수·전체 개수·집합당 개수" },
            { "cmd": "maxdsiz_64bit / maxssiz_64bit", "desc": "64비트 프로세스 데이터·스택 최대 크기" },
            { "cmd": "filecache_min / filecache_max", "desc": "파일 캐시 최소·최대 (11i v3)" }
          ]
        }
      ],
      "examples": [
        {
          "title": "DB 설치 요건에 맞춰 커널 파라미터 변경",
          "steps": [
            { "prompt": "#", "cmd": "kctune -v {{PARAM}}", "desc": "현재 값, 허용 범위, 동적 여부 확인" },
            { "prompt": "#", "cmd": "kconfig -s before_change", "desc": "현재 커널 구성을 저장 (되돌리기용)" },
            { "prompt": "#", "cmd": "kctune {{PARAM}}={{VALUE}}", "desc": "값 변경. 정적 파라미터면 다음 부팅에 적용된다는 메시지가 나옴" },
            { "prompt": "#", "cmd": "kctune {{PARAM}}", "desc": "현재 값과 Next Boot 값 확인" },
            { "prompt": "#", "cmd": "tail /var/adm/kc.log", "desc": "변경 기록 확인 (변경 이력 증적)" }
          ]
        },
        { "title": "사용자당 프로세스 수 늘리기", "command": "kctune maxuprc\nkctune maxuprc=2048" },
        { "title": "다음 부팅부터만 적용", "command": "kctune -h {{PARAM}}={{VALUE}}" }
      ],
      "cautions": [
        "값을 너무 크게 잡으면 커널 메모리가 부족해지거나 부팅 문제가 생길 수 있습니다. 벤더 권장값을 근거로 바꾸고 변경 전 kconfig -s 로 구성을 저장하세요.",
        "정적 파라미터는 재부팅 전까지 적용되지 않습니다. 작업 계획에 재부팅 시간을 포함하세요.",
        "Serviceguard 클러스터는 노드 간 같은 값을 유지하는 것이 좋습니다."
      ],
      "versions": { "hpux": "11i v2 이상 (이전 버전은 kmtune·SAM)" },
      "help": "man kctune · man kconfig",
      "keywords": ["커널 파라미터", "kctune", "tunable", "nproc", "maxuprc", "공유 메모리", "세마포어", "kc.log"],
      "related": ["hpux-kcusage", "hpux-shutdown", "sysctl", "ulimit", "hpux-ndd"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-kcusage",
      "name": "kcusage",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["hpux"],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "커널 파라미터 한계 대비 실제 사용량 확인",
      "description": "nproc, nfile, shmmni 같은 자원형 커널 파라미터의 현재 사용량과 설정값을 비교해 보여 줍니다. 기간 옵션을 주면 과거 사용량 추이도 볼 수 있어, 'too many processes' 같은 오류의 원인 확인과 파라미터 증설 근거로 씁니다.",
      "syntax": [
        "kcusage [{{PARAM}}]",
        "kcusage -h|-d|-m|-y {{PARAM}}"
      ],
      "options": [
        { "flag": "-h", "desc": "최근 1시간 추이" },
        { "flag": "-d", "desc": "최근 1일 추이" },
        { "flag": "-m", "desc": "최근 1개월 추이" },
        { "flag": "-y", "desc": "최근 1년 추이" }
      ],
      "examples": [
        { "title": "모든 자원 사용률 확인", "command": "kcusage" },
        { "title": "프로세스 수 하루 추이", "command": "kcusage -d nproc" }
      ],
      "cautions": [
        "과거 추이는 사용량 수집 데몬이 동작해 온 경우에만 나옵니다."
      ],
      "help": "man kcusage",
      "keywords": ["커널 자원 사용량", "kcusage", "nproc 사용량", "파라미터 한계", "용량 계획"],
      "related": ["hpux-kctune", "hpux-glance", "sar"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-setboot",
      "name": "setboot",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.boot",
      "platforms": ["hpux"],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "부팅 디스크 경로(주·대체)와 자동 부팅 설정",
      "description": "펌웨어에 저장된 주(primary)·HA 대체·대체(alternate) 부팅 경로와 자동 부팅(autoboot)·자동 검색(autosearch) 설정을 조회하고 바꿉니다. 루트 디스크 미러를 구성했거나 디스크를 교체한 뒤 대체 경로를 맞춰 둘 때 씁니다.",
      "syntax": [
        "setboot",
        "setboot -p {{HW_PATH}}",
        "setboot -a {{HW_PATH}}"
      ],
      "options": [
        { "flag": "-p {{HW_PATH}}", "desc": "주 부팅 경로 설정" },
        { "flag": "-h {{HW_PATH}}", "desc": "HA 대체 부팅 경로 설정" },
        { "flag": "-a {{HW_PATH}}", "desc": "대체 부팅 경로 설정" },
        { "flag": "-b on|off", "desc": "자동 부팅 켜기·끄기" },
        { "flag": "-s on|off", "desc": "자동 검색 켜기·끄기" }
      ],
      "examples": [
        { "title": "현재 부팅 경로 확인", "command": "setboot\nlvlnboot -v vg00", "note": "lvlnboot -v 로 vg00 의 boot·root·swap·dump LV 와 부팅 디스크를 함께 확인합니다." },
        { "title": "미러 디스크를 대체 부팅 경로로 지정", "command": "ioscan -fnkC disk\nsetboot -a {{MIRROR_HW_PATH}}\nsetboot" }
      ],
      "cautions": [
        "잘못된 경로를 주 부팅 경로로 넣으면 재부팅 때 OS 가 올라오지 않습니다. 변경 후 setboot 출력과 ioscan 하드웨어 경로를 대조하세요."
      ],
      "help": "man setboot",
      "keywords": ["부팅 경로", "setboot", "대체 부팅", "autoboot", "루트 미러", "부팅 디스크"],
      "related": ["hpux-ioscan", "hpux-shutdown", "hpux-lvextend", "hpux-make-tape-recovery"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "hpux-shutdown",
      "name": "shutdown",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.power",
      "platforms": ["hpux"],
      "level": "critical",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "HP-UX 재부팅·종료 (shutdown -r -y 0)",
      "description": "HP-UX 의 정상 종료·재부팅 명령입니다. Linux 와 문법이 달라 -y(질문 없이 진행)와 유예 시간(초)을 함께 줍니다. 종료 스크립트(/sbin/rc*.d 의 K 스크립트)를 순서대로 실행해 서비스를 정리합니다. 실행 기록은 /etc/shutdownlog 에 남습니다.",
      "syntax": [
        "shutdown -r -y {{GRACE_SEC}}",
        "shutdown -h -y {{GRACE_SEC}}"
      ],
      "options": [
        { "flag": "-r", "desc": "종료 후 재부팅" },
        { "flag": "-h", "desc": "종료 후 정지(halt)" },
        { "flag": "-y", "desc": "확인 질문에 자동으로 yes (없으면 대화형으로 물어봄)" },
        { "flag": "{{GRACE_SEC}}", "desc": "접속자에게 알리고 기다릴 시간(초). 0 은 즉시" },
        { "flag": "-R", "desc": "nPartition 재구성 대기 상태로 재부팅 (파티션 구성 변경 시)" }
      ],
      "commandGroups": [
        {
          "title": "Linux 와 비교",
          "type": "subcommand",
          "columns": ["HP-UX", "Linux"],
          "items": [
            { "desc": "즉시 재부팅", "left": "shutdown -r -y 0", "right": "shutdown -r now" },
            { "desc": "즉시 종료(정지)", "left": "shutdown -h -y 0", "right": "shutdown -h now" },
            { "desc": "5분 뒤 재부팅", "left": "shutdown -r -y 300", "right": "shutdown -r +5" },
            { "desc": "종료 스크립트 없이 즉시 재시작 (비권장)", "left": "reboot", "right": "reboot -f" }
          ]
        }
      ],
      "examples": [
        {
          "title": "작업 후 정상 재부팅",
          "steps": [
            { "prompt": "#", "cmd": "who", "desc": "접속 중인 사용자 확인·공지" },
            { "prompt": "#", "cmd": "cmviewcl", "desc": "Serviceguard 노드라면 패키지 위치 확인 (패키지 이동·cmhaltnode 먼저)" },
            { "prompt": "#", "cmd": "cd /", "desc": "루트 디렉토리에서 실행" },
            { "prompt": "#", "cmd": "shutdown -r -y 0", "desc": "즉시 재부팅" },
            { "prompt": "#", "cmd": "tail /etc/shutdownlog\nmore /etc/rc.log", "desc": "부팅 후 종료 기록과 시작 스크립트 결과 확인" }
          ]
        },
        { "title": "10분 유예 후 종료", "command": "cd /\nshutdown -h -y 600" }
      ],
      "cautions": [
        "-y 없이 실행하면 질문을 기다리며 멈춥니다. 원격 세션이 끊기면 진행 상태를 알기 어려우니 콘솔(MP/iLO)에서 하거나 -y 를 씁니다.",
        "reboot 명령은 종료 스크립트를 실행하지 않아 DB·애플리케이션이 정상 종료되지 않습니다. 장애 상황이 아니면 shutdown 을 쓰세요.",
        "Serviceguard 노드는 cmhaltnode 로 클러스터에서 먼저 빠지지 않으면 다른 노드로의 패키지 이동이 비정상적으로 일어날 수 있습니다.",
        "원격 재부팅 전 MP/iLO 콘솔 접속이 가능한지 확인하세요."
      ],
      "help": "man shutdown",
      "keywords": ["재부팅", "종료", "shutdown -r -y 0", "halt", "HP-UX 재시작", "shutdownlog"],
      "related": ["shutdown", "reboot", "hpux-etc-rc-log", "hpux-cmhaltcl", "hpux-cmviewcl", "hpux-setboot"],
      "review": { "status": "ai-draft" }
    }
  ]
}
