{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "shell",
  "commands": [
    {
      "id": "aix-vmo",
      "name": "vmo",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "가상 메모리 관리자(VMM) 튜닝 파라미터 조회·변경",
      "description": "AIX 가상 메모리 관리 튜닝 값(minfree, maxfree, minperm%, maxperm% 등)을 조회하고 바꿉니다. -p 로 바꾸면 즉시 적용되고 /etc/tunables/nextboot 에 기록되어 재부팅 후에도 유지됩니다. AIX 7.x 는 기본값이 대부분의 업무에 맞게 설정되어 있어 IBM·DB 벤더 권고가 있을 때만 바꿉니다.",
      "syntax": [
        "vmo -a",
        "vmo -L [{{TUNABLE}}]",
        "vmo -o {{TUNABLE}}",
        "vmo -p -o {{TUNABLE}}={{VALUE}}"
      ],
      "options": [
        { "flag": "-a", "desc": "모든 튜닝 값 현재 값 표시" },
        { "flag": "-L [{{TUNABLE}}]", "desc": "현재·기본·부팅 값, 최소·최대, 단위, 유형(D=즉시, R=재부팅, B=bosboot 필요 등) 표시" },
        { "flag": "-o {{TUNABLE}}[={{VALUE}}]", "desc": "값 조회 또는 변경 (-p/-r 없으면 재부팅 시 원래대로)" },
        { "flag": "-p", "desc": "지금 적용 + nextboot 에 기록 (영구)" },
        { "flag": "-r", "desc": "다음 재부팅 때만 적용 (재부팅 유형 파라미터)" },
        { "flag": "-d {{TUNABLE}}", "desc": "기본값으로 되돌림" },
        { "flag": "-F", "desc": "제한(restricted) 파라미터까지 표시" }
      ],
      "examples": [
        { "title": "파라미터 상세(현재·기본·범위·적용 유형) 확인", "command": "vmo -L minfree\nvmo -L maxfree" },
        {
          "title": "벤더 권고값 영구 적용",
          "steps": [
            { "prompt": "#", "cmd": "cp -p /etc/tunables/nextboot /etc/tunables/nextboot.$(date +%Y%m%d)", "desc": "현재 영구 설정 백업" },
            { "prompt": "#", "cmd": "vmo -L {{TUNABLE}}", "desc": "현재 값과 TYPE(D/R/B) 확인" },
            { "prompt": "#", "cmd": "vmo -p -o {{TUNABLE}}={{VALUE}}", "desc": "즉시 + 영구 적용 (TYPE 이 R·B 면 -r 사용 후 bosboot·재부팅)" },
            { "prompt": "#", "cmd": "grep -p vmo /etc/tunables/nextboot", "desc": "nextboot 파일에 기록되었는지 확인" }
          ]
        }
      ],
      "cautions": [
        "restricted 파라미터(-F 로만 보이는 것)는 IBM 지원 지시 없이는 바꾸지 마세요. 변경 시 경고 메시지와 함께 errpt 에 기록됩니다.",
        "-p/-r 없이 바꾼 값은 재부팅하면 사라집니다. 반대로 -p 로 잘못 넣은 값은 재부팅 후에도 남으므로 nextboot 백업을 꼭 두세요."
      ],
      "help": "man vmo · vmo -h {{TUNABLE}}",
      "keywords": ["메모리 튜닝", "vmo", "minfree", "maxperm", "커널 파라미터", "VMM", "nextboot"],
      "related": ["aix-ioo", "aix-no", "aix-schedo", "aix-svmon", "sysctl"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-ioo",
      "name": "ioo",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "I/O·JFS2·AIO 튜닝 파라미터 조회·변경",
      "description": "디스크 I/O 와 JFS2 파일시스템, 비동기 I/O(AIO) 관련 튜닝 값을 다룹니다. DB 서버에서는 aio_maxservers 등 AIO 값과 JFS2 read-ahead 값을 벤더 권고에 맞춰 조정합니다. 플래그 사용법은 vmo 와 같습니다.",
      "syntax": [
        "ioo -a",
        "ioo -L [{{TUNABLE}}]",
        "ioo -p -o {{TUNABLE}}={{VALUE}}"
      ],
      "options": [
        { "flag": "-a", "desc": "모든 값 표시" },
        { "flag": "-L [{{TUNABLE}}]", "desc": "상세(현재·기본·범위·유형) 표시" },
        { "flag": "-o {{TUNABLE}}[={{VALUE}}]", "desc": "조회·변경" },
        { "flag": "-p", "desc": "즉시 + 영구 적용" },
        { "flag": "-r", "desc": "다음 재부팅 때 적용" },
        { "flag": "-d {{TUNABLE}}", "desc": "기본값으로 되돌림" }
      ],
      "examples": [
        { "title": "AIO 관련 값 확인 (DB 서버 점검)", "command": "ioo -a | grep aio" },
        { "title": "AIO 서버 프로세스 사용 현황", "command": "pstat -a | grep -c aios", "note": "실행 중인 AIO 서버 수를 대략 보여 줍니다. aio_maxservers 는 CPU 당 값입니다." },
        { "title": "JFS2 관련 값 확인", "command": "ioo -a | grep j2_" }
      ],
      "cautions": [
        "AIX 6.1 이후 AIO 는 필요 시 자동으로 올라오므로 예전처럼 aio0 장치를 chdev 로 켜는 절차는 필요 없습니다.",
        "변경 전 /etc/tunables/nextboot 를 백업하고 변경 내역을 기록하세요."
      ],
      "help": "man ioo",
      "keywords": ["I/O 튜닝", "ioo", "AIO", "aio_maxservers", "JFS2 튜닝", "커널 파라미터"],
      "related": ["aix-vmo", "aix-no", "iostat"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-no",
      "name": "no",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "네트워크 커널 파라미터 조회·변경 (TCP 버퍼, keepalive)",
      "description": "TCP/IP 커널 파라미터를 조회하고 바꿉니다. 소켓 버퍼(tcp_sendspace, tcp_recvspace, sb_max), RFC1323, keepalive 시간, 임시 포트 범위, IP 포워딩 등을 다룹니다. use_isno=1(기본)이면 인터페이스별(ISNO) 값이 no 의 전역 값보다 우선하므로 lsattr -El en0 도 함께 확인합니다.",
      "syntax": [
        "no -a",
        "no -o {{TUNABLE}}",
        "no -p -o {{TUNABLE}}={{VALUE}}"
      ],
      "options": [
        { "flag": "-a", "desc": "모든 값 표시" },
        { "flag": "-L [{{TUNABLE}}]", "desc": "상세(현재·기본·범위·유형) 표시" },
        { "flag": "-o {{TUNABLE}}[={{VALUE}}]", "desc": "조회·변경" },
        { "flag": "-p", "desc": "즉시 + 영구 적용" },
        { "flag": "-r", "desc": "다음 재부팅 때 적용" },
        { "flag": "-d {{TUNABLE}}", "desc": "기본값으로 되돌림" }
      ],
      "commandGroups": [
        {
          "title": "자주 점검하는 파라미터",
          "type": "directive",
          "items": [
            { "cmd": "tcp_sendspace / tcp_recvspace", "desc": "TCP 송수신 소켓 버퍼 기본 크기 (바이트)" },
            { "cmd": "sb_max", "desc": "소켓 버퍼 최대 크기 (위 값보다 커야 함)" },
            { "cmd": "rfc1323", "desc": "64KB 넘는 TCP 윈도우 사용 (1=사용)" },
            { "cmd": "tcp_keepidle", "desc": "keepalive 시작까지 유휴 시간 (단위 0.5초, 기본 14400 = 2시간)" },
            { "cmd": "tcp_keepintvl", "desc": "keepalive 재전송 간격 (단위 0.5초)" },
            { "cmd": "tcp_ephemeral_low / tcp_ephemeral_high", "desc": "클라이언트 임시 포트 범위" },
            { "cmd": "ipforwarding", "desc": "라우터처럼 패킷 전달 (보안상 보통 0)" },
            { "cmd": "use_isno", "desc": "인터페이스별 값(ISNO) 우선 사용 여부" }
          ]
        }
      ],
      "examples": [
        { "title": "TCP 버퍼·keepalive 현재 값", "command": "no -a | grep -E 'tcp_sendspace|tcp_recvspace|sb_max|rfc1323|tcp_keep'" },
        { "title": "방화벽 세션 타임아웃보다 짧게 keepalive 조정 (30분)", "command": "no -p -o tcp_keepidle=3600", "note": "단위가 0.5초이므로 3600 = 1800초(30분)입니다. 이미 연결된 세션에는 적용되지 않을 수 있습니다." },
        { "title": "인터페이스별 값(ISNO) 확인", "command": "lsattr -El en0 | grep -E 'tcp_|rfc1323'" }
      ],
      "cautions": [
        "인터페이스에 ISNO 값이 설정되어 있으면 no 로 바꾼 전역 값이 그 인터페이스에는 적용되지 않습니다.",
        "-p 없이 바꾼 값은 재부팅 시 사라집니다. 변경 전 /etc/tunables/nextboot 를 백업하세요."
      ],
      "help": "man no · no -h {{TUNABLE}}",
      "keywords": ["네트워크 튜닝", "no", "tcp_sendspace", "keepalive", "tcp_keepidle", "소켓 버퍼", "ISNO", "커널 파라미터"],
      "related": ["aix-vmo", "aix-chdev", "aix-lsattr", "sysctl"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-schedo",
      "name": "schedo",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.kernel-tuning",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "CPU 스케줄러 튜닝 파라미터 조회·변경",
      "description": "CPU 스케줄링과 가상 프로세서 관리(processor folding) 관련 튜닝 값을 다룹니다. 일반 운영에서는 거의 바꾸지 않으며 IBM 성능 분석 결과에 따라 조정합니다. 플래그 사용법은 vmo 와 같습니다.",
      "syntax": [
        "schedo -a",
        "schedo -L [{{TUNABLE}}]",
        "schedo -p -o {{TUNABLE}}={{VALUE}}"
      ],
      "options": [
        { "flag": "-a", "desc": "모든 값 표시" },
        { "flag": "-L [{{TUNABLE}}]", "desc": "상세(현재·기본·범위·유형) 표시" },
        { "flag": "-o {{TUNABLE}}[={{VALUE}}]", "desc": "조회·변경" },
        { "flag": "-p", "desc": "즉시 + 영구 적용" },
        { "flag": "-d {{TUNABLE}}", "desc": "기본값으로 되돌림" }
      ],
      "examples": [
        { "title": "기본값과 다르게 설정된 스케줄러 값 찾기", "command": "schedo -L | more", "note": "CUR 과 DEF 열이 다른 항목이 변경된 값입니다." },
        { "title": "영구 설정 파일에 기록된 튜닝 값 전체 확인", "command": "cat /etc/tunables/nextboot" }
      ],
      "cautions": [
        "스케줄러 값은 전체 CPU 성능에 영향을 줍니다. 운영 서버에서는 성능 분석 근거 없이 바꾸지 마세요."
      ],
      "help": "man schedo",
      "keywords": ["CPU 튜닝", "schedo", "스케줄러", "processor folding", "커널 파라미터"],
      "related": ["aix-vmo", "aix-lparstat", "aix-topas"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-smitty",
      "name": "smitty",
      "aliases": ["smit"],
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.help",
      "platforms": ["aix"],
      "level": "basic",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "AIX 메뉴형 관리 도구 (실행 명령 확인 가능)",
      "description": "AIX 관리 작업 대부분을 메뉴로 처리하는 SMIT 의 텍스트 화면판입니다. 빠른 경로(fastpath)로 원하는 화면을 바로 열 수 있고, F6 으로 실제로 실행될 명령을 미리 볼 수 있어 명령어를 익히는 데도 좋습니다. 실행한 명령은 홈 디렉토리의 smit.script 에, 작업 기록은 smit.log 에 남습니다.",
      "syntax": [
        "smitty [{{FASTPATH}}]",
        "smitty -x {{FASTPATH}}"
      ],
      "options": [
        { "flag": "-x", "desc": "실제로 실행하지 않고 명령만 smit.script 에 기록" },
        { "flag": "-s {{SCRIPT_FILE}}", "desc": "명령 기록 파일 위치 지정" },
        { "flag": "-l {{LOG_FILE}}", "desc": "작업 로그 파일 위치 지정" }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 fastpath",
          "type": "action",
          "items": [
            { "cmd": "smitty user", "desc": "사용자 관리 (mkuser, chuser, lsuser, rmuser)" },
            { "cmd": "smitty passwd", "desc": "사용자 비밀번호 변경" },
            { "cmd": "smitty group", "desc": "그룹 관리" },
            { "cmd": "smitty lvm", "desc": "LVM 전체 메뉴 (VG, LV, PV)" },
            { "cmd": "smitty vg", "desc": "볼륨 그룹 관리" },
            { "cmd": "smitty lv", "desc": "논리 볼륨 관리" },
            { "cmd": "smitty jfs2", "desc": "JFS2 파일시스템 생성·변경·삭제" },
            { "cmd": "smitty fs", "desc": "파일시스템 전체 메뉴" },
            { "cmd": "smitty pgsp", "desc": "paging space 관리" },
            { "cmd": "smitty tcpip", "desc": "TCP/IP 설정 메뉴" },
            { "cmd": "smitty mktcpip", "desc": "최초 TCP/IP 설정 (호스트명, IP, 게이트웨이, DNS)" },
            { "cmd": "smitty chinet", "desc": "네트워크 인터페이스 설정 변경" },
            { "cmd": "smitty route", "desc": "정적 라우팅 추가·삭제" },
            { "cmd": "smitty etherchannel", "desc": "EtherChannel(링크 집계·NIB) 구성" },
            { "cmd": "smitty nfs", "desc": "NFS 서버·클라이언트 설정" },
            { "cmd": "smitty install_latest", "desc": "소프트웨어 설치" },
            { "cmd": "smitty update_all", "desc": "TL·SP 업데이트 적용" },
            { "cmd": "smitty commit", "desc": "APPLIED 상태 업데이트 확정" },
            { "cmd": "smitty reject", "desc": "APPLIED 상태 업데이트 되돌리기" },
            { "cmd": "smitty mksysb", "desc": "rootvg 백업" },
            { "cmd": "smitty errpt", "desc": "에러 로그 조회" },
            { "cmd": "smitty src", "desc": "SRC 서비스 시작·중지" },
            { "cmd": "smitty chgsys", "desc": "시스템 속성(sys0: maxuproc 등) 변경" },
            { "cmd": "smitty devices", "desc": "장치 관리" }
          ]
        },
        {
          "title": "화면 단축키",
          "type": "keys",
          "note": "터미널에서 F 키가 안 먹으면 Esc 다음에 숫자를 누릅니다 (Esc+4 = F4, Esc+0 = F10).",
          "items": [
            { "cmd": "F1", "desc": "현재 항목 도움말" },
            { "cmd": "F3", "desc": "이전 화면으로 (취소)" },
            { "cmd": "F4", "desc": "선택 가능한 값 목록 보기" },
            { "cmd": "F6", "desc": "실행될 명령 미리 보기" },
            { "cmd": "F7", "desc": "목록에서 항목 선택 (다중 선택)" },
            { "cmd": "F10", "desc": "SMIT 종료" },
            { "cmd": "Enter", "desc": "입력 화면에서 실행 (확인 질문 후 실행)" },
            { "cmd": "Tab", "desc": "정해진 값 중에서 순환 선택" }
          ]
        }
      ],
      "examples": [
        { "title": "파일시스템 크기 변경 화면 바로 열기", "command": "smitty jfs2" },
        { "title": "smitty 로 한 작업의 실제 명령 확인", "command": "tail -30 $HOME/smit.script", "note": "같은 작업을 다른 서버에서 반복할 때 스크립트로 옮기기 좋습니다." }
      ],
      "cautions": [
        "Enter 를 누르면 확인 질문 뒤 바로 실행됩니다. 운영 서버에서는 F6 으로 명령을 확인하는 습관을 들이세요.",
        "smit 은 X 디스플레이가 있으면 GUI 로 열립니다. 텍스트 화면은 smitty 를 쓰세요."
      ],
      "help": "smitty 화면에서 F1 · man smit",
      "keywords": ["smitty", "smit", "메뉴 관리", "fastpath", "관리 도구", "F6 명령 보기", "AIX 관리"],
      "related": ["aix-mkuser", "aix-chfs", "aix-mktcpip", "aix-installp", "man"],
      "review": { "status": "ai-draft" }
    },
    {
      "id": "aix-snap",
      "name": "snap",
      "kind": "command",
      "shell": "sh",
      "category": "shell",
      "task": "shell.diag",
      "platforms": ["aix"],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "IBM 지원용 시스템 진단 정보 수집",
