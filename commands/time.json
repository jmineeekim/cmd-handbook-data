    {
      "id": "etc-chrony-conf",
      "name": "/etc/chrony.conf",
      "kind": "file",
      "category": "time",
      "task": "time.sync-status",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "chrony NTP 서버·동기화 정책 설정 파일",
      "description": "chronyd 가 사용할 NTP 서버, 큰 시간 차이 보정 방식, NTP 서버 역할(다른 서버에 시간 제공) 등을 설정합니다. 폐쇄망에서는 기본 공용 pool 을 지우고 사내 NTP 서버를 지정해야 합니다. 경로가 배포판마다 다릅니다.",
      "syntax": [
        "/etc/chrony.conf",
        "/etc/chrony/chrony.conf"
      ],
      "options": [],
      "commandGroups": [
        {
          "title": "시간 소스",
          "type": "directive",
          "items": [
            {
              "cmd": "server {{NTP_SERVER}} iburst",
              "desc": "NTP 서버 지정 (iburst: 시작 시 빠른 동기화)"
            },
            {
              "cmd": "server {{NTP_SERVER}} iburst prefer",
              "desc": "여러 서버 중 우선 사용"
            },
            {
              "cmd": "pool {{NTP_POOL}} iburst",
              "desc": "여러 주소를 가진 NTP 풀 지정"
            },
            {
              "cmd": "server {{NTP_SERVER}} minpoll 4 maxpoll 6",
              "desc": "폴링 주기 지정 (2의 거듭제곱 초: 4=16초, 6=64초)"
            },
            {
              "cmd": "sourcedir {{DIR}}",
              "desc": "추가 소스 파일(*.sources) 디렉토리"
            }
          ]
        },
        {
          "title": "보정 방식",
          "type": "directive",
          "items": [
            {
              "cmd": "makestep 1.0 3",
              "desc": "시작 후 3회까지 1초 이상 차이는 즉시 맞춤 (그 뒤로는 천천히 보정)"
            },
            {
              "cmd": "rtcsync",
              "desc": "하드웨어 시계(RTC)를 주기적으로 동기화"
            },
            {
              "cmd": "driftfile {{FILE}}",
              "desc": "시계 오차율 저장 파일"
            },
            {
              "cmd": "maxupdateskew 100.0",
              "desc": "오차 추정이 이 값(ppm)보다 크면 갱신 무시"
            }
          ]
        },
        {
          "title": "NTP 서버 역할",
          "type": "directive",
          "items": [
            {
              "cmd": "allow {{CIDR}}",
              "desc": "이 대역의 클라이언트에 NTP 서비스 제공"
            },
            {
              "cmd": "deny {{CIDR}}",
              "desc": "특정 대역 거부"
            },
            {
              "cmd": "local stratum 10",
              "desc": "외부 동기화가 안 돼도 로컬 시계로 시간 제공 (폐쇄망 NTP 서버)"
            },
            {
              "cmd": "bindaddress {{IP}}",
              "desc": "NTP 요청을 받을 주소 제한"
            }
          ]
        },
        {
          "title": "로그",
          "type": "directive",
          "items": [
            {
              "cmd": "logdir /var/log/chrony",
              "desc": "로그 디렉토리"
            },
            {
              "cmd": "log measurements statistics tracking",
              "desc": "측정·통계·추적 로그 기록 (장애 분석용)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "사내 NTP 서버로 변경 후 반영 (RHEL)",
          "platforms": [
            "rhel"
          ],
          "steps": [
            {
              "prompt": "#",
              "cmd": "cp -p /etc/chrony.conf /etc/chrony.conf.bak.$(date +%Y%m%d)",
              "desc": "변경 전 백업 (롤백: 백업 파일 복사 후 재시작)"
            },
            {
              "prompt": "#",
              "cmd": "sed -i 's/^pool /#pool /' /etc/chrony.conf",
              "desc": "기본 pool 줄 주석 처리"
            },
            {
              "prompt": "#",
              "cmd": "echo 'server {{NTP_SERVER}} iburst' >> /etc/chrony.conf",
              "desc": "사내 NTP 서버 추가"
            },
            {
              "prompt": "#",
              "cmd": "systemctl restart chronyd",
              "desc": "서비스 재시작"
            },
            {
              "prompt": "#",
              "cmd": "chronyc sources -v",
              "desc": "새 서버가 ^* 로 선택됐는지 확인"
            }
          ]
        },
        {
          "title": "사내 NTP 서버로 변경 후 반영 (Ubuntu)",
          "platforms": [
            "debian"
          ],
          "steps": [
            {
              "prompt": "#",
              "cmd": "cp -p /etc/chrony/chrony.conf /etc/chrony/chrony.conf.bak.$(date +%Y%m%d)",
              "desc": "변경 전 백업"
            },
            {
              "prompt": "#",
              "cmd": "sed -i 's/^pool /#pool /' /etc/chrony/chrony.conf",
              "desc": "기본 pool 줄 주석 처리"
            },
            {
              "prompt": "#",
              "cmd": "echo 'server {{NTP_SERVER}} iburst' >> /etc/chrony/chrony.conf",
              "desc": "사내 NTP 서버 추가"
            },
            {
              "prompt": "#",
              "cmd": "systemctl restart chrony",
              "desc": "서비스 재시작"
            },
            {
              "prompt": "#",
              "cmd": "chronyc sources -v",
              "desc": "새 서버가 ^* 로 선택됐는지 확인"
            }
          ]
        },
        {
          "title": "폐쇄망 NTP 서버로 동작시키기 (RHEL)",
          "command": "cat >> /etc/chrony.conf <<'EOF'\nallow {{CIDR}}\nlocal stratum 10\nEOF\nsystemctl restart chronyd\nfirewall-cmd --permanent --add-service=ntp\nfirewall-cmd --reload",
          "platforms": [
            "rhel"
          ]
        }
      ],
      "cautions": [
        "NTP 는 UDP 123 포트를 사용합니다. 방화벽에서 막혀 있으면 동기화되지 않습니다.",
        "기본 pool 줄을 남겨 두면 폐쇄망에서 응답 없는 소스가 계속 남습니다."
      ],
      "platformNotes": {
        "rhel": "경로는 /etc/chrony.conf, 서비스명은 chronyd 입니다.",
        "debian": "경로는 /etc/chrony/chrony.conf, 서비스명은 chrony 입니다. Ubuntu 는 /etc/chrony/sources.d/*.sources 에 소스를 따로 둘 수 있습니다. 기본 Ubuntu 22.04/24.04 처럼 systemd-timesyncd 를 쓰면 /etc/systemd/timesyncd.conf 의 NTP= 를 설정합니다."
      },
      "help": "man chrony.conf",
      "keywords": [
        "NTP 설정",
        "시간 서버 설정",
        "chrony 설정",
        "chrony.conf",
        "NTP 서버",
        "폐쇄망 시간 동기화"
      ],
      "related": [
        "chronyc",
        "timedatectl",
        "firewall-cmd",
        "systemctl"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "w32tm",
      "name": "w32tm",
      "kind": "command",
      "shell": "cmd",
      "category": "time",
      "task": "time.sync-status",
      "platforms": [
        "windows"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Windows 시간 동기화(W32Time) 상태 확인·NTP 설정",
      "description": "Windows Time 서비스(W32Time)의 동기화 상태와 시간 원본을 확인하고, NTP 서버 지정·즉시 동기화를 수행합니다. 도메인 컴퓨터는 기본적으로 도메인 계층(DC)에서 시간을 받으므로, 외부 NTP 설정은 보통 PDC 에뮬레이터 DC 에서만 합니다.",
      "syntax": [
        "w32tm /query /status",
        "w32tm /config /manualpeerlist:\"{{NTP_SERVER}}\" /syncfromflags:manual /update",
        "w32tm /resync"
      ],
      "options": [
        {
          "flag": "/computer:{{COMPUTER}}",
          "desc": "/query, /resync 를 원격 컴퓨터에 실행"
        },
        {
          "flag": "/verbose",
          "desc": "/query /status 등에서 상세 출력"
        },
        {
          "flag": "/update",
          "desc": "/config 로 바꾼 설정을 서비스에 알림"
        },
        {
          "flag": "/force",
          "desc": "/resync 시 누적 오차를 무시하고 바로 맞춤"
        },
        {
          "flag": "/nowait",
          "desc": "/resync 를 요청만 하고 완료를 기다리지 않음"
        }
      ],
      "commandGroups": [
        {
          "title": "조회",
          "type": "subcommand",
          "items": [
            {
              "cmd": "w32tm /query /status [/verbose]",
              "desc": "동기화 상태, 마지막 동기화 시간, 원본, stratum, 오프셋"
            },
