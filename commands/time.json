{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "time",
  "commands": [
    {
      "id": "date",
      "name": "date",
      "kind": "command",
      "shell": "sh",
      "category": "time",
      "task": "time.date",
      "platforms": [
        "rhel",
        "debian",
        "aix",
        "hpux",
        "solaris"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "현재 날짜·시간 출력, 형식 지정, 날짜 계산",
      "description": "시스템의 현재 날짜와 시간을 출력합니다. +형식 지정으로 파일 이름용 타임스탬프를 만들거나, -d 로 특정 날짜·상대 날짜를 계산하고 epoch 시간을 변환할 수 있습니다. 시간 설정(-s)도 가능하지만 NTP 동기화 중이면 곧 덮어써집니다.",
      "syntax": [
        "date [+{{FORMAT}}]",
        "date -d '{{DATE_STRING}}' [+{{FORMAT}}]",
        "date {{MMDDHHMM}}"
      ],
      "options": [
        {
          "flag": "+{{FORMAT}}",
          "desc": "출력 형식 (%Y 연, %m 월, %d 일, %H 시, %M 분, %S 초, %Z 타임존). %s(epoch)는 GNU/Linux 전용"
        },
        {
          "flag": "-d '{{DATE_STRING}}'",
          "desc": "지정한 날짜 표시·계산 (예: 'yesterday', '7 days ago', '2025-01-01 09:00') (GNU/Linux 전용)"
        },
        {
          "flag": "-u",
          "desc": "UTC 기준으로 출력"
        },
        {
          "flag": "-I[seconds]",
          "desc": "ISO 8601 형식 출력 (GNU/Linux 전용)"
        },
        {
          "flag": "-R",
          "desc": "RFC 5322(메일 헤더) 형식 출력 (GNU/Linux 전용)"
        },
        {
          "flag": "-s '{{DATE_STRING}}'",
          "desc": "시스템 시간 설정 (root 필요) (GNU/Linux 전용)"
        },
        {
          "flag": "-r {{FILE}}",
          "desc": "파일의 마지막 수정 시간 출력 (GNU/Linux 전용)"
        }
      ],
      "commandGroups": [
        {
          "title": "자주 쓰는 형식 지정자",
          "type": "directive",
          "note": "+ 뒤 문자열에 공백이 있으면 따옴표로 감쌉니다: date '+%Y-%m-%d %H:%M:%S'",
          "items": [
            {
              "cmd": "+%Y%m%d_%H%M%S",
              "desc": "파일 이름용 타임스탬프 (20261105_143000)"
            },
            {
              "cmd": "+%Y-%m-%d %H:%M:%S",
              "desc": "로그용 일시"
            },
            {
              "cmd": "+%T",
              "desc": "%H:%M:%S 의 축약"
            },
            {
              "cmd": "+%F",
              "desc": "%Y-%m-%d 의 축약",
              "platforms": [
                "rhel",
                "debian"
              ]
            },
            {
              "cmd": "+%j",
              "desc": "올해의 몇 번째 날 (001~366)"
            },
            {
              "cmd": "+%a / +%u",
              "desc": "요일 이름 / 요일 번호 (1=월요일)"
            },
            {
              "cmd": "+%Z",
              "desc": "타임존 이름 (KST)"
            },
            {
              "cmd": "+%z",
              "desc": "UTC 오프셋 (+0900)",
              "platforms": [
                "rhel",
                "debian"
              ]
            },
            {
              "cmd": "+%s",
              "desc": "1970-01-01 이후 초 (epoch)",
              "platforms": [
                "rhel",
                "debian"
              ]
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "현재 시간 확인",
          "command": "date",
          "output": "Tue Nov  3 14:05:12 KST 2026"
        },
        {
          "title": "파일 이름용 타임스탬프",
          "command": "cp {{FILE}} {{FILE}}.$(date +%Y%m%d_%H%M%S)"
        },
        {
          "title": "epoch 시간을 날짜로 변환",
          "command": "date -d @1700000000",
          "note": "반대로 현재 epoch 는 date +%s",
          "platforms": [
            "rhel",
            "debian"
          ]
        },
        {
          "title": "어제 날짜 구하기 (로그 파일명 등)",
          "command": "date -d 'yesterday' +%Y-%m-%d",
          "platforms": [
            "rhel",
            "debian"
          ]
        },
        {
          "title": "시스템 시간 수동 설정 (Unix)",
          "command": "date {{MMDDHHMM}}",
          "platforms": [
            "aix",
            "hpux",
            "solaris"
          ],
          "note": "월일시분 순서입니다 (예: 11051430 = 11월 5일 14:30). NTP 를 쓰는 서버는 먼저 NTP 동기화 상태를 확인하세요."
        },
        {
          "title": "epoch 시간을 날짜로 변환 (Unix)",
          "command": "perl -le 'print scalar localtime 1700000000'",
          "platforms": [
            "aix",
            "hpux",
            "solaris"
          ],
          "note": "Unix date 에는 -d @{{EPOCH}} 가 없어 perl 로 변환합니다."
        }
      ],
      "cautions": [
        "date -s 로 바꾼 시간은 chronyd·timesyncd 동기화 중이면 다시 맞춰지고, 하드웨어 시계(RTC)에는 자동 반영되지 않을 수 있습니다. 수동 설정은 timedatectl set-time 을 권장합니다.",
        "GNU date 의 -d 로 날짜를 계산하는 스크립트는 AIX·HP-UX·Solaris 에서 그대로 동작하지 않습니다. Solaris 11 은 /usr/gnu/bin/date 를 쓰면 GNU 옵션을 사용할 수 있습니다."
      ],
      "platformNotes": {
        "aix": "형식 지정(+%Y 등)과 -u 는 같습니다. -d, -s, -r, -I 는 없습니다. 설정은 date {{MMDDHHMM}} 이며 -n 을 붙이면 timed 네트워크 시간 갱신을 하지 않습니다.",
        "hpux": "형식 지정과 -u 는 같습니다. GNU 옵션(-d, -s, -r, -I)은 없습니다. 설정은 date {{MMDDHHMM}} 입니다.",
        "solaris": "형식 지정과 -u 는 같습니다. /usr/bin/date 에는 GNU 옵션이 없고, Solaris 11 은 /usr/gnu/bin/date 로 -d 등을 쓸 수 있습니다. 설정은 date {{MMDDHHMM}} 입니다."
      },
      "help": "man date, date --help",
      "keywords": [
        "시간 확인",
        "날짜 확인",
        "현재 시간",
        "타임스탬프",
        "epoch 변환",
        "date"
      ],
      "related": [
        "timedatectl",
        "hwclock",
        "chronyc"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "win-date",
      "name": "date / time",
      "kind": "command",
      "shell": "cmd",
      "category": "time",
      "task": "time.date",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "CMD 에서 현재 날짜·시간 출력 또는 변경",
      "description": "CMD 내장 명령으로 현재 날짜(date)와 시간(time)을 출력하거나 변경합니다. /t 를 붙이면 변경 프롬프트 없이 값만 출력하며, 배치 파일에서는 %date%, %time% 환경 변수로 값을 쓸 수 있습니다.",
      "syntax": [
        "date /t",
        "time /t",
        "date [{{DATE}}]",
        "time [{{TIME}}]"
      ],
      "options": [
        {
          "flag": "date /t",
          "desc": "현재 날짜만 출력"
        },
        {
          "flag": "time /t",
          "desc": "현재 시간(시:분)만 출력"
        }
      ],
      "commandGroups": [
        {
          "title": "배치 파일 변수",
          "type": "directive",
          "items": [
            {
              "cmd": "%date%",
              "desc": "현재 날짜 (형식은 지역 설정에 따름)"
            },
            {
              "cmd": "%time%",
              "desc": "현재 시간 (시:분:초.1/100초)"
            },
            {
              "cmd": "%date:~0,4%",
              "desc": "문자열 잘라 쓰기 (시작 위치, 길이). 지역 설정이 바뀌면 결과가 달라짐"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "날짜·시간 확인",
          "command": "date /t\ntime /t",
          "output": "2026-11-03 (화)\n오후 02:05"
        },
        {
          "title": "초까지 확인",
          "command": "echo %date% %time%"
        }
      ],
      "cautions": [
        "출력 형식이 지역 설정(로캘)에 따라 다르므로 %date% 를 잘라 쓰는 배치 스크립트는 다른 서버에서 깨질 수 있습니다. PowerShell 의 Get-Date -Format 이 안전합니다.",
        "시간을 변경하려면 관리자 권한이 필요하며, 도메인 컴퓨터는 w32time 동기화로 다시 맞춰집니다."
      ],
      "help": "date /?, time /?",
      "keywords": [
        "시간 확인",
        "날짜 확인",
        "현재 시간",
        "date",
        "time",
        "%date%"
      ],
      "related": [
        "get-date",
        "w32tm",
        "tzutil"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "get-date",
      "name": "Get-Date",
      "kind": "command",
      "shell": "powershell",
      "category": "time",
      "task": "time.date",
      "platforms": [
        "windows"
      ],
      "level": "basic",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "PowerShell 현재 날짜·시간 출력·형식 지정·날짜 계산",
      "description": "현재 날짜와 시간을 DateTime 객체로 반환합니다. -Format 으로 원하는 문자열 형식을 만들고, AddDays() 같은 메서드로 날짜를 계산할 수 있어 로그 파일 이름이나 기간 필터에 자주 씁니다. 시간 변경은 Set-Date 를 사용합니다.",
      "syntax": [
        "Get-Date [-Format {{FORMAT}}]",
        "(Get-Date).AddDays({{N}})"
      ],
      "options": [
        {
          "flag": "-Format {{FORMAT}}",
          "desc": ".NET 형식 문자열 (예: 'yyyy-MM-dd HH:mm:ss', 'yyyyMMdd')"
        },
        {
          "flag": "-UFormat {{FORMAT}}",
          "desc": "Unix 스타일 형식 (예: '%Y%m%d', '%s' epoch)"
        },
        {
          "flag": "-Date {{DATE}}",
          "desc": "지정한 날짜 문자열을 DateTime 으로 변환"
        },
        {
          "flag": "-DisplayHint Date|Time",
          "desc": "날짜만 / 시간만 표시"
        },
        {
          "flag": "-AsUTC",
          "desc": "UTC 로 반환 (PowerShell 7.1 이상)"
        }
      ],
      "examples": [
        {
          "title": "형식 지정 출력",
          "command": "Get-Date -Format 'yyyy-MM-dd HH:mm:ss'",
          "output": "2026-11-03 14:05:12"
        },
        {
          "title": "7일 이전 날짜 계산",
          "command": "(Get-Date).AddDays(-7)"
        },
        {
          "title": "날짜 붙인 로그 파일명",
          "command": "\"backup_$(Get-Date -Format yyyyMMdd).zip\""
        },
        {
          "title": "epoch 시간 구하기",
          "command": "Get-Date -UFormat %s"
        },
        {
          "title": "UTC 로 변환 (PowerShell 5.1)",
          "command": "(Get-Date).ToUniversalTime()"
        }
      ],
      "cautions": [],
      "help": "Get-Help Get-Date -Full",
      "keywords": [
        "시간 확인",
        "날짜 확인",
        "날짜 계산",
        "형식 지정",
        "Get-Date",
        "PowerShell 날짜"
      ],
      "related": [
        "win-date",
        "set-timezone",
        "w32tm"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "timedatectl",
      "name": "timedatectl",
      "kind": "command",
      "shell": "sh",
      "category": "time",
      "task": "time.timezone",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "타임존 설정·NTP 동기화 켜기·시간 상태 확인",
      "description": "systemd 의 시간 관리 도구로 현재 시간, 타임존, RTC(하드웨어 시계), NTP 동기화 여부를 한 번에 보여주고 변경합니다. 서버 구축 시 타임존을 Asia/Seoul 로 맞추고 NTP 동기화를 켜는 표준 방법입니다.",
      "syntax": [
        "timedatectl [status]",
        "timedatectl set-timezone {{TIMEZONE}}",
        "timedatectl set-ntp true|false"
      ],
      "options": [
        {
          "flag": "-H {{USER}}@{{HOST}}",
          "desc": "SSH 로 원격 서버의 시간 설정 조회·변경"
        },
        {
          "flag": "--adjust-system-clock",
          "desc": "set-local-rtc 와 함께: RTC 값을 기준으로 시스템 시간도 맞춤"
        },
        {
          "flag": "--no-pager",
          "desc": "list-timezones 등 출력을 페이저 없이 표시"
        },
        {
          "flag": "--no-ask-password",
          "desc": "권한 확인 비밀번호를 묻지 않음 (스크립트용)"
        }
      ],
      "commandGroups": [
        {
          "title": "서브 명령",
          "type": "subcommand",
          "note": "'System clock synchronized: yes' 와 'NTP service: active' 가 함께 나와야 정상입니다.",
          "items": [
            {
              "cmd": "timedatectl [status]",
              "desc": "현재 시간·타임존·NTP 동기화·RTC 상태 (기본 동작)"
            },
            {
              "cmd": "timedatectl show",
              "desc": "상태를 KEY=VALUE 형식으로 (스크립트용)"
            },
            {
              "cmd": "timedatectl list-timezones",
              "desc": "설정 가능한 타임존 목록"
            },
            {
              "cmd": "timedatectl set-timezone {{TIMEZONE}}",
              "desc": "타임존 변경 (예: Asia/Seoul)"
            },
            {
              "cmd": "timedatectl set-ntp true|false",
              "desc": "NTP 동기화 서비스 켜기·끄기 (RHEL chronyd, Ubuntu systemd-timesyncd)"
            },
            {
              "cmd": "timedatectl set-time '{{DATETIME}}'",
              "desc": "시간 수동 설정 (NTP 를 먼저 꺼야 함)"
            },
            {
              "cmd": "timedatectl set-local-rtc 0|1",
              "desc": "하드웨어 시계를 UTC(0, 권장) 또는 로컬 시간(1)으로"
            },
            {
              "cmd": "timedatectl timesync-status",
              "desc": "systemd-timesyncd 동기화 상세 (서버, 오프셋, 폴링 주기)"
            },
            {
              "cmd": "timedatectl show-timesync",
              "desc": "systemd-timesyncd 설정 값 (KEY=VALUE)"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "타임존을 서울로 설정",
          "command": "timedatectl set-timezone Asia/Seoul\ntimedatectl"
        },
        {
          "title": "상태 확인",
          "command": "timedatectl",
          "output": "               Local time: Tue 2026-11-03 14:05:12 KST\n           Universal time: Tue 2026-11-03 05:05:12 UTC\n                 RTC time: Tue 2026-11-03 05:05:12\n                Time zone: Asia/Seoul (KST, +0900)\nSystem clock synchronized: yes\n              NTP service: active\n          RTC in local TZ: no"
        },
        {
          "title": "NTP 없이 시간 수동 설정",
          "command": "timedatectl set-ntp false\ntimedatectl set-time '2026-11-03 14:00:00'"
        },
        {
          "title": "타임존 검색",
          "command": "timedatectl list-timezones | grep -i seoul"
        }
      ],
      "cautions": [
        "타임존 변경은 이미 실행 중인 일부 프로세스(DB, Java 앱 등)에 재시작 전까지 반영되지 않을 수 있습니다.",
        "System clock synchronized: no 이면 NTP 서버 연결 상태를 chronyc sources 등으로 확인하세요.",
        "AIX·HP-UX·Solaris 에는 timedatectl 이 없습니다. 타임존은 AIX 는 /etc/environment 의 TZ(chtz), HP-UX 는 /etc/TIMEZONE, Solaris 10 은 /etc/default/init, Solaris 11 은 svccfg -s timezone:default 로 설정합니다."
      ],
      "platformNotes": {
        "rhel": "set-ntp true 는 chronyd 를 활성화합니다.",
        "debian": "Ubuntu 22.04/24.04 는 기본으로 systemd-timesyncd 를 사용하며 set-ntp true 는 이를 활성화합니다. 동기화 상세는 timedatectl timesync-status 로 확인합니다."
      },
      "help": "man timedatectl",
      "keywords": [
        "타임존 설정",
        "시간대 변경",
        "Asia/Seoul",
        "NTP 켜기",
        "시간 상태",
        "timedatectl",
        "timezone"
      ],
      "related": [
        "chronyc",
        "etc-chrony-conf",
        "date",
        "hwclock"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "tzutil",
      "name": "tzutil",
      "kind": "command",
      "shell": "cmd",
      "category": "time",
      "task": "time.timezone",
      "platforms": [
        "windows"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Windows 표준 시간대 확인·변경",
      "description": "Windows 의 표준 시간대(타임존)를 확인·변경하는 CMD 도구입니다. Windows 는 'Korea Standard Time' 처럼 Windows 고유 시간대 ID 를 사용합니다.",
      "syntax": [
        "tzutil /g",
        "tzutil /s \"{{TIMEZONE_ID}}\"",
        "tzutil /l"
      ],
      "options": [
        {
          "flag": "/g",
          "desc": "현재 시간대 ID 확인"
        },
        {
          "flag": "/s \"{{TIMEZONE_ID}}\"",
          "desc": "시간대 변경 (예: \"Korea Standard Time\")"
        },
        {
          "flag": "/s \"{{TIMEZONE_ID}}_dstoff\"",
          "desc": "일광 절약 시간 조정을 끄고 설정"
        },
        {
          "flag": "/l",
          "desc": "설정 가능한 시간대 ID 목록"
        }
      ],
      "examples": [
        {
          "title": "현재 시간대 확인",
          "command": "tzutil /g",
          "output": "Korea Standard Time"
        },
        {
