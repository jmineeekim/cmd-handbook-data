      ]
    },
    {
      "id": "etc-chrony-conf",
      "name": "/etc/chrony.conf",
      "kind": "file",
      "category": "time",
      "task": "time.sync-status",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "chrony NTP 서버·동기화 정책 설정 파일",
      "description": "chronyd 가 사용할 NTP 서버, 큰 시간 차이 보정 방식, NTP 서버 역할(다른 서버에 시간 제공) 등을 설정합니다. 폐쇄망에서는 기본 공용 pool 을 지우고 사내 NTP 서버를 지정해야 합니다. 경로가 배포판마다 다릅니다.",
      "syntax": [
        "/etc/chrony.conf",
        "/etc/chrony/chrony.conf"
      ],
      "options": [
        {
          "flag": "server {{NTP_SERVER}} iburst",
          "desc": "NTP 서버 지정 (iburst: 시작 시 빠른 동기화)"
        },
        {
          "flag": "pool {{NTP_POOL}} iburst",
          "desc": "여러 주소를 가진 NTP 풀 지정"
        },
        {
          "flag": "makestep 1.0 3",
          "desc": "시작 후 3회까지 1초 이상 차이는 즉시 맞춤"
        },
        {
          "flag": "rtcsync",
          "desc": "하드웨어 시계(RTC)를 주기적으로 동기화"
        },
        {
          "flag": "driftfile {{FILE}}",
          "desc": "시계 오차율 저장 파일"
        },
        {
          "flag": "allow {{CIDR}}",
          "desc": "이 대역의 클라이언트에 NTP 서비스 제공 (NTP 서버 역할)"
        },
        {
          "flag": "local stratum 10",
          "desc": "외부 동기화가 안 돼도 로컬 시계로 시간 제공 (폐쇄망 NTP 서버)"
        },
        {
          "flag": "sourcedir {{DIR}}",
          "desc": "추가 소스 파일(*.sources) 디렉토리"
        }
      ],
      "examples": [
        {
          "title": "사내 NTP 서버로 변경 후 반영 (RHEL)",
          "command": "sed -i 's/^pool /#pool /' /etc/chrony.conf\necho 'server {{NTP_SERVER}} iburst' >> /etc/chrony.conf\nsystemctl restart chronyd\nchronyc sources",
          "platforms": [
            "rhel"
          ]
        },
        {
          "title": "사내 NTP 서버로 변경 후 반영 (Ubuntu)",
          "command": "sed -i 's/^pool /#pool /' /etc/chrony/chrony.conf\necho 'server {{NTP_SERVER}} iburst' >> /etc/chrony/chrony.conf\nsystemctl restart chrony\nchronyc sources",
          "platforms": [
            "debian"
          ]
        },
        {
          "title": "폐쇄망 NTP 서버로 동작시키기 (RHEL)",
          "command": "cat >> /etc/chrony.conf <<'EOF'\nallow {{CIDR}}\nlocal stratum 10\nEOF\nsystemctl restart chronyd\nfirewall-cmd --permanent --add-service=ntp\nfirewall-cmd --reload",
          "platforms": [
            "rhel"
          ]
        }
      ],
      "cautions": [
        "NTP 는 UDP 123 포트를 사용합니다. 방화벽에서 막혀 있으면 동기화되지 않습니다.",
        "기본 pool 줄을 남겨 두면 폐쇄망에서 응답 없는 소스가 계속 남습니다."
      ],
      "platformNotes": {
        "rhel": "경로는 /etc/chrony.conf, 서비스명은 chronyd 입니다.",
        "debian": "경로는 /etc/chrony/chrony.conf, 서비스명은 chrony 입니다. Ubuntu 는 /etc/chrony/sources.d/*.sources 에 소스를 따로 둘 수 있습니다. 기본 Ubuntu 22.04/24.04 처럼 systemd-timesyncd 를 쓰면 /etc/systemd/timesyncd.conf 의 NTP= 를 설정합니다."
      },
      "help": "man chrony.conf",
      "keywords": [
        "NTP 설정",
        "시간 서버 설정",
        "chrony 설정",
        "chrony.conf",
        "NTP 서버",
        "폐쇄망 시간 동기화"
      ],
      "related": [
        "chronyc",
        "timedatectl",
        "firewall-cmd",
        "systemctl"
      ]
    },
    {
      "id": "w32tm",
      "name": "w32tm",
      "kind": "command",
      "shell": "cmd",
      "category": "time",
      "task": "time.sync-status",
      "platforms": [
        "windows"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "Windows 시간 동기화(W32Time) 상태 확인·NTP 설정",
      "description": "Windows Time 서비스(W32Time)의 동기화 상태와 시간 원본을 확인하고, NTP 서버 지정·즉시 동기화를 수행합니다. 도메인 컴퓨터는 기본적으로 도메인 계층(DC)에서 시간을 받으므로, 외부 NTP 설정은 보통 PDC 에뮬레이터 DC 에서만 합니다.",
      "syntax": [
        "w32tm /query /status",
        "w32tm /config /manualpeerlist:\"{{NTP_SERVER}}\" /syncfromflags:manual /update",
        "w32tm /resync"
      ],
      "options": [
        {
          "flag": "/query /status",
          "desc": "동기화 상태, 마지막 동기화 시간, 원본, stratum"
        },
        {
          "flag": "/query /source",
          "desc": "현재 시간 원본"
        },
        {
          "flag": "/query /peers",
          "desc": "설정된 NTP 피어와 상태"
        },
        {
          "flag": "/query /configuration",
          "desc": "W32Time 설정 값"
        },
        {
          "flag": "/config /manualpeerlist:\"{{NTP_SERVER}},0x8\"",
          "desc": "NTP 서버 지정 (여러 개는 공백으로 구분, 0x8 = 클라이언트 모드)"
        },
        {
          "flag": "/config /syncfromflags:manual|domhier",
          "desc": "수동 피어 목록 / 도메인 계층에서 동기화"
        },
        {
          "flag": "/config /reliable:yes",
          "desc": "신뢰할 수 있는 시간 원본으로 알림 (PDC 에뮬레이터용)"
        },
        {
          "flag": "/config ... /update",
          "desc": "변경한 설정을 서비스에 알림"
        },
        {
          "flag": "/resync [/force]",
          "desc": "즉시 다시 동기화"
        },
        {
          "flag": "/stripchart /computer:{{NTP_SERVER}} /samples:5 /dataonly",
          "desc": "대상 서버와의 시간 차이 측정"
        }
      ],
      "examples": [
        {
          "title": "동기화 상태·원본 확인",
          "command": "w32tm /query /status\nw32tm /query /source",
          "note": "원본이 'Local CMOS Clock' 또는 'Free-running System Clock' 이면 NTP 동기화가 안 되는 상태"
        },
        {
          "title": "워크그룹 서버에 NTP 서버 지정",
          "command": "w32tm /config /manualpeerlist:\"{{NTP_SERVER}},0x8\" /syncfromflags:manual /update\nnet stop w32time && net start w32time\nw32tm /resync"
        },
        {
          "title": "NTP 서버와의 시간 차이 측정",
          "command": "w32tm /stripchart /computer:{{NTP_SERVER}} /samples:5 /dataonly"
        },
        {
          "title": "도메인 멤버를 도메인 계층 동기화로 복구",
          "command": "w32tm /config /syncfromflags:domhier /update\nw32tm /resync"
        }
      ],
      "cautions": [
        "도메인 멤버 서버에 manualpeerlist 를 설정하면 DC 와 시간이 어긋나 Kerberos 인증(허용 오차 기본 5분)이 실패할 수 있습니다.",
        "NTP 는 UDP 123 포트를 사용합니다."
      ],
      "help": "w32tm /?",
      "keywords": [
        "시간 동기화",
        "NTP 설정",
        "동기화 상태",
        "Windows Time",
        "w32tm",
        "W32Time",
        "시간 서버"
      ],
      "related": [
        "tzutil",
        "get-date",
        "win-date"
      ]
    },
    {
      "id": "hwclock",
      "name": "hwclock",
      "kind": "command",
      "shell": "sh",
      "category": "time",
      "task": "time.hwclock",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "하드웨어 시계(RTC/BIOS 시간) 확인·동기화",
      "description": "메인보드의 하드웨어 시계(RTC)를 읽거나 시스템 시간과 서로 맞춥니다. 재부팅 후 시간이 틀어지는 문제를 확인할 때, 또는 NTP 없이 시간을 수동 설정한 뒤 RTC 에 저장할 때 사용합니다.",
      "syntax": [
        "hwclock [-r]",
        "hwclock -w | -s"
      ],
      "options": [
        {
          "flag": "-r, --show",
          "desc": "하드웨어 시계 시간 출력 (기본 동작)"
        },
        {
          "flag": "-w, --systohc",
          "desc": "시스템 시간 → 하드웨어 시계로 저장"
        },
        {
          "flag": "-s, --hctosys",
          "desc": "하드웨어 시계 → 시스템 시간으로 설정"
        },
        {
          "flag": "-u, --utc",
          "desc": "하드웨어 시계를 UTC 로 간주 (Linux 권장)"
        },
        {
          "flag": "-l, --localtime",
          "desc": "하드웨어 시계를 로컬 시간으로 간주 (Windows 듀얼부팅 등)"
        },
        {
          "flag": "--verbose",
          "desc": "상세 출력"
        }
      ],
      "examples": [
        {
          "title": "하드웨어 시계와 시스템 시간 비교",
          "command": "hwclock -r\ndate"
        },
        {
          "title": "수동으로 맞춘 시스템 시간을 RTC 에 저장",
          "command": "hwclock -w"
        },
        {
          "title": "RTC 가 UTC 기준인지 확인",
          "command": "timedatectl | grep 'RTC in local TZ'"
        }
      ],
      "cautions": [
        "-s 는 시스템 시간을 RTC 값으로 덮어쓰므로 RTC 가 틀려 있으면 시스템 시간도 틀어집니다.",
        "가상 머신은 하이퍼바이저가 RTC 를 제공하므로 VM 도구·하이퍼바이저 시간 동기화 설정도 확인하세요."
      ],
      "install": {
        "rhel": {
          "package": "util-linux",
          "preinstalled": true
        },
        "debian": {
          "package": "util-linux-extra",
          "preinstalled": true,
          "note": "Ubuntu 22.04 이후 util-linux 에서 분리됨. 컨테이너·최소 이미지에는 없을 수 있음"
        }
      },
      "help": "man hwclock",
      "keywords": [
        "하드웨어 시계",
        "BIOS 시간",
        "RTC",
        "CMOS 시간",
        "hwclock",
        "재부팅 후 시간 틀어짐"
      ],
      "related": [
        "timedatectl",
        "date",
        "chronyc"
      ]
    }
  ]
}
