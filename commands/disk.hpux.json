      "syntax": [
        "lvextend -L {{NEW_SIZE_MB}} /dev/{{VG}}/{{LV}} [/dev/disk/{{DISK}}]",
        "lvextend -l {{NEW_LE_COUNT}} /dev/{{VG}}/{{LV}}",
