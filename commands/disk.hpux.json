{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "disk",
  "commands": [
    {
      "id": "hpux-pvcreate",
      "name": "pvcreate",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "destructive",
      "requiresAdmin": true,
      "summary": "디스크를 LVM 물리 볼륨(PV)으로 초기화 (raw 장치 사용)",
      "description": "새 디스크를 HP-UX LVM 에서 쓸 수 있도록 PV 헤더를 기록합니다. Linux 와 달리 문자(raw) 장치 파일 /dev/rdisk/diskN (레거시 /dev/rdsk/cXtYdZ)을 인자로 줍니다. 이후 vgcreate·vgextend 에는 블록 장치 /dev/disk/diskN 을 씁니다.",
      "syntax": [
        "pvcreate /dev/rdisk/{{DISK}}",
        "pvcreate -f /dev/rdisk/{{DISK}}",
        "pvcreate -B /dev/rdisk/{{DISK}}"
      ],
      "options": [
        {
          "flag": "-f",
          "desc": "기존 LVM·파일시스템 정보가 있어도 강제로 초기화 (기존 데이터 파괴)"
        },
        {
          "flag": "-B",
          "desc": "부트 가능한 PV 로 만듦 (루트 미러용. Itanium 은 idisk 로 파티션을 먼저 만들고 /dev/rdisk/{{DISK}}_p2 에 적용)"
        }
      ],
      "examples": [
        {
          "title": "새 디스크가 비어 있는지 확인한 뒤 PV 생성",
          "command": "ioscan -fnNC disk\ndiskinfo /dev/rdisk/{{DISK}}\nstrings /etc/lvmtab /etc/lvmtab_p | grep {{DISK}}\npvcreate /dev/rdisk/{{DISK}}",
          "note": "lvmtab(1.0)·lvmtab_p(2.x)에 이미 있는 디스크면 다른 VG 가 쓰는 중입니다. 클러스터·공유 스토리지에서는 다른 노드 VG 소속인지도 확인하세요."
        }
      ],
      "cautions": [
        "다른 서버(클러스터 노드)의 VG 에 속한 공유 LUN 에 pvcreate -f 를 하면 그 VG 가 깨집니다. 스토리지 담당자와 LUN ID·WWID(scsimgr get_info)를 반드시 대조하세요.",
        "블록 장치(/dev/disk/…)가 아닌 문자 장치(/dev/rdisk/…)를 지정합니다."
      ],
      "platformNotes": {
        "hpux": "11i v3 는 영구(agile) DSF /dev/disk/diskN 을 권장합니다. 레거시 /dev/dsk/cXtYdZ 와의 대응은 ioscan -m dsf 로 확인합니다."
      },
      "help": "man pvcreate",
      "keywords": [
        "PV 생성",
        "디스크 초기화",
        "물리 볼륨",
        "pvcreate",
        "rdisk",
        "HP-UX LVM"
      ],
      "related": [
        "hpux-vgextend",
        "hpux-vgcreate",
        "hpux-ioscan",
        "hpux-insf",
        "hpux-pvdisplay"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-pvdisplay",
      "name": "pvdisplay",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "PV 상태·소속 VG·PE 사용량 확인",
      "description": "물리 볼륨의 소속 VG, PE 크기, 전체·여유 PE, 상태(available/unavailable)를 보여 줍니다. -v 를 주면 이 PV 위에 어떤 LV 의 PE 가 놓여 있는지까지 나옵니다. 디스크 교체·VG 축소 전에 확인용으로 씁니다.",
      "syntax": [
        "pvdisplay /dev/disk/{{DISK}}",
        "pvdisplay -v /dev/disk/{{DISK}}"
      ],
      "options": [
        {
          "flag": "-v",
          "desc": "PE 단위 배치와 이 PV 를 쓰는 LV 목록까지 표시"
        }
      ],
      "examples": [
        {
          "title": "PV 의 소속 VG 와 여유 PE 확인",
          "command": "pvdisplay /dev/disk/{{DISK}}"
        },
        {
          "title": "이 디스크에 어떤 LV 가 올라가 있는지 확인",
          "command": "pvdisplay -v /dev/disk/{{DISK}} | more"
        }
      ],
      "cautions": [
        "레거시 장치명과 영구 장치명이 섞여 있는 VG 는 vgdisplay -v 의 PV Name 에 나온 이름을 그대로 써야 결과가 나옵니다."
      ],
      "help": "man pvdisplay",
      "keywords": [
        "PV 확인",
        "물리 볼륨",
        "pvdisplay",
        "Free PE",
        "디스크 소속 VG"
      ],
      "related": [
        "hpux-vgdisplay",
        "hpux-lvdisplay",
        "hpux-pvcreate",
        "hpux-vgreduce"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-vgcreate",
      "name": "vgcreate",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "볼륨 그룹(VG) 생성 (1.0 은 group 파일 필요)",
      "description": "PV 를 묶어 새 VG 를 만듭니다. VG 버전 1.0 은 전통적으로 /dev/{{VG}} 디렉토리와 group 장치 파일(major 64)을 mknod 로 먼저 만들어야 하고, 최대 PV·LV·PE 수가 생성 때 고정됩니다. 11i v3 의 버전 2.x(-V 2.0 이상)는 -S 로 최대 VG 크기를 지정하며 group 파일을 자동으로 만듭니다.",
      "syntax": [
        "vgcreate [-s {{PE_SIZE_MB}}] [-e {{MAX_PE}}] [-p {{MAX_PV}}] /dev/{{VG}} /dev/disk/{{DISK}}",
        "vgcreate -V 2.0 -s {{PE_SIZE_MB}} -S {{MAX_VG_SIZE}} /dev/{{VG}} /dev/disk/{{DISK}}"
      ],
      "options": [
        {
          "flag": "-s {{PE_SIZE_MB}}",
          "desc": "PE 크기(MB). 기본 4MB. 나중에 바꿀 수 없음"
        },
        {
          "flag": "-e {{MAX_PE}}",
          "desc": "PV 당 최대 PE 수 (1.0 전용, 큰 디스크를 나중에 추가할 계획이면 넉넉하게)"
        },
        {
          "flag": "-p {{MAX_PV}}",
          "desc": "VG 최대 PV 수 (1.0 전용)"
        },
        {
          "flag": "-l {{MAX_LV}}",
          "desc": "VG 최대 LV 수 (1.0 전용)"
        },
        {
          "flag": "-V {{VERSION}}",
          "desc": "VG 버전 (1.0, 2.0, 2.1, 2.2 … 사용 가능한 값은 OS 업데이트 수준에 따라 다름)"
        },
        {
          "flag": "-S {{MAX_VG_SIZE}}",
          "desc": "최대 VG 크기 (2.x 필수, 예: 2t, 500g)"
        }
      ],
      "examples": [
        {
          "title": "버전 1.0 VG 생성 (group 파일 직접 생성)",
          "steps": [
            {
              "prompt": "#",
              "cmd": "ls -l /dev/*/group",
              "desc": "기존 VG 의 minor 번호(0x010000 등) 확인 — 겹치지 않는 번호 선택"
            },
            {
              "prompt": "#",
              "cmd": "mkdir /dev/{{VG}}",
              "desc": "VG 디렉토리 생성"
            },
            {
              "prompt": "#",
              "cmd": "mknod /dev/{{VG}}/group c 64 0x{{NN}}0000",
              "desc": "group 장치 파일 생성 (major 64, NN 은 VG 마다 고유)"
            },
            {
              "prompt": "#",
              "cmd": "vgcreate -s 32 -e 65535 /dev/{{VG}} /dev/disk/{{DISK}}",
              "desc": "PE 32MB 로 VG 생성"
            },
            {
              "prompt": "#",
              "cmd": "vgdisplay -v /dev/{{VG}}",
              "desc": "결과 확인"
            }
          ]
        },
        {
          "title": "버전 2.x VG 생성",
          "command": "vgcreate -V 2.0 -s 32 -S 4t /dev/{{VG}} /dev/disk/{{DISK}}\nvgdisplay /dev/{{VG}}",
          "version": "HP-UX 11i v3 0803 이상"
        }
      ],
      "cautions": [
        "1.0 VG 의 -e·-p 값은 나중에 늘리기 어렵습니다(11i v3 최신 업데이트의 vgmodify 로 일부 가능). 확장 계획을 고려해 정하세요.",
        "Serviceguard 공유 VG 는 모든 노드에서 같은 VG 이름·minor 번호를 쓰는 것이 관례입니다.",
        "생성 후 vgcfgbackup 이 자동으로 /etc/lvmconf/{{VG}}.conf 에 저장되는지 확인하세요."
      ],
      "help": "man vgcreate · man lvm",
      "keywords": [
        "VG 생성",
        "볼륨 그룹",
        "vgcreate",
        "mknod group",
        "VG 버전 2.0",
        "PE 크기"
      ],
      "related": [
        "hpux-pvcreate",
        "hpux-vgextend",
        "hpux-vgdisplay",
        "hpux-lvcreate",
        "hpux-vgcfgbackup"
      ],
      "review": {
        "status": "ai-draft",
        "note": "최근 11i v3 업데이트에서 1.0 VG 의 group 파일 자동 생성 여부는 현장 확인 필요"
      }
    },
    {
      "id": "hpux-vgextend",
      "name": "vgextend",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.extend",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "VG 에 새 PV(디스크) 추가",
      "description": "pvcreate 로 초기화한 디스크를 기존 VG 에 추가해 여유 PE 를 늘립니다. 블록 장치 /dev/disk/diskN 을 지정합니다. 1.0 VG 는 생성 때 정한 최대 PV 수(Max PV)를 넘을 수 없습니다.",
      "syntax": [
        "vgextend /dev/{{VG}} /dev/disk/{{DISK}}"
      ],
      "options": [],
      "examples": [
        {
          "title": "새 디스크 추가 → PV 생성 → VG 확장",
          "steps": [
            {
              "prompt": "#",
              "cmd": "ioscan -fnNC disk",
              "desc": "새 LUN 이 CLAIMED 로 보이는지 확인 (안 보이면 스토리지 매핑 확인)"
            },
            {
              "prompt": "#",
              "cmd": "insf -e -C disk",
              "desc": "새 디스크의 장치 파일 생성"
            },
            {
              "prompt": "#",
              "cmd": "ioscan -m dsf",
              "desc": "영구 DSF(/dev/rdisk/diskN)와 레거시 장치명 대응 확인"
            },
            {
              "prompt": "#",
              "cmd": "diskinfo /dev/rdisk/{{DISK}}",
              "desc": "용량으로 요청한 LUN 이 맞는지 확인"
            },
            {
              "prompt": "#",
              "cmd": "pvcreate /dev/rdisk/{{DISK}}",
              "desc": "PV 초기화 (raw 장치)"
            },
            {
              "prompt": "#",
              "cmd": "vgextend /dev/{{VG}} /dev/disk/{{DISK}}",
              "desc": "VG 에 추가 (블록 장치)"
            },
            {
              "prompt": "#",
              "cmd": "vgdisplay -v /dev/{{VG}} | grep -E 'Free PE|PV Name'",
              "desc": "여유 PE 증가와 PV 목록 확인"
            }
          ]
        }
      ],
      "cautions": [
        "Serviceguard 공유 VG 라면 다른 노드에서도 vgexport -p -s -m 맵 파일로 VG 정보를 갱신(vgimport)해야 페일오버 때 문제가 없습니다.",
        "1.0 VG 에서 'Max PV' 에 도달했거나 새 디스크가 'Max PE per PV' 보다 크면 추가가 실패하거나 일부만 쓰입니다."
      ],
      "help": "man vgextend",
      "keywords": [
        "VG 확장",
        "디스크 추가",
        "vgextend",
        "PV 추가",
        "HP-UX LVM"
      ],
      "related": [
        "hpux-pvcreate",
        "hpux-ioscan",
        "hpux-insf",
        "hpux-vgdisplay",
        "hpux-lvextend",
        "hpux-vgexport"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-vgreduce",
      "name": "vgreduce",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "VG 에서 PV(디스크) 제거",
      "description": "VG 에서 디스크를 빼냅니다. 제거할 PV 에 할당된 PE 가 하나도 없어야 합니다(pvdisplay 의 Allocated PE 0). LV 가 남아 있다면 pvmove 로 다른 PV 로 옮기거나 미러를 줄인 뒤 실행합니다.",
      "syntax": [
        "vgreduce /dev/{{VG}} /dev/disk/{{DISK}}"
      ],
      "options": [],
      "examples": [
        {
          "title": "디스크를 비운 뒤 VG 에서 제거",
          "command": "pvdisplay -v /dev/disk/{{DISK}} | more\npvmove /dev/disk/{{DISK}} /dev/disk/{{TARGET_DISK}}\nvgreduce /dev/{{VG}} /dev/disk/{{DISK}}\nvgdisplay -v /dev/{{VG}}",
          "note": "pvmove 는 오래 걸리고 I/O 부하가 큽니다. 업무 시간 외에 하세요."
        }
      ],
      "cautions": [
        "VG 의 마지막 PV 는 vgreduce 로 뺄 수 없습니다(VG 삭제는 vgremove).",
        "제거 후 스토리지에서 LUN 을 회수하기 전에 rmsf 로 장치 파일을 정리하세요."
      ],
      "help": "man vgreduce",
      "keywords": [
        "VG 축소",
        "디스크 제거",
        "vgreduce",
        "pvmove",
        "PV 제거"
      ],
      "related": [
        "hpux-pvdisplay",
        "hpux-vgdisplay",
        "hpux-rmsf",
        "hpux-lvreduce"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-vgdisplay",
      "name": "vgdisplay",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "critical",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "VG 정보·여유 PE 확인 (확장 전 필수)",
      "description": "VG 의 상태, PE 크기, 전체·할당·여유 PE, 소속 LV·PV 를 보여 줍니다. 여유 용량(MB)은 'Free PE × PE Size' 로 계산합니다. 인자를 생략하면 활성화된 모든 VG 를 보여 줍니다.",
      "syntax": [
        "vgdisplay [-v] [/dev/{{VG}}]"
      ],
      "options": [
        {
          "flag": "-v",
          "desc": "VG 에 속한 LV 목록과 PV 목록까지 표시"
        }
      ],
      "commandGroups": [
        {
          "title": "주요 출력 항목",
          "type": "directive",
          "items": [
            {
              "cmd": "VG Status",
              "desc": "available 이면 활성, 아니면 vgchange -a y 필요 (클러스터 VG 는 available, exclusive 로 표시)"
            },
            {
              "cmd": "PE Size (Mbytes)",
              "desc": "PE 하나의 크기"
            },
            {
              "cmd": "Total PE / Alloc PE / Free PE",
              "desc": "전체·사용·여유 PE 수. 여유 용량 = Free PE × PE Size"
            },
            {
              "cmd": "Cur PV / Act PV",
              "desc": "등록된 PV 수와 실제 접근 가능한 PV 수. 다르면 디스크 장애·경로 문제"
            },
            {
              "cmd": "Max PV / Max PE per PV",
              "desc": "1.0 VG 의 한계값 (디스크 추가 계획 시 확인)"
            },
            {
              "cmd": "VG Version",
              "desc": "1.0 또는 2.x"
            }
          ]
        }
      ],
      "examples": [
        {
          "title": "VG 여유 공간 확인",
          "command": "vgdisplay /dev/{{VG}} | grep -E 'PE Size|Free PE|VG Status'"
        },
        {
          "title": "VG 의 LV·PV 전체 보기",
          "command": "vgdisplay -v /dev/{{VG}} | more"
        },
        {
          "title": "모든 VG 요약",
          "command": "vgdisplay"
        }
      ],
      "cautions": [
        "Cur PV 와 Act PV 가 다르면 LV 확장 등 변경 작업을 멈추고 디스크·경로 상태(ioscan -P health)를 먼저 확인하세요."
      ],
      "help": "man vgdisplay",
      "keywords": [
        "VG 확인",
        "여유 PE",
        "Free PE",
        "vgdisplay",
        "볼륨 그룹 용량",
        "HP-UX LVM"
      ],
      "related": [
        "hpux-lvdisplay",
        "hpux-pvdisplay",
        "hpux-lvextend",
        "hpux-bdf",
        "hpux-vgextend"
      ],
      "review": {
        "status": "ai-draft"
      }
    },
    {
      "id": "hpux-vgchange",
      "name": "vgchange",
      "kind": "command",
      "shell": "sh",
      "category": "disk",
      "task": "disk.lvm",
      "platforms": [
        "hpux"
      ],
      "level": "frequent",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "VG 활성화·비활성화, 클러스터 속성 설정",
      "description": "VG 를 활성화(-a y)하거나 비활성화(-a n)합니다. Serviceguard 환경에서는 공유 VG 를 클러스터 VG 로 표시(-c y)하고, 패키지가 배타 모드(-a e)로 활성화합니다. VG 를 비활성화하려면 그 위의 파일시스템을 먼저 umount 해야 합니다.",
      "syntax": [
        "vgchange -a y|n /dev/{{VG}}",
        "vgchange -a e /dev/{{VG}}",
        "vgchange -c y|n /dev/{{VG}}"
      ],
      "options": [
        {
          "flag": "-a y",
          "desc": "VG 활성화"
        },
        {
          "flag": "-a n",
          "desc": "VG 비활성화 (LV 를 쓰는 프로세스·마운트가 없어야 함)"
        },
        {
          "flag": "-a e",
          "desc": "배타 모드 활성화 (Serviceguard 클러스터 VG)"
        },
        {
          "flag": "-a r",
          "desc": "읽기 전용 활성화"
        },
        {
          "flag": "-c y|n",
