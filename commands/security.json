{
  "$schema": "../schema/commands.schema.json",
  "schemaVersion": 1,
  "category": "security",
  "commands": [
    {
      "id": "w",
      "name": "w",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.sessions",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "현재 접속자와 각자 실행 중인 작업 확인",
      "description": "현재 로그인한 사용자, 접속 터미널(TTY), 접속 출발지, 로그인 시각, 유휴 시간, 실행 중인 명령을 보여 줍니다. 첫 줄에는 uptime 과 같은 가동 시간·부하 정보가 나옵니다.",
      "syntax": [
        "w [{{USER}}]"
      ],
      "options": [
        {
          "flag": "-h",
          "desc": "헤더(첫 줄 가동 시간·부하) 생략"
        },
        {
          "flag": "-s",
          "desc": "짧은 형식 (LOGIN@, JCPU, PCPU 생략)"
        },
        {
          "flag": "-f",
          "desc": "FROM(접속 출발지) 열 표시 전환"
        },
        {
          "flag": "-u",
          "desc": "현재 프로세스·CPU 시간 계산 시 사용자 이름 무시"
        }
      ],
      "examples": [
        {
          "title": "현재 접속자 확인",
          "command": "w",
          "output": " 10:12:01 up 12 days,  3:04,  2 users,  load average: 0.10, 0.08, 0.05\nUSER     TTY      FROM             LOGIN@   IDLE   JCPU   PCPU WHAT\nadmin    pts/0    10.0.0.15        09:58    0.00s  0.05s  0.00s w"
        },
        {
          "title": "특정 사용자 세션만",
          "command": "w {{USER}}"
        }
      ],
      "cautions": [],
      "help": "man w",
      "keywords": [
        "접속자",
        "로그인 사용자",
        "현재 세션",
        "w",
        "who",
        "idle"
      ],
      "related": [
        "who",
        "last",
        "uptime"
      ]
    },
    {
      "id": "who",
      "name": "who",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.sessions",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "로그인 사용자·마지막 부팅 시각 확인",
      "description": "현재 로그인한 사용자와 터미널, 로그인 시각, 접속 출발지를 보여 줍니다. -b 로 마지막 부팅 시각을, who am i 로 현재 터미널의 원래 로그인 사용자를 확인할 수 있습니다.",
      "syntax": [
        "who [{{OPTION}}]",
        "who am i"
      ],
      "options": [
        {
          "flag": "-b",
          "desc": "마지막 시스템 부팅 시각"
        },
        {
          "flag": "-r",
          "desc": "현재 런레벨(타깃)"
        },
        {
          "flag": "-H",
          "desc": "열 제목 표시"
        },
        {
          "flag": "-u",
          "desc": "유휴 시간과 PID 표시"
        },
        {
          "flag": "-q",
          "desc": "로그인 이름과 사용자 수만"
        },
        {
          "flag": "-a",
          "desc": "모든 정보 (-b -d -l -p -r -t -T -u)"
        }
      ],
      "examples": [
        {
          "title": "현재 로그인 사용자",
          "command": "who -H"
        },
        {
          "title": "마지막 부팅 시각",
          "command": "who -b",
          "output": "         system boot  2026-10-22 03:14"
        },
        {
          "title": "sudo 이후에도 원래 로그인 계정 확인",
          "command": "who am i"
        }
      ],
      "cautions": [],
      "help": "man who",
      "keywords": [
        "로그인 사용자",
        "부팅 시각",
        "접속자",
        "who",
        "who am i",
        "boot time"
      ],
      "related": [
        "w",
        "last",
        "whoami",
        "uptime"
      ]
    },
    {
      "id": "quser",
      "name": "quser",
      "aliases": [
        "query user"
      ],
      "kind": "command",
      "shell": "cmd",
      "category": "security",
      "task": "security.sessions",
      "platforms": [
        "windows"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "로그온한 사용자·RDP 세션 목록 확인",
      "description": "로컬 또는 원격 서버에 로그온한 사용자의 세션 이름, 세션 ID, 상태(활성·연결 끊김), 유휴 시간, 로그온 시각을 보여 줍니다. 연결이 끊긴 RDP 세션을 찾아 logoff 로 정리할 때 사용합니다.",
      "syntax": [
        "quser [{{USER}}] [/server:{{HOST}}]",
        "query user [/server:{{HOST}}]"
      ],
      "options": [
        {
          "flag": "/server:{{HOST}}",
          "desc": "원격 서버의 세션 조회"
        },
        {
          "flag": "{{USER}}",
          "desc": "특정 사용자만 조회"
        },
        {
          "flag": "query session",
          "desc": "세션 전체(콘솔·서비스 포함) 목록"
        },
        {
          "flag": "logoff {{SESSION_ID}}",
          "desc": "세션 강제 로그오프"
        }
      ],
      "examples": [
        {
          "title": "현재 로그온 사용자",
          "command": "quser",
          "output": " USERNAME     SESSIONNAME   ID  STATE   IDLE TIME  LOGON TIME\n>admin        rdp-tcp#3      2  Active          .  2026-11-03 09:10\n user01                      3  Disc        2:15  2026-11-02 18:02"
        },
        {
          "title": "원격 서버 세션 확인 후 끊긴 세션 정리",
          "command": "quser /server:{{HOST}}\nlogoff {{SESSION_ID}} /server:{{HOST}}"
        }
      ],
      "cautions": [
        "logoff 는 해당 세션에서 저장하지 않은 작업을 모두 종료합니다."
      ],
      "platformNotes": {
        "windows": "Windows Home 에디션에는 없습니다. 원격 조회는 대상 서버에서 RPC·원격 데스크톱 관련 권한이 필요합니다."
      },
      "help": "quser /?",
      "keywords": [
        "접속자",
        "RDP 세션",
        "로그온 사용자",
        "quser",
        "query user",
        "logoff",
        "원격 데스크톱"
      ],
      "related": [
        "get-winevent",
        "win-shutdown"
      ]
    },
    {
      "id": "last",
      "name": "last",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.login-history",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "로그인·재부팅 이력 조회 (wtmp)",
      "description": "/var/log/wtmp 를 읽어 사용자 로그인·로그아웃, 시스템 재부팅·종료 이력을 최근 순으로 보여 줍니다. 장애 발생 시각 전후로 누가 접속했는지, 언제 재부팅됐는지 확인할 때 사용합니다.",
      "syntax": [
        "last [-n {{COUNT}}] [{{USER}}]",
        "last reboot"
      ],
      "options": [
        {
          "flag": "-n {{COUNT}}",
          "desc": "최근 N 개만 표시"
        },
        {
          "flag": "-x",
          "desc": "시스템 종료·런레벨 변경 기록도 표시"
        },
        {
          "flag": "-F",
          "desc": "로그인·로그아웃 날짜와 시간을 전체 형식으로"
        },
        {
          "flag": "-i",
          "desc": "출발지를 IP 주소로 표시"
        },
        {
          "flag": "-s {{TIME}} / -t {{TIME}}",
          "desc": "지정 시각 이후 / 이전 기록 (예: -s yesterday, -s '2026-11-01 09:00')"
        },
        {
          "flag": "-w",
          "desc": "사용자·도메인 이름을 잘리지 않게 전체 표시"
        },
        {
          "flag": "-f {{FILE}}",
          "desc": "다른 wtmp 파일 읽기 (예: 순환된 /var/log/wtmp.1)"
        }
      ],
      "examples": [
        {
          "title": "최근 20건 로그인 이력",
          "command": "last -n 20 -F -i"
        },
        {
          "title": "재부팅·종료 이력",
          "command": "last -x reboot shutdown | head",
          "output": "reboot   system boot  5.14.0-427.el9.x86_64 Tue Oct 22 03:14   still running"
        },
        {
          "title": "특정 기간 접속자",
          "command": "last -s '2026-11-01 00:00' -t '2026-11-02 00:00'"
        }
      ],
      "cautions": [
        "wtmp 는 logrotate 로 순환되므로 오래된 기록은 /var/log/wtmp.1 등에 있거나 삭제되었을 수 있습니다."
      ],
      "help": "man last",
      "keywords": [
        "로그인 이력",
        "접속 기록",
        "재부팅 이력",
        "last",
        "wtmp",
        "reboot"
      ],
      "related": [
        "lastb",
        "lastlog",
        "w",
        "who",
        "journalctl"
      ]
    },
    {
      "id": "lastb",
      "name": "lastb",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.login-history",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": true,
      "summary": "로그인 실패 이력 조회 (btmp)",
      "description": "/var/log/btmp 에 기록된 로그인 실패 시도를 보여 줍니다. 무차별 대입(brute force) 공격 출발지나 계정 잠금 원인을 확인할 때 사용하며, root 권한이 필요합니다.",
      "syntax": [
        "lastb [-n {{COUNT}}] [{{USER}}]"
      ],
      "options": [
        {
          "flag": "-n {{COUNT}}",
          "desc": "최근 N 개만 표시"
        },
        {
          "flag": "-i",
          "desc": "출발지를 IP 주소로 표시"
        },
        {
          "flag": "-F",
          "desc": "날짜·시간 전체 형식"
        },
        {
          "flag": "-s {{TIME}} / -t {{TIME}}",
          "desc": "기간 지정"
        },
        {
          "flag": "-w",
          "desc": "이름 전체 표시"
        }
      ],
      "examples": [
        {
          "title": "최근 로그인 실패 20건",
          "command": "lastb -n 20 -i"
        },
        {
          "title": "실패 시도가 많은 출발지 IP 순위",
          "command": "lastb -i | awk '{print $3}' | sort | uniq -c | sort -rn | head"
        },
        {
          "title": "SSH 실패 로그로 교차 확인",
          "command": "journalctl -u sshd --since today | grep 'Failed password'",
          "platforms": [
            "rhel"
          ],
          "note": "Ubuntu 는 -u ssh"
        }
      ],
      "cautions": [
        "btmp 에는 사용자가 실수로 아이디 칸에 입력한 비밀번호가 남을 수 있으므로 출력을 외부로 공유할 때 주의하세요."
      ],
      "help": "man lastb",
      "keywords": [
        "로그인 실패",
        "실패 이력",
        "무차별 대입",
        "brute force",
        "lastb",
        "btmp"
      ],
      "related": [
        "last",
        "lastlog",
        "journalctl"
      ]
    },
    {
      "id": "lastlog",
      "name": "lastlog",
      "aliases": [
        "lastlog2"
      ],
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.login-history",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "frequent",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "계정별 마지막 로그인 시각 조회",
      "description": "모든 계정(또는 지정 계정)의 마지막 로그인 시각과 출발지를 보여 줍니다. 오랫동안 사용하지 않은 계정을 찾는 보안 점검에 유용합니다.",
      "syntax": [
        "lastlog [-u {{USER}}]"
      ],
      "options": [
        {
          "flag": "-u {{USER}}",
          "desc": "특정 사용자만 표시"
        },
        {
          "flag": "-b {{DAYS}}",
          "desc": "N 일 이전에 마지막으로 로그인한 계정만 (장기 미사용)"
        },
        {
          "flag": "-t {{DAYS}}",
          "desc": "최근 N 일 이내에 로그인한 계정만"
        }
      ],
      "examples": [
        {
          "title": "로그인한 적 있는 계정만 보기",
          "command": "lastlog | grep -v 'Never logged in'"
        },
        {
          "title": "90일 넘게 로그인하지 않은 계정",
          "command": "lastlog -b 90"
        }
      ],
      "cautions": [],
      "platformNotes": {
        "debian": "Debian 13 등 최신 배포판 일부는 lastlog 대신 util-linux 의 lastlog2 를 사용합니다. 기준 버전(Ubuntu 22.04/24.04, Debian 12)에는 lastlog 가 있습니다."
      },
      "help": "man lastlog",
      "keywords": [
        "마지막 로그인",
        "미사용 계정",
        "계정 점검",
        "lastlog",
        "lastlog2"
      ],
      "related": [
        "last",
        "lastb"
      ]
    },
    {
      "id": "getenforce",
      "name": "getenforce",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.mac",
      "platforms": [
        "rhel"
      ],
      "level": "critical",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SELinux 현재 모드 확인",
      "description": "SELinux 의 현재 동작 모드를 Enforcing, Permissive, Disabled 중 하나로 출력합니다. 서비스가 이유 없이 권한 거부될 때 가장 먼저 확인합니다.",
      "syntax": [
        "getenforce"
      ],
      "options": [],
      "examples": [
        {
          "title": "SELinux 모드 확인",
          "command": "getenforce",
          "output": "Enforcing"
        }
      ],
      "cautions": [],
      "install": {
        "rhel": {
          "package": "libselinux-utils",
          "preinstalled": true
        }
      },
      "help": "man getenforce",
      "keywords": [
        "SELinux 확인",
        "SELinux 모드",
        "getenforce",
        "Enforcing",
        "Permissive"
      ],
      "related": [
        "setenforce",
        "sestatus"
      ]
    },
    {
      "id": "setenforce",
      "name": "setenforce",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.mac",
      "platforms": [
        "rhel"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SELinux Enforcing↔Permissive 임시 전환",
      "description": "SELinux 를 Enforcing(1) 과 Permissive(0) 사이에서 즉시 전환합니다. 재부팅하면 /etc/selinux/config 의 설정으로 돌아갑니다. 문제가 SELinux 때문인지 잠깐 확인하는 용도로만 쓰고, 원인은 컨텍스트·boolean 으로 해결합니다.",
      "syntax": [
        "setenforce 0|1"
      ],
      "options": [
        {
          "flag": "0 (Permissive)",
          "desc": "차단하지 않고 위반만 기록"
        },
        {
          "flag": "1 (Enforcing)",
          "desc": "정책 위반을 차단"
        }
      ],
      "examples": [
        {
          "title": "SELinux 원인 여부 잠깐 확인 후 되돌리기",
          "command": "setenforce 0\n# 서비스 재시도\nsetenforce 1\nausearch -m AVC -ts recent",
          "note": "ausearch 로 거부(AVC) 로그 확인 후 restorecon·semanage 로 해결"
        },
        {
          "title": "영구 설정 확인",
          "command": "grep ^SELINUX= /etc/selinux/config"
        }
      ],
      "cautions": [
        "운영 서버에서 setenforce 0 상태로 방치하면 보안 통제가 꺼진 것과 같습니다. 확인이 끝나면 즉시 1 로 되돌리세요.",
        "Disabled 상태에서는 setenforce 로 켤 수 없습니다. config 수정 후 재부팅(전체 relabel)이 필요합니다.",
        "SELINUX=disabled 로 끄는 것은 권장되지 않습니다. 다시 켤 때 전체 파일 relabel 로 부팅이 오래 걸립니다."
      ],
      "install": {
        "rhel": {
          "package": "libselinux-utils",
          "preinstalled": true
        }
      },
      "help": "man setenforce",
      "keywords": [
        "SELinux 끄기",
        "SELinux 전환",
        "Permissive",
        "setenforce",
        "SELinux"
      ],
      "related": [
        "getenforce",
        "sestatus",
        "semanage",
        "restorecon"
      ]
    },
    {
      "id": "sestatus",
      "name": "sestatus",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.mac",
      "platforms": [
        "rhel"
      ],
      "level": "critical",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "SELinux 상태·정책·설정 모드 상세 확인",
      "description": "SELinux 활성 여부, 현재 모드, config 파일에 설정된 모드, 로드된 정책 이름(targeted 등)을 함께 보여 줍니다. -b 로 boolean 값 목록도 볼 수 있습니다.",
      "syntax": [
        "sestatus [-v] [-b]"
      ],
      "options": [
        {
          "flag": "-v",
          "desc": "/etc/sestatus.conf 에 지정된 파일·프로세스의 컨텍스트도 표시"
        },
        {
          "flag": "-b",
          "desc": "boolean 현재 값 목록 표시"
        }
      ],
      "examples": [
        {
          "title": "SELinux 상태 확인",
          "command": "sestatus",
          "output": "SELinux status:                 enabled\nLoaded policy name:             targeted\nCurrent mode:                   enforcing\nMode from config file:          enforcing"
        },
        {
          "title": "특정 boolean 값 찾기",
          "command": "sestatus -b | grep httpd"
        }
      ],
      "cautions": [],
      "install": {
        "rhel": {
          "package": "policycoreutils",
          "preinstalled": true
        }
      },
