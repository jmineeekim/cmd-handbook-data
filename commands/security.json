    {
      "id": "semanage",
      "name": "semanage",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.mac",
      "platforms": [
        "rhel"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "SELinux 포트·파일 컨텍스트·boolean 영구 설정",
      "description": "SELinux 정책의 포트 레이블, 파일 컨텍스트 규칙, boolean 등을 영구적으로 추가·변경·삭제합니다. 서비스를 비표준 포트나 비표준 경로로 옮길 때 setenforce 0 대신 이 명령으로 정책을 맞춥니다.",
      "syntax": [
        "semanage port -a -t {{TYPE}} -p tcp {{PORT}}",
        "semanage fcontext -a -t {{TYPE}} '{{PATH}}(/.*)?'",
        "semanage boolean -m --on {{BOOLEAN}}"
      ],
      "options": [
        {
          "flag": "port -l",
          "desc": "포트 레이블 목록 (예: http_port_t 에 허용된 포트)"
        },
        {
          "flag": "port -a -t {{TYPE}} -p tcp {{PORT}}",
          "desc": "포트에 SELinux 타입 추가 (-m 수정, -d 삭제)"
        },
        {
          "flag": "fcontext -l",
          "desc": "파일 컨텍스트 규칙 목록"
        },
        {
          "flag": "fcontext -a -t {{TYPE}} '{{REGEX}}'",
          "desc": "경로 패턴에 컨텍스트 규칙 추가 (적용은 restorecon)"
        },
        {
          "flag": "boolean -l",
          "desc": "boolean 목록과 현재·기본 값"
        },
        {
          "flag": "boolean -m --on {{BOOLEAN}}",
          "desc": "boolean 영구 활성화 (--off 비활성화)"
        },
        {
          "flag": "-C",
          "desc": "(-l 과 함께) 로컬에서 추가·변경한 항목만 표시"
        }
      ],
      "examples": [
        {
          "title": "웹 서버를 8080 포트로 띄울 때",
          "command": "semanage port -l | grep http_port_t\nsemanage port -a -t http_port_t -p tcp 8080"
        },
        {
          "title": "웹 루트를 /web 으로 옮길 때 컨텍스트 지정",
          "command": "semanage fcontext -a -t httpd_sys_content_t '/web(/.*)?'\nrestorecon -Rv /web"
        },
        {
          "title": "httpd 가 외부 네트워크(DB 등)에 접속 허용",
          "command": "semanage boolean -m --on httpd_can_network_connect",
          "note": "setsebool -P httpd_can_network_connect on 과 같은 효과"
        },
        {
          "title": "로컬에서 바꾼 설정만 보기",
          "command": "semanage port -l -C\nsemanage fcontext -l -C"
        }
      ],
      "cautions": [
        "fcontext 규칙만 추가하고 restorecon 을 실행하지 않으면 기존 파일에는 적용되지 않습니다.",
        "이미 다른 타입에 정의된 포트는 -a 대신 -m 으로 수정해야 합니다."
      ],
      "install": {
        "rhel": {
          "package": "policycoreutils-python-utils",
          "preinstalled": false,
          "note": "minimal 설치에는 없음 → dnf install policycoreutils-python-utils"
        }
      },
      "help": "man semanage, man semanage-port, man semanage-fcontext",
      "keywords": [
        "SELinux 포트",
        "SELinux 컨텍스트",
        "boolean",
        "semanage",
        "fcontext",
        "http_port_t"
      ],
      "related": [
        "restorecon",
        "sestatus",
        "setenforce",
        "firewall-cmd"
      ]
    },
    {
      "id": "restorecon",
      "name": "restorecon",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.mac",
      "platforms": [
        "rhel"
      ],
      "level": "critical",
      "risk": "caution",
      "requiresAdmin": true,
      "summary": "파일 SELinux 컨텍스트를 정책 기본값으로 복원",
      "description": "파일·디렉토리의 SELinux 컨텍스트를 정책(및 semanage fcontext 규칙)에 정의된 기본값으로 되돌립니다. mv 로 옮긴 파일은 원래 컨텍스트를 유지하므로, 웹 루트 등에 파일을 옮긴 뒤 권한 거부가 나면 이 명령으로 해결합니다.",
      "syntax": [
        "restorecon [-R] [-v] {{PATH}}"
      ],
      "options": [
        {
          "flag": "-R",
          "desc": "하위 디렉토리까지 재귀 적용"
        },
        {
          "flag": "-v",
          "desc": "변경된 파일 표시"
        },
        {
          "flag": "-n",
          "desc": "실제로 바꾸지 않음 (-v 와 함께 미리 보기)"
        },
        {
          "flag": "-F",
          "desc": "사용자·역할 부분까지 강제로 재설정"
        },
        {
          "flag": "-i",
          "desc": "존재하지 않는 파일은 무시"
        }
      ],
      "examples": [
        {
          "title": "옮긴 파일 컨텍스트 복원",
          "command": "ls -Z {{PATH}}\nrestorecon -Rv {{PATH}}"
        },
        {
          "title": "바뀔 내용 미리 보기",
          "command": "restorecon -Rnv /var/www/html"
        },
        {
          "title": "다음 부팅 때 전체 파일시스템 relabel",
          "command": "touch /.autorelabel\nreboot",
          "note": "Disabled → Enforcing 전환 시 등. 부팅이 오래 걸림"
        }
      ],
      "cautions": [
        "chcon 으로 직접 바꾼 컨텍스트는 restorecon 실행 시 정책 기본값으로 덮어써집니다. 영구 적용은 semanage fcontext 로 하세요."
      ],
      "install": {
        "rhel": {
          "package": "policycoreutils",
          "preinstalled": true
        }
      },
      "help": "man restorecon",
      "keywords": [
        "SELinux 컨텍스트 복원",
        "권한 거부",
        "restorecon",
        "ls -Z",
        "relabel",
        "SELinux"
      ],
      "related": [
        "semanage",
        "getenforce",
        "ls",
        "mv"
      ]
    },
