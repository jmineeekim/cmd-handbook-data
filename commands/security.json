    {
      "id": "openssl",
      "name": "openssl",
      "kind": "command",
      "shell": "sh",
      "category": "security",
      "task": "security.certificate",
      "platforms": [
        "rhel",
        "debian"
      ],
      "level": "critical",
      "risk": "safe",
      "requiresAdmin": false,
      "summary": "인증서 내용·만료일 확인, CSR 생성, 형식 변환",
      "description": "인증서 파일이나 원격 서버의 인증서를 조회하고, 만료일·체인을 확인하며, 개인키·CSR 생성과 PEM·PFX 형식 변환을 합니다. 하위 명령(x509, s_client, req, pkcs12 등)으로 기능을 나눠 사용합니다.",
      "syntax": [
        "openssl x509 -in {{FILE}} -noout -text",
        "openssl s_client -connect {{HOST}}:{{PORT}} -servername {{HOST}}"
      ],
      "options": [
        {
          "flag": "x509 -noout -text",
          "desc": "인증서 전체 내용 (주체, 발급자, SAN, 유효기간)"
        },
        {
          "flag": "x509 -noout -enddate / -dates",
          "desc": "만료일 / 시작·만료일만"
        },
        {
          "flag": "x509 -noout -subject -issuer",
          "desc": "주체·발급자만"
        },
        {
          "flag": "x509 -checkend {{SECONDS}}",
          "desc": "지정 초 안에 만료되면 종료 코드 1 (모니터링용)"
        },
        {
          "flag": "s_client -connect {{HOST}}:{{PORT}}",
          "desc": "원격 서버에 TLS 접속해 인증서·체인 확인"
        },
        {
          "flag": "s_client -servername {{HOST}}",
          "desc": "SNI 지정 (한 IP 에 여러 인증서가 있을 때 필수)"
        },
        {
          "flag": "s_client -showcerts",
          "desc": "서버가 보내는 체인 전체 출력"
        },
        {
          "flag": "req -new -newkey rsa:2048 -nodes",
          "desc": "새 개인키와 CSR 생성"
        },
        {
          "flag": "pkcs12",
          "desc": "PFX(P12) ↔ PEM 변환"
        },
        {
          "flag": "verify -CAfile {{FILE}}",
          "desc": "인증서가 CA 로 검증되는지 확인"
        }
      ],
      "examples": [
        {
          "title": "원격 서버 인증서 만료일 확인",
          "command": "echo | openssl s_client -connect {{HOST}}:443 -servername {{HOST}} 2>/dev/null | openssl x509 -noout -subject -issuer -dates",
          "output": "subject=CN = www.example.com\nissuer=C = US, O = Let's Encrypt, CN = R11\nnotBefore=Sep  1 00:00:00 2026 GMT\nnotAfter=Nov 30 23:59:59 2026 GMT"
        },
        {
          "title": "인증서 파일 만료일·30일 내 만료 여부",
          "command": "openssl x509 -in {{FILE}} -noout -enddate\nopenssl x509 -in {{FILE}} -noout -checkend 2592000 && echo OK || echo '30일 내 만료'"
        },
        {
          "title": "개인키 + CSR 생성 (SAN 포함)",
          "command": "openssl req -new -newkey rsa:2048 -nodes -keyout {{DOMAIN}}.key -out {{DOMAIN}}.csr -subj \"/CN={{DOMAIN}}\" -addext \"subjectAltName=DNS:{{DOMAIN}}\"",
          "note": "-addext 는 OpenSSL 1.1.1 이상"
        },
        {
          "title": "PFX → PEM 변환 (인증서·키 분리)",
          "command": "openssl pkcs12 -in {{FILE}}.pfx -clcerts -nokeys -out cert.pem\nopenssl pkcs12 -in {{FILE}}.pfx -nocerts -nodes -out key.pem"
        },
        {
          "title": "인증서와 개인키 짝 확인",
          "command": "openssl x509 -noout -pubkey -in cert.pem | openssl sha256\nopenssl pkey -pubout -in key.pem | openssl sha256",
          "note": "두 해시가 같으면 짝이 맞음"
        }
      ],
      "cautions": [
        "-nodes 로 만든 개인키는 암호화되지 않으므로 권한을 600 으로 제한하세요.",
        "s_client 에서 -servername 을 빼면 기본 인증서가 보여 실제와 다른 결과가 나올 수 있습니다."
      ],
      "platformNotes": {
        "rhel": "RHEL 9 는 OpenSSL 3.0 기반이며 SHA-1 서명 등 구형 알고리즘이 기본 정책에서 거부될 수 있습니다 (update-crypto-policies 참고)."
      },
      "help": "man openssl, man openssl-x509, man openssl-s_client",
      "keywords": [
        "인증서 확인",
        "만료일",
        "SSL",
        "TLS",
        "CSR 생성",
        "openssl",
        "x509",
        "s_client",
        "pfx 변환"
      ],
      "related": [
        "update-ca-trust",
        "update-ca-certificates",
        "curl",
        "sha256sum"
      ]
    },
